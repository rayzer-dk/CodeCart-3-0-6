{{ header }}{{ column_left }}
<div id="content" class="sc-page">
  <div class="page-header"><div class="container-fluid">
    <div class="pull-right"><a href="{{ cancel }}" class="btn btn-default" title="{{ button_cancel }}"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg> {{ button_cancel }}</a></div>
    <h1>{{ heading_title }}</h1>
    <ul class="breadcrumb">{% for breadcrumb in breadcrumbs %}<li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>{% endfor %}</ul>
  </div></div>
  <div class="container-fluid">
    {% if error_warning %}<div class="alert alert-danger"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}</div>{% endif %}
    {% if success %}<div class="alert alert-success"><i class="fa fa-check-circle"></i> {{ success }}</div>{% endif %}
    <div class="alert alert-info">{{ text_intro }}</div>
    <div class="panel panel-default">
      <div class="panel-heading"><h3 class="panel-title"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m21 21-4.3-4.3"/><circle cx="11" cy="11" r="8"/></svg> {{ text_scan }}</h3></div>
      <div class="panel-body">
        <form class="sc-filters" method="get" action="index.php">
          <input type="hidden" name="route" value="extension/module/settings_cleaner" />
          <input type="hidden" name="user_token" value="{{ user_token|e('html_attr') }}" />
          <input type="hidden" name="scan" value="1" />
          <div class="form-group"><label for="sc-status">{{ text_status }}</label><select id="sc-status" name="status" class="form-control">
            <option value="candidate"{% if filter_status == 'candidate' %} selected{% endif %}>{{ text_candidate }}</option>
            <option value="review"{% if filter_status == 'review' %} selected{% endif %}>{{ text_review }}</option>
            <option value="protected"{% if filter_status == 'protected' %} selected{% endif %}>{{ text_protected }}</option>
            <option value="unknown"{% if filter_status == 'unknown' %} selected{% endif %}>{{ text_unknown }}</option>
            <option value="all"{% if filter_status == 'all' %} selected{% endif %}>{{ text_all }}</option>
          </select></div>
          <div class="form-group sc-search"><label for="sc-search">{{ text_search }}</label><input id="sc-search" name="search" type="search" maxlength="100" class="form-control" value="{{ search|e('html_attr') }}" placeholder="{{ text_search }}" /></div>
          <div class="form-group sc-filter-action"><button type="submit" class="btn btn-primary"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m21 21-4.3-4.3"/><circle cx="11" cy="11" r="8"/></svg> {{ text_scan }}</button></div>
        </form>
        {% if scanned %}
          <div class="sc-stats">
            <span class="label label-warning">{{ text_candidate }}: {{ counts.candidate }}</span>
            <span class="label label-info">{{ text_review }}: {{ counts.review }}</span>
            <span class="label label-success">{{ text_protected }}: {{ counts.protected }}</span>
            <span class="label label-default">{{ text_unknown }}: {{ counts.unknown }}</span>
          </div>
          {% if truncated %}<div class="alert alert-warning">{{ text_limit }}</div>{% endif %}
          {% if incomplete %}<div class="alert alert-warning">{{ text_incomplete }}</div>{% endif %}
          <form method="post" action="{{ action }}" id="sc-delete-form" onsubmit="return confirm({{ text_confirm_delete|json_encode|raw }});">
            <input type="hidden" name="action" value="delete" />
            <div class="table-responsive"><table class="table table-bordered table-hover sc-table">
              <thead><tr>
                <th class="sc-check"><input type="checkbox" id="sc-select-all" aria-label="{{ text_select_all|e('html_attr') }}" /></th>
                <th><a href="{{ sort_urls.setting_id }}">{{ column_id }}</a></th>
                <th><a href="{{ sort_urls.store_id }}">{{ column_store }}</a></th>
                <th><a href="{{ sort_urls.code }}">{{ column_code }}</a></th>
                <th><a href="{{ sort_urls.key }}">{{ column_key }}</a></th>
                <th><a href="{{ sort_urls.status }}">{{ column_status }}</a></th>
                <th>{{ column_reason }}</th>
              </tr></thead>
              <tbody>
                {% for row in rows %}<tr>
                  <td class="sc-check">{% if row.status == 'candidate' and not incomplete %}<input class="sc-selected" type="checkbox" name="selected[]" value="{{ row.setting_id }}" aria-label="{{ row.key|e('html_attr') }}" />{% endif %}</td>
                  <td>{{ row.setting_id }}</td><td>{{ row.store_id }}</td><td><code>{{ row.code|e }}</code></td><td><code>{{ row.key|e }}</code></td>
                  <td><span class="label {% if row.status == 'candidate' %}label-warning{% elseif row.status == 'review' %}label-info{% elseif row.status == 'protected' %}label-success{% else %}label-default{% endif %}">{{ row.status_label }}</span></td>
                  <td>{{ row.reason_label }}</td>
                </tr>{% else %}<tr><td colspan="7" class="text-center text-muted">{{ text_no_results }}</td></tr>{% endfor %}
              </tbody>
            </table></div>
            {% if pagination %}<div class="text-center">{{ pagination }}</div>{% endif %}
            <div class="sc-operations">
              <label for="sc-confirm">{{ text_confirm }}</label>
              <input id="sc-confirm" class="form-control" type="text" name="confirm" autocomplete="off" placeholder="DELETE" maxlength="6" />
              <button type="submit" class="btn btn-danger"{% if counts.candidate == 0 or incomplete or truncated %} disabled{% endif %}><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 6h18"/><path d="M8 6V4h8v2"/><path d="m6 6 1 14h10l1-14"/><path d="M10 10v6M14 10v6"/></svg> {{ text_delete }}</button>
            </div>
          </form>
        {% endif %}
      </div>
    </div>
    <div class="panel panel-default">
      <div class="panel-heading"><h3 class="panel-title"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 4h18v16H3zM3 9h18"/><path d="M8 14h8"/></svg> {{ text_backup }}</h3></div>
      <div class="panel-body table-responsive">
        <table class="table table-bordered table-hover sc-table"><thead><tr><th>{{ text_backup_id }}</th><th>{{ text_date }}</th><th>{{ text_user }}</th><th>{{ text_rows }}</th><th>{{ text_restored_rows }}</th><th></th></tr></thead>
        <tbody>{% for backup in backups %}<tr>
          <td>{{ backup.backup_id }}</td><td>{{ backup.date_added }}</td><td>{{ backup.user_id }}</td><td>{{ backup.row_count }}</td><td>{{ backup.restored_count }}</td>
          <td class="text-right">{% if backup.restored_count < backup.row_count %}<form action="{{ action }}" method="post" onsubmit="return confirm({{ text_restore_confirm|json_encode|raw }});"><input type="hidden" name="action" value="restore" /><input type="hidden" name="backup_id" value="{{ backup.backup_id }}" /><button type="submit" class="btn btn-default btn-sm"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12a9 9 0 1 1 3 6.7"/><path d="M3 16v4h4M3 20l5-5"/></svg> {{ text_restore }}</button></form>{% endif %}</td>
        </tr>{% else %}<tr><td colspan="6" class="text-center text-muted">{{ text_no_results }}</td></tr>{% endfor %}</tbody></table>
      </div>
    </div>
  </div>
</div>
<style>
.sc-page .panel-title svg,.sc-page .btn svg{vertical-align:-3px;margin-right:4px}
.sc-page .sc-filters{display:flex;gap:12px;align-items:flex-end;flex-wrap:wrap}
.sc-page .sc-filters .form-group{margin:0;min-width:160px}
.sc-page .sc-filters .sc-search{flex:1;min-width:220px}
.sc-page .sc-stats{display:flex;flex-wrap:wrap;gap:9px;margin:18px 0}
.sc-page .sc-stats .label{padding:6px 9px;font-size:12px;font-weight:500}
.sc-page .sc-table{margin-top:12px}
.sc-page .sc-table .sc-check{width:34px;text-align:center}
.sc-page .sc-table code{white-space:normal;overflow-wrap:anywhere;background:transparent;color:inherit}
.sc-page .sc-operations{display:flex;align-items:center;flex-wrap:wrap;gap:10px;padding:10px 0}
.sc-page .sc-operations input{width:140px}
.sc-page .sc-table td,.sc-page .sc-table th{vertical-align:middle}
@media(max-width:767px){.sc-page .sc-filters .form-group,.sc-page .sc-filters .sc-search{width:100%;min-width:0}.sc-page .sc-operations input{width:100%}}
</style>
<script>
(function(){var toggle=document.getElementById('sc-select-all');if(!toggle){return;}toggle.addEventListener('change',function(){var boxes=document.querySelectorAll('#sc-delete-form .sc-selected');for(var i=0;i<boxes.length;i++){boxes[i].checked=toggle.checked;}});})();
</script>
{{ footer }}
