{{ header }}{{ column_left }}
<div id="content"><div class="page-header"><div class="container-fluid">
<div class="pull-right"><button type="submit" form="form-monobank" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa fa-save"></i></button> <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default"><i class="fa fa-reply"></i></a></div>
<h1>{{ heading_title }}</h1><ul class="breadcrumb">{% for breadcrumb in breadcrumbs %}<li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>{% endfor %}</ul></div></div>
<div class="container-fluid">{% if error_warning %}<div class="alert alert-danger"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}</div>{% endif %}
<div class="panel panel-default"><div class="panel-heading" style="border-top:3px solid #0057d9"><h3 class="panel-title"><i class="fa fa-credit-card"></i> {{ text_edit }}</h3></div><div class="panel-body">
<form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-monobank" class="form-horizontal">
<div class="form-group"><label class="col-sm-2 control-label" for="input-token">{{ entry_token }}</label><div class="col-sm-10"><input type="password" name="payment_monobank_modern_token" value="{{ payment_monobank_modern_token }}" id="input-token" class="form-control" autocomplete="new-password"><p class="help-block">{{ help_token }}</p><button type="button" id="button-test" class="btn btn-default"><i class="fa fa-plug"></i> {{ button_test }}</button> <span id="test-result"></span></div></div>
<div class="form-group"><label class="col-sm-2 control-label">Webhook</label><div class="col-sm-10"><input type="text" value="{{ webhook_url }}" class="form-control" readonly><p class="help-block">{{ help_webhook }}</p></div></div>
<div class="form-group"><label class="col-sm-2 control-label" for="input-total">{{ entry_total }}</label><div class="col-sm-10"><input type="text" name="payment_monobank_modern_total" value="{{ payment_monobank_modern_total }}" id="input-total" class="form-control"></div></div>
<div class="form-group"><label class="col-sm-2 control-label" for="input-geo">{{ entry_geo_zone }}</label><div class="col-sm-10"><select name="payment_monobank_modern_geo_zone_id" id="input-geo" class="form-control"><option value="0">---</option>{% for geo_zone in geo_zones %}<option value="{{ geo_zone.geo_zone_id }}"{% if geo_zone.geo_zone_id == payment_monobank_modern_geo_zone_id %} selected{% endif %}>{{ geo_zone.name }}</option>{% endfor %}</select></div></div>
{% set maps = {'success':entry_success_status,'processing':entry_processing_status,'failure':entry_failure_status} %}{% for key,label in maps %}<div class="form-group"><label class="col-sm-2 control-label">{{ label }}</label><div class="col-sm-10"><select name="payment_monobank_modern_{{ key }}_status_id" class="form-control"><option value="0">---</option>{% for order_status in order_statuses %}<option value="{{ order_status.order_status_id }}"{% if order_status.order_status_id == attribute(_context,'payment_monobank_modern_' ~ key ~ '_status_id') %} selected{% endif %}>{{ order_status.name }}</option>{% endfor %}</select></div></div>{% endfor %}
<div class="form-group"><label class="col-sm-2 control-label">{{ entry_status }}</label><div class="col-sm-10"><select name="payment_monobank_modern_status" class="form-control"><option value="1"{% if payment_monobank_modern_status %} selected{% endif %}>{{ text_enabled }}</option><option value="0"{% if not payment_monobank_modern_status %} selected{% endif %}>{{ text_disabled }}</option></select></div></div>
<div class="form-group"><label class="col-sm-2 control-label">{{ entry_debug }}</label><div class="col-sm-10"><select name="payment_monobank_modern_debug" class="form-control"><option value="1"{% if payment_monobank_modern_debug %} selected{% endif %}>{{ text_enabled }}</option><option value="0"{% if not payment_monobank_modern_debug %} selected{% endif %}>{{ text_disabled }}</option></select></div></div>
<div class="form-group"><label class="col-sm-2 control-label">{{ entry_sort_order }}</label><div class="col-sm-10"><input type="text" name="payment_monobank_modern_sort_order" value="{{ payment_monobank_modern_sort_order }}" class="form-control"></div></div>
</form></div></div></div></div>
<script>$('#button-test').on('click',function(){var b=$(this),r=$('#test-result');b.prop('disabled',true);r.text('...');$.ajax({url:'{{ test_url|replace({'&amp;':'&'}) }}',type:'post',dataType:'json',data:{token:$('#input-token').val()}}).done(function(j){r.text(j.success ? 'OK: '+j.merchant : (j.error||'Error'));}).fail(function(){r.text('Request error');}).always(function(){b.prop('disabled',false);});});</script>
{{ footer }}
