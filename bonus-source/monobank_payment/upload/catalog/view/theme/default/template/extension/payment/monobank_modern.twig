<div class="buttons"><div class="pull-right"><button type="button" id="button-confirm-monobank" class="btn btn-primary">{{ button_confirm }}</button></div></div><script>$('#button-confirm-monobank').on('click',function(){var b=$(this);b.prop('disabled',true);$.ajax({url:'{{ confirm_url|replace({'&amp;':'&'}) }}',type:'post',dataType:'json'}).done(function(j){if(j.redirect){location=j.redirect;}else{alert(j.error||'Payment error');b.prop('disabled',false);}}).fail(function(){alert('Payment request failed');b.prop('disabled',false);});});</script>