{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header"><div class="container-fluid"><div class="pull-right"><button type="button" id="button-read-all" class="btn btn-primary" data-toggle="tooltip" title="{{ text_read_all }}"><i class="fa fa-check-square-o"></i></button></div><h1>{{ heading_title }}</h1><ul class="breadcrumb">{% for breadcrumb in breadcrumbs %}<li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>{% endfor %}</ul></div></div>
  <div class="container-fluid"><div class="panel panel-default"><div class="panel-heading"><h3 class="panel-title"><i class="fa fa-bell"></i> {{ text_list }}</h3></div><div class="panel-body">
    {% if notifications %}<div class="ccp-notification-page-toolbar"><button type="button" id="button-clear-read" class="btn btn-default" data-toggle="tooltip" title="{{ text_clear_read }}"><i class="fa fa-trash-o"></i> {{ text_clear_read }}</button></div>{% endif %}
    <div class="ccp-notification-page">{% if notifications %}{% for item in notifications %}<div class="ccp-notification-card ccp-notification-{{ item.severity }} {% if item.status == 'unread' %}is-unread{% endif %}"><div class="ccp-notification-card-icon"><i class="fa {% if item.severity == 'critical' or item.severity == 'error' %}fa-exclamation-circle{% elseif item.severity == 'warning' %}fa-exclamation-triangle{% else %}fa-info-circle{% endif %}"></i></div><div class="ccp-notification-card-body"><div class="ccp-notification-card-head"><strong>{{ item.title }}</strong><span class="label {% if item.severity == 'critical' or item.severity == 'error' %}label-danger{% elseif item.severity == 'warning' %}label-warning{% else %}label-info{% endif %}">{% if item.severity == 'critical' %}{{ text_level_critical }}{% elseif item.severity == 'error' %}{{ text_level_error }}{% elseif item.severity == 'warning' %}{{ text_level_warning }}{% else %}{{ text_level_info }}{% endif %}</span></div><div class="text-muted">{{ item.message }}</div><div class="ccp-notification-meta"><span><i class="fa fa-clock-o"></i> {{ item.date_modified }}</span>{% if item.route %}<a href="index.php?route={{ item.route }}&user_token={{ user_token }}"><i class="fa fa-external-link"></i> {{ item.route }}</a>{% endif %}</div></div><div class="ccp-notification-card-actions">{% if item.status == 'unread' %}<button type="button" class="btn btn-primary btn-read" data-id="{{ item.notification_id }}" data-toggle="tooltip" title="{{ text_read }}"><i class="fa fa-check"></i></button>{% endif %}<button type="button" class="btn btn-danger btn-delete" data-id="{{ item.notification_id }}" data-toggle="tooltip" title="{{ text_delete }}"><i class="fa fa-trash-o"></i></button></div></div>{% endfor %}{% else %}<div class="text-center text-muted" style="padding:30px 10px;"><i class="fa fa-check-circle fa-2x"></i><br>{{ text_empty }}</div>{% endif %}</div>
  </div></div></div>
</div>
<script>
$('.btn-read').on('click',function(){var b=$(this);$.post('index.php?route=tool/notification/read&user_token={{ user_token }}',{notification_id:b.data('id')},function(j){if(j.success)location.reload();},'json');});
$('.btn-delete').on('click',function(){var b=$(this);if(!confirm('{{ text_confirm_delete|escape('js') }}'))return;$.post('index.php?route=tool/notification/delete&user_token={{ user_token }}',{notification_id:b.data('id')},function(j){if(j.success)location.reload();},'json');});
$('#button-read-all').on('click',function(){$.post('index.php?route=tool/notification/readAll&user_token={{ user_token }}',{},function(j){if(j.success)location.reload();},'json');});
$('#button-clear-read').on('click',function(){if(!confirm('{{ text_confirm_clear|escape('js') }}'))return;$.post('index.php?route=tool/notification/clearRead&user_token={{ user_token }}',{},function(j){if(j.success)location.reload();},'json');});
</script>{{ footer }}
