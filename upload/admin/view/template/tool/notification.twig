{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header"><div class="container-fluid">
    <div class="pull-right">{% if can_modify %}<button type="button" id="button-read-all" class="btn btn-primary" data-toggle="tooltip" title="{{ text_read_all }}"><i class="fa fa-check-square-o"></i></button>{% endif %}</div>
    <h1>{{ heading_title }}</h1>
    <ul class="breadcrumb">{% for breadcrumb in breadcrumbs %}<li><a href="{{ breadcrumb.href|e('html_attr') }}">{{ breadcrumb.text|e('html') }}</a></li>{% endfor %}</ul>
  </div></div>
  <div class="container-fluid"><div class="panel panel-default">
    <div class="panel-heading"><h3 class="panel-title"><i class="fa fa-bell"></i> {{ text_list }}</h3></div>
    <div class="panel-body">
      {% if not can_modify %}<div class="alert alert-warning"><i class="fa fa-exclamation-triangle"></i> {{ error_permission }}</div>{% endif %}
      <div class="ccp-notification-page-toolbar">
        <div class="ccp-notification-statuses btn-group" role="group" aria-label="{{ text_list }}">
          <a class="btn btn-default{% if selected_status == 'all' %} active{% endif %}" href="{{ notification_list_url|e('html_attr') }}&amp;status=all">{{ text_status_all }} ({{ counts.all }})</a>
          <a class="btn btn-default{% if selected_status == 'unread' %} active{% endif %}" href="{{ notification_list_url|e('html_attr') }}&amp;status=unread">{{ text_status_unread }} ({{ counts.unread }})</a>
          <a class="btn btn-default{% if selected_status == 'read' %} active{% endif %}" href="{{ notification_list_url|e('html_attr') }}&amp;status=read">{{ text_status_read }} ({{ counts.read }})</a>
          <a class="btn btn-default{% if selected_status == 'resolved' %} active{% endif %}" href="{{ notification_list_url|e('html_attr') }}&amp;status=resolved">{{ text_status_resolved }} ({{ counts.resolved }})</a>
          <a class="btn btn-default{% if selected_status == 'dismissed' %} active{% endif %}" href="{{ notification_list_url|e('html_attr') }}&amp;status=dismissed">{{ text_status_dismissed }} ({{ counts.dismissed }})</a>
        </div>
        {% if can_modify and (counts.read or counts.resolved) %}<button type="button" id="button-clear-read" class="btn btn-default" title="{{ text_clear_read }}"><i class="fa fa-trash-o"></i> {{ text_clear_read }}</button>{% endif %}
      </div>
      {% if selected_status == 'dismissed' %}<p class="help-block">{{ text_archive_help }}</p>{% endif %}
      <div class="ccp-notification-page">
        {% if notifications %}
          {% for item in notifications %}
          <div class="ccp-notification-card ccp-notification-{{ item.severity|e('html_attr') }}{% if item.status == 'unread' %} is-unread{% endif %}">
            <div class="ccp-notification-card-icon"><i class="fa {% if item.severity == 'critical' or item.severity == 'error' %}fa-exclamation-circle{% elseif item.severity == 'warning' %}fa-exclamation-triangle{% else %}fa-info-circle{% endif %}"></i></div>
            <div class="ccp-notification-card-body">
              <div class="ccp-notification-card-head"><strong>{{ item.title|e('html') }}</strong><span class="label {% if item.severity == 'critical' or item.severity == 'error' %}label-danger{% elseif item.severity == 'warning' %}label-warning{% else %}label-info{% endif %}">{% if item.severity == 'critical' %}{{ text_level_critical }}{% elseif item.severity == 'error' %}{{ text_level_error }}{% elseif item.severity == 'warning' %}{{ text_level_warning }}{% else %}{{ text_level_info }}{% endif %}</span></div>
              <div class="text-muted">{{ item.message|e('html') }}</div>
              <div class="ccp-notification-meta"><span><i class="fa fa-clock-o"></i> {{ item.date_modified|e('html') }}</span>{% if item.route %}<a href="index.php?route={{ item.route|url_encode }}&amp;user_token={{ user_token|url_encode }}"><i class="fa fa-external-link"></i> {{ item.route|e('html') }}</a>{% endif %}<span>{% if item.status == 'unread' %}{{ text_status_unread }}{% elseif item.status == 'read' %}{{ text_status_read }}{% elseif item.status == 'resolved' %}{{ text_status_resolved }}{% else %}{{ text_status_dismissed }}{% endif %}</span></div>
            </div>
            {% if can_modify and item.status != 'dismissed' %}<div class="ccp-notification-card-actions">
              {% if item.status == 'unread' %}<button type="button" class="btn btn-primary btn-read" data-id="{{ item.notification_id }}" title="{{ text_read }}"><i class="fa fa-check"></i></button>{% endif %}
              <button type="button" class="btn btn-danger btn-delete" data-id="{{ item.notification_id }}" title="{{ text_delete }}"><i class="fa fa-trash-o"></i></button>
            </div>{% endif %}
          </div>
          {% endfor %}
        {% else %}<div class="text-center text-muted" style="padding:30px 10px;"><i class="fa fa-check-circle fa-2x"></i><p>{{ text_empty }}</p></div>{% endif %}
      </div>
      {% if pages > 1 %}<div class="ccp-notification-pagination">
        <span>{{ text_page }} {{ page }} / {{ pages }}</span>
        <div class="btn-group">
          {% if page > 1 %}<a class="btn btn-default" href="{{ notification_list_url|e('html_attr') }}&amp;status={{ selected_status|e('html_attr') }}&amp;page={{ page - 1 }}" title="{{ text_previous }}"><i class="fa fa-angle-left"></i></a>{% endif %}
          {% if page < pages %}<a class="btn btn-default" href="{{ notification_list_url|e('html_attr') }}&amp;status={{ selected_status|e('html_attr') }}&amp;page={{ page + 1 }}" title="{{ text_next }}"><i class="fa fa-angle-right"></i></a>{% endif %}
        </div>
      </div>{% endif %}
    </div>
  </div></div>
</div>
<script>
(function($){
  function request(action, data, button) {
    if (button) { button.prop('disabled', true); }
    $.ajax({
      url: action, type: 'POST', dataType: 'json', data: data || {},
      success: function(result) {
        if (result && result.success === true) { window.location.reload(); return; }
        alert((result && result.error) || '{{ error_action|escape('js') }}');
      },
      error: function(xhr) {
        var message = '{{ error_network|escape('js') }}';
        if (xhr.responseJSON && xhr.responseJSON.error) { message = xhr.responseJSON.error; }
        else if (xhr.status === 401 || (xhr.responseText && /(?:id=[\"']input-username[\"']|route=common\/login|name=[\"']username[\"'])/i.test(xhr.responseText))) { message = '{{ error_session|escape('js') }}'; }
        alert(message);
      },
      complete: function(){ if (button) { button.prop('disabled', false); } }
    });
  }
  $('.btn-read').on('click', function(){var b=$(this);request('{{ notification_urls.read|escape('js') }}',{notification_id:b.data('id')},b);});
  $('.btn-delete').on('click', function(){var b=$(this);if (!confirm('{{ text_confirm_delete|escape('js') }}')) { return; }request('{{ notification_urls.delete|escape('js') }}',{notification_id:b.data('id')},b);});
  $('#button-read-all').on('click', function(){var b=$(this);request('{{ notification_urls.readAll|escape('js') }}',{},b);});
  $('#button-clear-read').on('click', function(){var b=$(this);if (!confirm('{{ text_confirm_clear|escape('js') }}')) { return; }request('{{ notification_urls.clearRead|escape('js') }}',{},b);});
})(jQuery);
</script>
{{ footer }}
