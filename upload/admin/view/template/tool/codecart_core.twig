                  <div class="col-md-4"><h4><i class="fa fa-line-chart"></i> {{ text_about_improved }}</h4><ul class="ccp-list">{% for item in about_improved_items %}<li>{{ item }}</li>{% endfor %}</ul></div>
                  <div class="col-md-4"><h4><i class="fa fa-shield"></i> {{ text_about_security }}</h4><ul class="ccp-list">{% for item in about_security_items %}<li>{{ item }}</li>{% endfor %}</ul></div>
                </div>
              </div></div>
