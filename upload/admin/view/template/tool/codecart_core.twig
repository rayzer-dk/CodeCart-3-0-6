            <div class="ccp-icon-filters" id="ccp-icon-filters">{% for code, label in icon_categories %}<button type="button" class="btn btn-default btn-sm{% if code == 'all' %} active{% endif %}" data-icon-category="{{ code }}">{{ label }}</button>{% endfor %}</div>
