              <button type="button" class="btn btn-default btn-sm" data-icon-style="solid">Solid</button>
              <button type="button" class="btn btn-default btn-sm" data-icon-style="regular">Regular</button>
              <button type="button" class="btn btn-default btn-sm" data-icon-style="brands">Brands</button>
            </div>
          </div>
          <div class="ccp-icon-copy-status" id="ccp-icon-copy-status" aria-live="polite"></div>
          <div class="ccp-icon-package" data-icon-package-panel="core">
            <div class="ccp-icon-grid" id="ccp-icon-grid-core">{% for icon in icon_catalog %}<button type="button" class="ccp-icon-item" data-icon="{{ icon.preview_class }}" data-search="{{ icon.preview_class }} {{ icon.class }} {{ icon.name }}" data-category="{{ icon.category }}" data-style="{{ icon.style }}" title="{{ icon.preview_class }}{% if icon.preview_name != icon.name %} · FA4: {{ icon.class }}{% endif %}"><i class="{{ icon.preview_class }} fa-2x"></i><span>{{ icon.preview_class }}</span><i class="fa fa-copy ccp-icon-copy" aria-hidden="true"></i></button>{% endfor %}</div>
          </div>
          <div class="ccp-icon-package" data-icon-package-panel="full" style="display:none">
