        <div class="tab-pane" id="tab-extensions"><p class="help-block">{{ text_extension_help }}</p><form action="{{ action }}" method="post"><input type="hidden" name="core_action" value="refresh_extensions"><input type="hidden" name="return_tab" value="extensions"><button type="submit" class="btn btn-primary"><i class="fa fa-refresh"></i> {{ button_refresh }}</button></form><br><div class="table-responsive"><table class="table table-bordered table-hover"><thead><tr><td>Code</td><td>Name</td><td>Version</td><td>Namespace</td></tr></thead><tbody>{% if modern_extensions %}{% for item in modern_extensions %}<tr><td>{{ item.code }}</td><td>{{ item.name }}</td><td>{{ item.version }}</td><td><code>{{ item.namespace }}</code></td></tr>{% endfor %}{% else %}<tr><td colspan="4" class="text-center">{{ text_no_extensions }}</td></tr>{% endif %}</tbody></table></div></div>
