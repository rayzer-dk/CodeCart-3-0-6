          <div class="panel-group" id="about-accordion" role="tablist">
            <div class="panel panel-default">
              <div class="panel-heading" role="tab"><h4 class="panel-title"><a data-toggle="collapse" data-parent="#about-accordion" href="#about-overview" aria-expanded="true"><i class="fa fa-check-circle"></i> {{ text_about_changes }} <span class="pull-right ccp-collapse-chevron"><i class="fa fa-chevron-up"></i></span></a></h4></div>
