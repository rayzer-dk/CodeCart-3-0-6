<script>
(function($){
  $(document).on('click','.ccp-schema-sort',function(e){
    e.preventDefault();
    var $a=$(this),col=parseInt($a.data('col'),10)||0,$table=$a.closest('table'),$body=$table.find('tbody'),rows=$body.find('tr').get();
    var dir=$a.data('dir')==='asc'?'desc':'asc';
    $table.find('.ccp-schema-sort').data('dir','').find('i').removeClass('fa-sort-asc fa-sort-desc').addClass('fa-sort');
    $a.data('dir',dir);$a.find('i').removeClass('fa-sort fa-sort-asc fa-sort-desc').addClass(dir==='asc'?'fa-sort-asc':'fa-sort-desc');
    rows.sort(function(x,y){var a=$.trim($(x).children().eq(col).text()).toLowerCase(),b=$.trim($(y).children().eq(col).text()).toLowerCase();return (a<b?-1:a>b?1:0)*(dir==='asc'?1:-1);});
    $.each(rows,function(_,row){$body.append(row);});
  });
})(jQuery);
</script>
<script>
(function($){
  var texts={running:'{{ text_db_modernize_running|e('js') }}',done:'{{ text_db_modernize_done|e('js') }}'};
  $(document).on('click','#ccp-db-modernize-run',function(){
    var $btn=$(this),$status=$('#ccp-db-modernize .ccp-db-modernize-status'),url=$btn.data('url'),converted=0,failed=[];
    if(!$('#ccp-db-backup-confirm').is(':checked')){$('#ccp-db-backup-confirm').closest('label').addClass('text-danger');return;}
    $btn.prop('disabled',true);
    var step=function(){
      $.ajax({url:url,type:'post',dataType:'json',data:{backup_confirm:1}}).done(function(json){
        if(json.error){$status.html($('<span class="text-danger">').text(json.error));$btn.prop('disabled',false);return;}
        $.each(json.changed||[],function(_,t){converted++;$('#ccp-db-modernize tr[data-table="'+t+'"]').addClass('success');});
        $.each(json.errors||[],function(_,e){failed.push(e.table+': '+e.error);});
        $status.text(texts.running.replace('%s',converted).replace('%s',json.remaining));
        if(json.done||json.remaining===0){$status.text(texts.done.replace('%s',converted).replace('%s',json.remaining));if(failed.length){$status.append($('<pre class="text-danger">').text(failed.join('\n')));}$btn.prop('disabled',false);}else{step();}
      }).fail(function(xhr){$status.html($('<span class="text-danger">').text(xhr.status+' '+xhr.statusText));$btn.prop('disabled',false);});
    };
    step();
  });
})(jQuery);
</script>
