{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header"><div class="container-fluid"><div class="pull-right"><button type="submit" form="form-core" class="btn btn-primary" data-toggle="tooltip" title="{{ button_save }}"><i class="fa fa-save"></i></button></div><h1>{{ heading_title }}</h1><ul class="breadcrumb">{% for breadcrumb in breadcrumbs %}<li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>{% endfor %}</ul></div></div>
  <div class="container-fluid">
    {% if error_warning %}<div class="alert alert-danger"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}</div>{% endif %}
    {% if success %}<div class="alert alert-success"><i class="fa fa-check-circle"></i> {{ success }}</div>{% endif %}
    <div class="panel panel-default"><div class="panel-heading"><h3 class="panel-title"><i class="fa fa-cog"></i> {{ heading_title }}</h3></div><div class="panel-body">
      <ul class="nav nav-tabs" id="core-tabs">
        <li><a href="#tab-runtime" data-toggle="tab"><i class="fa fa-heartbeat"></i> {{ text_runtime }}</a></li>
        <li><a href="#tab-performance" data-toggle="tab"><i class="fa fa-tachometer"></i> {{ text_performance }}</a></li>
        <li><a href="#tab-architecture" data-toggle="tab"><i class="fa fa-cubes"></i> {{ text_architecture }}</a></li>
        <li><a href="#tab-security" data-toggle="tab"><i class="fa fa-shield"></i> {{ text_security }}</a></li>
        <li><a href="#tab-privacy" data-toggle="tab"><i class="fa fa-user-secret"></i> {{ text_privacy }}</a></li>
        <li><a href="#tab-schema" data-toggle="tab"><i class="fa fa-database"></i> {{ text_schema }}</a></li>
        <li><a href="#tab-extensions" data-toggle="tab"><i class="fa fa-puzzle-piece"></i> {{ text_extensions }}</a></li>
        <li><a href="#tab-icons" data-toggle="tab"><i class="fa fa-font"></i> {{ text_icons }}</a></li>
        <li><a href="#tab-about" data-toggle="tab"><i class="fa fa-info-circle"></i> {{ text_about }}</a></li>
      </ul>
      <div class="tab-content">
        <div class="tab-pane" id="tab-runtime"><p class="help-block">{{ text_runtime_help }}</p><p class="help-block">{{ text_preflight_help }}</p><div class="table-responsive"><table class="table table-bordered table-hover"><thead><tr><td>{{ column_component }}</td><td>{{ column_value }}</td><td style="width:120px;">{{ column_state }}</td><td>{{ column_details }}</td></tr></thead><tbody>{% for row in runtime %}<tr><td>{{ row.component }}</td><td>{{ row.value }}</td><td>{% if row.state == 'ok' %}<span class="label label-success">{{ text_ok }}</span>{% elseif row.state == 'error' or row.state == 'missing' %}<span class="label label-danger">{{ text_error }}</span>{% elseif row.state == 'warning' %}<span class="label label-warning">{{ text_warning }}</span>{% else %}<span class="label label-default">{{ text_info }}</span>{% endif %}</td><td>{{ row.message }}</td></tr>{% endfor %}</tbody></table></div><p><a href="{{ notification_link }}" class="btn btn-default"><i class="fa fa-bell"></i> {{ text_system_notifications }}</a> <a href="{{ scheduler_link }}" class="btn btn-default"><i class="fa fa-clock-o"></i> {{ text_scheduler }}</a> <button type="button" class="btn btn-default" id="button-phpinfo" data-url="{{ phpinfo_link }}"><i class="fa fa-info-circle"></i> {{ button_phpinfo }}</button></p><div id="modal-phpinfo" class="modal fade" tabindex="-1" role="dialog" aria-hidden="true"></div></div>
        <div class="tab-pane" id="tab-performance">
          <p class="help-block">{{ text_performance_help }}</p>
          <div class="alert alert-info"><i class="fa fa-info-circle"></i> {{ text_safe_minify_note }}</div>
          <div class="well well-sm"><strong><i class="fa fa-bar-chart"></i> {{ text_minify_diagnostics }}:</strong> {{ text_minify_available }}: <span class="label label-success">{{ minify_stats.available }}</span> &nbsp; {{ text_minify_stale }}: <span class="label {% if minify_stats.stale %}label-warning{% else %}label-success{% endif %}">{{ minify_stats.stale }}</span> &nbsp; {{ text_minify_active }}: <span class="label label-info">{{ minify_stats.active }}</span></div>
          <form action="{{ action }}" method="post" class="form-horizontal"><input type="hidden" name="core_action" value="save_performance"><input type="hidden" name="return_tab" value="performance">
            <div class="form-group"><label class="col-sm-3 control-label"><span data-toggle="tooltip" title="{{ help_storefront_minify_css }}">{{ entry_storefront_minify_css }}</span></label><div class="col-sm-9"><label class="radio-inline"><input type="radio" name="codecart_storefront_minify_css_status" value="1" {% if codecart_storefront_minify_css_status %}checked{% endif %}> {{ text_enabled }}</label><label class="radio-inline"><input type="radio" name="codecart_storefront_minify_css_status" value="0" {% if not codecart_storefront_minify_css_status %}checked{% endif %}> {{ text_disabled }}</label><p class="help-block">{{ help_storefront_minify_css }}</p></div></div>
            <div class="form-group"><label class="col-sm-3 control-label"><span data-toggle="tooltip" title="{{ help_storefront_minify_js }}">{{ entry_storefront_minify_js }}</span></label><div class="col-sm-9"><label class="radio-inline"><input type="radio" name="codecart_storefront_minify_js_status" value="1" {% if codecart_storefront_minify_js_status %}checked{% endif %}> {{ text_enabled }}</label><label class="radio-inline"><input type="radio" name="codecart_storefront_minify_js_status" value="0" {% if not codecart_storefront_minify_js_status %}checked{% endif %}> {{ text_disabled }}</label><p class="help-block">{{ help_storefront_minify_js }}</p></div></div>
            <div class="form-group"><label class="col-sm-3 control-label"><span data-toggle="tooltip" title="{{ help_admin_minify_css }}">{{ entry_admin_minify_css }}</span></label><div class="col-sm-9"><label class="radio-inline"><input type="radio" name="codecart_admin_minify_css_status" value="1" {% if codecart_admin_minify_css_status %}checked{% endif %}> {{ text_enabled }}</label><label class="radio-inline"><input type="radio" name="codecart_admin_minify_css_status" value="0" {% if not codecart_admin_minify_css_status %}checked{% endif %}> {{ text_disabled }}</label><p class="help-block">{{ help_admin_minify_css }}</p></div></div>
            <div class="form-group"><label class="col-sm-3 control-label"><span data-toggle="tooltip" title="{{ help_admin_minify_js }}">{{ entry_admin_minify_js }}</span></label><div class="col-sm-9"><label class="radio-inline"><input type="radio" name="codecart_admin_minify_js_status" value="1" {% if codecart_admin_minify_js_status %}checked{% endif %}> {{ text_enabled }}</label><label class="radio-inline"><input type="radio" name="codecart_admin_minify_js_status" value="0" {% if not codecart_admin_minify_js_status %}checked{% endif %}> {{ text_disabled }}</label><p class="help-block">{{ help_admin_minify_js }}</p></div></div>
            <button type="submit" class="btn btn-primary"><i class="fa fa-save"></i> {{ button_save_performance }}</button>
          </form>
        </div>
        <div class="tab-pane" id="tab-architecture">
          <p class="help-block">{{ text_architecture_help }}</p>
          <div class="table-responsive"><table class="table table-bordered table-hover"><thead><tr><td>{{ column_component }}</td><td style="width:140px;">{{ column_state }}</td><td>{{ column_details }}</td></tr></thead><tbody>{% for row in architecture %}<tr><td>{{ row.name }}</td><td>{% if row.status == 'active' or row.status == 'enabled' %}<span class="label label-success">{{ text_enabled }}</span>{% else %}<span class="label label-default">{{ text_disabled }}</span>{% endif %}</td><td>{{ row.details }}</td></tr>{% endfor %}</tbody></table></div>
          <form action="{{ action }}" method="post" class="form-horizontal"><input type="hidden" name="core_action" value="save_architecture"><input type="hidden" name="return_tab" value="architecture">
            <div class="form-group"><label class="col-sm-3 control-label"><span data-toggle="tooltip" title="{{ text_api_v1_help }}">{{ entry_api_v1_status }}</span></label><div class="col-sm-9"><label class="radio-inline"><input type="radio" name="codecart_api_v1_status" value="1" {% if codecart_api_v1_status %}checked{% endif %}> {{ text_enabled }}</label><label class="radio-inline"><input type="radio" name="codecart_api_v1_status" value="0" {% if not codecart_api_v1_status %}checked{% endif %}> {{ text_disabled }}</label><p class="help-block">{{ text_api_v1_help }}</p></div></div>
            <button type="submit" class="btn btn-primary"><i class="fa fa-save"></i> {{ button_save_architecture }}</button>
          </form>
        </div>
        <div class="tab-pane" id="tab-security">
          <form id="form-core" action="{{ action }}" method="post" class="form-horizontal"><input type="hidden" name="core_action" value="save_security"><input type="hidden" name="return_tab" value="security">
            <fieldset><legend><i class="fa fa-lock"></i> {{ entry_login_protection }}</legend>
              <div class="form-group"><label class="col-sm-3 control-label"><span data-toggle="tooltip" title="{{ text_login_protection_help }}">{{ entry_login_protection }}</span></label><div class="col-sm-9"><label class="radio-inline"><input type="radio" name="codecart_admin_login_protection_status" value="1" {% if codecart_admin_login_protection_status %}checked{% endif %}> {{ text_enabled }}</label><label class="radio-inline"><input type="radio" name="codecart_admin_login_protection_status" value="0" {% if not codecart_admin_login_protection_status %}checked{% endif %}> {{ text_disabled }}</label><p class="help-block">{{ text_login_protection_help }}</p></div></div>
              <div class="form-group"><label class="col-sm-3 control-label"><span data-toggle="tooltip" title="{{ help_login_max_attempts }}">{{ entry_login_max_attempts }}</span></label><div class="col-sm-3"><input type="number" min="3" max="20" name="codecart_admin_login_max_attempts" value="{{ codecart_admin_login_max_attempts }}" class="form-control"></div></div>
              <div class="form-group"><label class="col-sm-3 control-label"><span data-toggle="tooltip" title="{{ help_login_window }}">{{ entry_login_window }}</span></label><div class="col-sm-3"><input type="number" min="5" max="240" name="codecart_admin_login_window_minutes" value="{{ codecart_admin_login_window_minutes }}" class="form-control"></div></div>
            </fieldset>
            <fieldset><legend><i class="fa fa-shield"></i> TOTP MFA</legend>
              <div class="form-group"><label class="col-sm-3 control-label"><span data-toggle="tooltip" title="{{ help_totp }}">{{ entry_totp }}</span></label><div class="col-sm-9"><p class="form-control-static">{% if totp_enabled %}<span class="label label-success">{{ text_totp_enabled }}</span> · {{ text_totp_recovery }}: {{ totp_recovery_count }}{% else %}<span class="label label-default">{{ text_totp_disabled }}</span>{% endif %}</p></div></div>
              {% if not totp_enabled and not totp_pending_secret %}<div class="form-group"><div class="col-sm-9 col-sm-offset-3"><button type="submit" name="requested_action" value="totp_prepare" class="btn btn-default"><i class="fa fa-key"></i> {{ button_totp_prepare }}</button></div></div>{% endif %}
              {% if totp_pending_secret %}<div class="alert alert-info alert-dismissible"><button type="button" class="close" data-dismiss="alert" aria-label="Close">&times;</button><div><strong>{{ text_totp_secret }}:</strong> <code>{{ totp_pending_secret }}</code></div><div class="ccp-totp-label"><strong>{{ text_totp_account }}:</strong> {{ totp_pending_label }}</div><div class="ccp-totp-uri-actions"><button type="button" class="btn btn-default btn-xs ccp-copy-value" data-copy-value="{{ totp_pending_uri|e }}" title="{{ button_copy }}"><i class="fa fa-copy"></i> {{ button_copy }} URI</button></div></div><div class="form-group"><label class="col-sm-3 control-label">{{ text_totp_code }}</label><div class="col-sm-4"><input type="text" name="totp_code" class="form-control" inputmode="numeric" autocomplete="one-time-code" maxlength="16"></div><div class="col-sm-5"><button type="submit" name="requested_action" value="totp_enable" class="btn btn-success"><i class="fa fa-check"></i> {{ button_totp_enable }}</button></div></div>{% endif %}
              {% if totp_enabled %}<div class="form-group"><label class="col-sm-3 control-label">{{ text_totp_code }}</label><div class="col-sm-4"><input type="text" name="totp_code" class="form-control" autocomplete="one-time-code" maxlength="16"></div><div class="col-sm-5"><button type="submit" name="requested_action" value="totp_disable" class="btn btn-danger"><i class="fa fa-times"></i> {{ button_totp_disable }}</button></div></div>{% endif %}
              {% if totp_recovery_codes %}<div class="alert alert-warning"><strong>{{ text_totp_recovery }}</strong><br><code>{{ totp_recovery_codes|join(' &nbsp; ') }}</code></div>{% endif %}
            </fieldset>
            <fieldset><legend><i class="fa fa-desktop"></i> {{ entry_admin_device }}</legend>
              <div class="form-group"><label class="col-sm-3 control-label"><span data-toggle="tooltip" title="{{ text_device_fail_open }}">{{ entry_admin_device }}</span></label><div class="col-sm-9"><label class="radio-inline"><input type="radio" name="codecart_admin_device_authorize_status" value="1" {% if codecart_admin_device_authorize_status %}checked{% endif %}> {{ text_enabled }}</label><label class="radio-inline"><input type="radio" name="codecart_admin_device_authorize_status" value="0" {% if not codecart_admin_device_authorize_status %}checked{% endif %}> {{ text_disabled }}</label><p class="help-block">{{ text_device_fail_open }}</p></div></div>
              <div class="form-group"><label class="col-sm-3 control-label"><span data-toggle="tooltip" title="{{ help_customer_device }}">{{ entry_customer_device }}</span></label><div class="col-sm-9"><label class="radio-inline"><input type="radio" name="codecart_customer_device_authorize_status" value="1" {% if codecart_customer_device_authorize_status %}checked{% endif %}> {{ text_enabled }}</label><label class="radio-inline"><input type="radio" name="codecart_customer_device_authorize_status" value="0" {% if not codecart_customer_device_authorize_status %}checked{% endif %}> {{ text_disabled }}</label></div></div>
              <div class="form-group"><label class="col-sm-3 control-label">{{ text_current_user_devices }}</label><div class="col-sm-9"><p class="form-control-static">{{ trusted_admin_devices }}</p><button type="submit" name="requested_action" value="revoke_admin_devices" class="btn btn-warning"><i class="fa fa-ban"></i> {{ button_revoke }}</button></div></div>
            </fieldset>
            <fieldset><legend><i class="fa fa-header"></i> {{ entry_security_headers }}</legend>
              <div class="form-group"><label class="col-sm-3 control-label"><span data-toggle="tooltip" title="{{ text_security_headers_help }}">{{ entry_security_headers }}</span></label><div class="col-sm-9"><label class="radio-inline"><input type="radio" name="codecart_security_headers_status" value="1" {% if codecart_security_headers_status %}checked{% endif %}> {{ text_enabled }}</label><label class="radio-inline"><input type="radio" name="codecart_security_headers_status" value="0" {% if not codecart_security_headers_status %}checked{% endif %}> {{ text_disabled }}</label><p class="help-block">{{ text_security_headers_help }}</p></div></div>
              <div class="form-group"><label class="col-sm-3 control-label"><span data-toggle="tooltip" title="{{ help_nosniff }}">{{ entry_nosniff }}</span></label><div class="col-sm-9"><label class="checkbox-inline"><input type="checkbox" name="codecart_security_nosniff_status" value="1" {% if codecart_security_nosniff_status %}checked{% endif %}> X-Content-Type-Options: nosniff</label></div></div>
              <div class="form-group"><label class="col-sm-3 control-label"><span data-toggle="tooltip" title="{{ help_referrer_policy }}">{{ entry_referrer_policy }}</span></label><div class="col-sm-5"><select name="codecart_security_referrer_policy" class="form-control"><option value="strict-origin-when-cross-origin" {% if codecart_security_referrer_policy == 'strict-origin-when-cross-origin' %}selected{% endif %}>strict-origin-when-cross-origin</option><option value="same-origin" {% if codecart_security_referrer_policy == 'same-origin' %}selected{% endif %}>same-origin</option><option value="no-referrer" {% if codecart_security_referrer_policy == 'no-referrer' %}selected{% endif %}>no-referrer</option><option value="origin" {% if codecart_security_referrer_policy == 'origin' %}selected{% endif %}>origin</option><option value="origin-when-cross-origin" {% if codecart_security_referrer_policy == 'origin-when-cross-origin' %}selected{% endif %}>origin-when-cross-origin</option><option value="strict-origin" {% if codecart_security_referrer_policy == 'strict-origin' %}selected{% endif %}>strict-origin</option></select></div></div>
              <div class="form-group"><label class="col-sm-3 control-label"><span data-toggle="tooltip" title="{{ help_frame_options }}">{{ entry_frame_options }}</span></label><div class="col-sm-2"><label class="checkbox-inline"><input type="checkbox" name="codecart_security_frame_options_status" value="1" {% if codecart_security_frame_options_status %}checked{% endif %}> {{ text_enabled }}</label></div><div class="col-sm-3"><select name="codecart_security_frame_options" class="form-control"><option value="SAMEORIGIN" {% if codecart_security_frame_options == 'SAMEORIGIN' %}selected{% endif %}>SAMEORIGIN</option><option value="DENY" {% if codecart_security_frame_options == 'DENY' %}selected{% endif %}>DENY</option></select></div></div>
              <div class="form-group"><label class="col-sm-3 control-label"><span data-toggle="tooltip" title="{{ help_permissions_policy }}">{{ entry_permissions_policy }}</span></label><div class="col-sm-2"><label class="checkbox-inline"><input type="checkbox" name="codecart_security_permissions_policy_status" value="1" {% if codecart_security_permissions_policy_status %}checked{% endif %}> {{ text_enabled }}</label></div><div class="col-sm-7"><input type="text" name="codecart_security_permissions_policy" value="{{ codecart_security_permissions_policy }}" class="form-control"></div></div>
              <div class="form-group"><label class="col-sm-3 control-label"><span data-toggle="tooltip" title="{{ text_csp_report_only_help }}">{{ entry_csp_report_only }}</span></label><div class="col-sm-9"><label class="checkbox-inline"><input type="checkbox" name="codecart_security_csp_report_only_status" value="1" {% if codecart_security_csp_report_only_status %}checked{% endif %}> {{ text_enabled }}</label><p class="help-block">{{ text_csp_report_only_help }}</p></div></div>
              <div class="form-group"><label class="col-sm-3 control-label"><span data-toggle="tooltip" title="{{ help_csp_policy }}">{{ entry_csp_policy }}</span></label><div class="col-sm-9"><textarea name="codecart_security_csp_report_only_policy" rows="3" class="form-control">{{ codecart_security_csp_report_only_policy }}</textarea></div></div>
              <div class="form-group"><label class="col-sm-3 control-label"><span data-toggle="tooltip" title="{{ text_hsts_help }}">{{ entry_hsts }}</span></label><div class="col-sm-2"><label class="checkbox-inline"><input type="checkbox" name="codecart_security_hsts_status" value="1" {% if codecart_security_hsts_status %}checked{% endif %}> {{ text_enabled }}</label></div><div class="col-sm-3"><input type="number" min="300" max="63072000" name="codecart_security_hsts_max_age" value="{{ codecart_security_hsts_max_age }}" class="form-control"></div><div class="col-sm-3"><label class="checkbox-inline"><input type="checkbox" name="codecart_security_hsts_subdomains" value="1" {% if codecart_security_hsts_subdomains %}checked{% endif %}> includeSubDomains</label></div><div class="col-sm-9 col-sm-offset-3"><p class="help-block">{{ text_hsts_help }}</p></div></div>
            </fieldset>
            <fieldset><legend><i class="fa fa-filter"></i> {{ entry_spam }}</legend><div class="form-group"><label class="col-sm-3 control-label"><span data-toggle="tooltip" title="{{ text_spam_help }}">{{ entry_spam }}</span></label><div class="col-sm-9"><label class="radio-inline"><input type="radio" name="codecart_spam_service_status" value="1" {% if codecart_spam_service_status %}checked{% endif %}> {{ text_enabled }}</label><label class="radio-inline"><input type="radio" name="codecart_spam_service_status" value="0" {% if not codecart_spam_service_status %}checked{% endif %}> {{ text_disabled }}</label><p class="help-block">{{ text_spam_help }}</p></div></div></fieldset>
            <div class="text-right"><button type="submit" class="btn btn-primary"><i class="fa fa-save"></i> {{ button_save }}</button></div>
          </form>
          <hr><div class="ccp-table-toolbar"><div><h4>{{ text_security_audit }}</h4><p class="help-block">{{ text_retention_auto }}: {{ codecart_security_audit_retention_days }}.</p></div><form action="{{ action }}" method="post" onsubmit="return confirm('{{ text_cleanup_confirm|escape('js') }}');"><input type="hidden" name="requested_action" value="cleanup_security_audit"><input type="hidden" name="return_tab" value="security"><button type="submit" class="btn btn-warning"><i class="fa fa-trash"></i> {{ button_cleanup_old }}</button></form></div><div class="table-responsive"><table class="table table-bordered table-hover"><thead><tr><td>{{ column_date }}</td><td>Event</td><td>{{ column_state }}</td><td>IP</td><td>{{ column_details }}</td></tr></thead><tbody>{% if security_audit %}{% for item in security_audit %}<tr><td>{{ item.date_added }}</td><td>{{ item.event }}</td><td>{{ item.outcome }}</td><td>{{ item.ip }}</td><td><span title="{{ item.user_agent }}">{{ item.username }}</span></td></tr>{% endfor %}{% else %}<tr><td colspan="5" class="text-center">{{ text_no_issues }}</td></tr>{% endif %}</tbody></table></div>
        </div>
        <div class="tab-pane" id="tab-privacy"><form action="{{ action }}" method="post" class="form-horizontal"><input type="hidden" name="core_action" value="save_privacy"><input type="hidden" name="return_tab" value="privacy"><div class="form-group"><label class="col-sm-3 control-label"><span data-toggle="tooltip" title="{{ help_gdpr }}">{{ entry_gdpr }}</span></label><div class="col-sm-9"><label class="radio-inline"><input type="radio" name="codecart_gdpr_status" value="1" {% if codecart_gdpr_status %}checked{% endif %}> {{ text_enabled }}</label><label class="radio-inline"><input type="radio" name="codecart_gdpr_status" value="0" {% if not codecart_gdpr_status %}checked{% endif %}> {{ text_disabled }}</label><p class="help-block">{{ text_gdpr_help }}</p></div></div><div class="form-group"><label class="col-sm-3 control-label"><span data-toggle="tooltip" title="{{ help_gdpr_retention }}">{{ entry_gdpr_retention }}</span></label><div class="col-sm-3"><input type="number" min="30" max="3650" name="codecart_gdpr_retention_days" value="{{ codecart_gdpr_retention_days }}" class="form-control"></div><div class="col-sm-6"><p class="help-block">{{ text_gdpr_retention_help }}</p></div></div><div class="form-group"><label class="col-sm-3 control-label"><span data-toggle="tooltip" title="{{ help_cookie }}">{{ entry_cookie }}</span></label><div class="col-sm-9"><p class="form-control-static">{% if config_cookie_consent_status %}<span class="label label-success">{{ text_enabled }}</span>{% else %}<span class="label label-default">{{ text_disabled }}</span>{% endif %}</p><p class="help-block">{{ text_cookie_help }}</p><a href="{{ cookie_settings_link }}" class="btn btn-default"><i class="fa fa-cog"></i> {{ button_cookie_settings }}</a></div></div><button type="submit" class="btn btn-primary"><i class="fa fa-save"></i> {{ button_save }}</button></form><hr><div class="ccp-table-toolbar"><div><h4>{{ text_gdpr_requests }}</h4><p class="help-block">{{ text_retention_auto }}: {{ codecart_gdpr_retention_days }}.</p></div><form action="{{ action }}" method="post" onsubmit="return confirm('{{ text_cleanup_confirm|escape('js') }}');"><input type="hidden" name="requested_action" value="cleanup_gdpr"><input type="hidden" name="return_tab" value="privacy"><button type="submit" class="btn btn-warning"><i class="fa fa-trash"></i> {{ button_cleanup_old }}</button></form></div><div class="table-responsive"><table class="table table-bordered table-hover"><thead><tr><td>{{ column_request }}</td><td>{{ column_email }}</td><td>{{ column_type }}</td><td>{{ column_state }}</td><td>{{ column_date }}</td><td class="text-right">{{ column_action }}</td></tr></thead><tbody>{% if gdpr_requests %}{% for item in gdpr_requests %}<tr><td>#{{ item.request_id }}</td><td>{{ item.email }}</td><td>{{ item.type }}</td><td>{{ item.status }}</td><td>{{ item.date_added }}</td><td class="text-right">{% if item.type == 'delete' and item.status == 'confirmed' %}<form action="{{ action }}" method="post" style="display:inline" onsubmit="return confirm('{{ text_confirm_delete|escape('js') }}');"><input type="hidden" name="core_action" value="gdpr_delete"><input type="hidden" name="return_tab" value="privacy"><input type="hidden" name="request_id" value="{{ item.request_id }}"><button type="submit" class="btn btn-danger" data-toggle="tooltip" title="{{ button_process_delete }}"><i class="fa fa-user-times"></i></button></form>{% endif %}</td></tr>{% endfor %}{% else %}<tr><td colspan="6" class="text-center">{{ text_no_issues }}</td></tr>{% endif %}</tbody></table></div></div>
        <div class="tab-pane" id="tab-schema">
          <p class="help-block">{{ text_schema_readonly }}</p>
          <p class="help-block">{{ text_schema_external_help }}</p>
