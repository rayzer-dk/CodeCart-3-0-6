                <button type="submit" name="requested_action" value="icons_add_found" class="btn btn-default"><i class="fa fa-plus" aria-hidden="true"></i> {{ button_icon_add_found }}</button>
              </form>
            </div>
          </div>
          <p class="help-block">{{ text_icon_help }}</p>
          <div class="ccp-icon-package-tabs" role="tablist" aria-label="Font Awesome packages">
            <button type="button" class="btn btn-primary active" data-icon-package="core"><i class="fa-solid fa-gauge-high"></i> {{ text_icon_core_package }} <span class="badge">{{ icon_catalog|length }}</span></button>
