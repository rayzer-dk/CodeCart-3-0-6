    </div></div>
  </div>
</div>
<script>$(function(){var tab='{{ active_tab|escape('js') }}';$('#core-tabs a[href="#tab-'+tab+'"]').tab('show');$('#core-tabs a[data-toggle="tab"]').on('shown.bs.tab',function(e){var id=$(e.target).attr('href').replace('#tab-','');try{history.replaceState(null,'','index.php?route=tool/codecart_core&user_token={{ user_token }}&tab='+encodeURIComponent(id));}catch(x){}});});</script>
<script type="text/javascript">
$('#about-accordion').on('shown.bs.collapse hidden.bs.collapse',function(){ $('#about-accordion .panel-title>a').each(function(){var open=$($(this).attr('href')).hasClass('in');$(this).attr('aria-expanded',open?'true':'false');$(this).find('.ccp-collapse-chevron i').attr('class',open?'fa fa-chevron-up':'fa fa-chevron-down');});});
</script>
<script type="text/javascript">
(function(){
var input=document.getElementById('ccp-icon-search'),tab=document.getElementById('tab-icons'),filters=document.getElementById('ccp-icon-filters'),styleFilters=document.getElementById('ccp-icon-style-filters'),status=document.getElementById('ccp-icon-copy-status');
if(!input||!tab)return;
var activeCategory='all',activeStyle='all',activePackage='core',fullLoaded=false,fullLoading=false;
function panel(){return tab.querySelector('[data-icon-package-panel="'+activePackage+'"]');}
function applyFilter(){var q=(input.value||'').toLowerCase(),root=panel();if(!root)return;var items=root.querySelectorAll('.ccp-icon-item');for(var i=0;i<items.length;i++){var icon=(items[i].getAttribute('data-search')||items[i].getAttribute('data-icon')||'').toLowerCase(),cat=items[i].getAttribute('data-category')||'other',style=items[i].getAttribute('data-style')||'solid';var categoryOk=activePackage==='full'||activeCategory==='all'||cat===activeCategory;var styleOk=activePackage==='core'||activeStyle==='all'||(' '+style+' ').indexOf(' '+activeStyle+' ')!==-1;items[i].style.display=(!q||icon.indexOf(q)!==-1)&&categoryOk&&styleOk?'':'none';}}
function createFullIcon(icon){var button=document.createElement('button');button.type='button';button.className='ccp-icon-item';button.setAttribute('data-icon',icon.class||'');button.setAttribute('data-search',(icon.search||'')+' '+(icon.class||''));button.setAttribute('data-style',icon.style_filter||icon.style||'solid');button.title=(icon.class||'')+' · '+(icon.label||icon.name||'');var preview=document.createElement('i');preview.className=(icon.class||'')+' fa-2x';var name=document.createElement('span');name.textContent=icon.class||'';var styles=document.createElement('small');styles.textContent=Array.isArray(icon.styles)?icon.styles.join('/'):(icon.style_filter||'');var copy=document.createElement('i');copy.className='fa fa-copy ccp-icon-copy';copy.setAttribute('aria-hidden','true');button.appendChild(preview);button.appendChild(name);button.appendChild(styles);button.appendChild(copy);return button;}
function loadFullIcons(){if(fullLoaded||fullLoading)return;var root=document.getElementById('ccp-icon-grid-full');if(!root)return;var url=root.getAttribute('data-url')||'';if(!url)return;fullLoading=true;root.innerHTML='<p class="help-block ccp-icon-lazy-status"><i class="fa fa-spinner fa-spin"></i> {{ text_icon_loading|escape('js') }}</p>';fetch(url,{credentials:'same-origin',headers:{'X-Requested-With':'XMLHttpRequest'}}).then(function(response){if(!response.ok)throw new Error('HTTP '+response.status);return response.json();}).then(function(json){var rows=json&&Array.isArray(json.icons)?json.icons:[];root.innerHTML='';var index=0;function chunk(){var fragment=document.createDocumentFragment(),end=Math.min(rows.length,index+120);for(;index<end;index++){fragment.appendChild(createFullIcon(rows[index]));}root.appendChild(fragment);if(index<rows.length){window.requestAnimationFrame(chunk);}else{fullLoaded=true;fullLoading=false;applyFilter();}}chunk();}).catch(function(){fullLoading=false;root.innerHTML='<p class="text-danger"><i class="fa fa-exclamation-circle"></i> {{ text_icon_load_error|escape('js') }}</p>';});}
function setPackage(name){activePackage=name==='full'?'full':'core';var buttons=tab.querySelectorAll('[data-icon-package]'),panels=tab.querySelectorAll('[data-icon-package-panel]'),helps=tab.querySelectorAll('[data-icon-package-help]');for(var i=0;i<buttons.length;i++){var on=buttons[i].getAttribute('data-icon-package')===activePackage;buttons[i].classList.toggle('active',on);buttons[i].classList.toggle('btn-primary',on);buttons[i].classList.toggle('btn-default',!on);}for(var j=0;j<panels.length;j++){panels[j].style.display=panels[j].getAttribute('data-icon-package-panel')===activePackage?'':'none';}for(var k=0;k<helps.length;k++){helps[k].style.display=helps[k].getAttribute('data-icon-package-help')===activePackage?'':'none';}if(filters)filters.style.display=activePackage==='core'?'':'none';if(styleFilters)styleFilters.style.display=activePackage==='full'?'flex':'none';if(activePackage==='full'){loadFullIcons();}applyFilter();}
function copyText(value,button){function done(){if(status){status.textContent='{{ text_icon_copied|escape('js') }}: '+value;}button.classList.add('is-copied');setTimeout(function(){button.classList.remove('is-copied');if(status){status.textContent='';}},1400);}if(navigator.clipboard&&window.isSecureContext){navigator.clipboard.writeText(value).then(done).catch(function(){fallback(value,done);});}else{fallback(value,done);}}
function fallback(value,done){var ta=document.createElement('textarea');ta.value=value;ta.setAttribute('readonly','');ta.style.position='fixed';ta.style.opacity='0';document.body.appendChild(ta);ta.select();try{document.execCommand('copy');done();}catch(e){}document.body.removeChild(ta);}
input.addEventListener('input',applyFilter);
tab.addEventListener('click',function(e){var packageBtn=e.target.closest('[data-icon-package]');if(packageBtn){setPackage(packageBtn.getAttribute('data-icon-package'));return;}var btn=e.target.closest('.ccp-icon-item');if(btn){copyText(btn.getAttribute('data-icon')||'',btn);}});
if(filters){filters.addEventListener('click',function(e){var btn=e.target.closest('[data-icon-category]');if(!btn)return;activeCategory=btn.getAttribute('data-icon-category')||'all';var buttons=filters.querySelectorAll('[data-icon-category]');for(var i=0;i<buttons.length;i++){buttons[i].classList.toggle('active',buttons[i]===btn);}applyFilter();});}
if(styleFilters){styleFilters.addEventListener('click',function(e){var btn=e.target.closest('[data-icon-style]');if(!btn)return;activeStyle=btn.getAttribute('data-icon-style')||'all';var buttons=styleFilters.querySelectorAll('[data-icon-style]');for(var i=0;i<buttons.length;i++){buttons[i].classList.toggle('active',buttons[i]===btn);}applyFilter();});}
setPackage('core');
})();
</script>
<script type="text/javascript">
$(document).on('click','.ccp-copy-value',function(){
  var value=$(this).attr('data-copy-value')||'';
  var fallback=function(){var $t=$('<textarea readonly>').val(value).css({position:'fixed',left:'-9999px'}).appendTo('body');$t[0].select();try{document.execCommand('copy');}catch(e){}$t.remove();};
  if(navigator.clipboard&&window.isSecureContext){navigator.clipboard.writeText(value).catch(fallback);}else{fallback();}
});
</script>

