            <div class="ccp-icon-grid ccp-icon-grid-full" id="ccp-icon-grid-full" data-url="{{ icon_full_url }}"><p class="help-block ccp-icon-lazy-status">{{ text_icon_full_package_help }}</p></div>
          </div>
        </div>
        <div class="tab-pane ccp-core-about" id="tab-about">
          <div class="ccp-about-hero">
            <div>
              <h2 class="ccp-about-title"><i class="fa fa-shopping-cart"></i> CodeCart PRO {{ about_version }}</h2>
