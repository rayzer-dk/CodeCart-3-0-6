{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right"><a href="#scheduler-form" id="button-scheduler-add" class="btn btn-primary" data-toggle="tooltip" title="{{ button_add }}"><i class="fa fa-plus"></i></a></div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">{% for breadcrumb in breadcrumbs %}<li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>{% endfor %}</ul>
    </div>
  </div>
  <div class="container-fluid">
    {% if warning %}<div class="alert alert-danger alert-dismissible"><button type="button" class="close" data-dismiss="alert" aria-label="{{ button_close }}" title="{{ button_close }}">&times;</button><i class="fa fa-exclamation-circle"></i> {{ warning }}</div>{% endif %}
    {% if success %}<div class="alert alert-success alert-dismissible"><button type="button" class="close" data-dismiss="alert" aria-label="{{ button_close }}" title="{{ button_close }}">&times;</button><i class="fa fa-check-circle"></i> {{ success }}</div>{% endif %}

    <div class="panel panel-default">
      <div class="panel-heading"><h3 class="panel-title"><i class="fa fa-clock-o"></i> {{ heading_title }}</h3></div>
      <div class="panel-body">
        <div class="ccp-scheduler-status ccp-scheduler-status-{{ scheduler_health }}">
          <i class="fa fa-{{ scheduler_health == 'ok' ? 'check-circle' : 'exclamation-circle' }}"></i>
          <strong>{{ text_scheduler_health }}:</strong> {{ scheduler_health == 'ok' ? text_scheduler_health_ok : (scheduler_health == 'warn' ? text_scheduler_health_warn : text_scheduler_health_none) }}
          {% if scheduler_health_date %}<code>{{ scheduler_health_date }}</code>{% endif %}
          <div class="help-block">{{ text_last_execution_help }}{% if scheduler_health_source %} ({{ scheduler_health_source == 'cli' ? text_host_source_cli : text_host_source_web }}{% if scheduler_health_errors %}, {{ text_host_failed }}: {{ scheduler_health_errors }}{% endif %}){% endif %}</div>
        </div>
        <p class="help-block ccp-scheduler-intro">{{ text_scheduler_intro }} <strong>{{ text_scheduler_host_unverified }}</strong> {{ text_real_frequency_help }}</p>
        <details class="ccp-scheduler-setup-details"><summary><i class="fa fa-cog"></i> {{ text_server_setup }} <i class="fa fa-angle-down"></i></summary>
          <p class="help-block">{{ text_server_one_command }}</p>
          <p class="help-block"><strong>{{ text_server_interval }}</strong> <code>*/5 * * * *</code></p>
          <div class="form-group"><label>{{ text_cli }}</label><div class="input-group"><input type="text" id="cron-cli" class="form-control" readonly value="{{ cli_command }}"><span class="input-group-btn"><button class="btn btn-default js-copy" type="button" data-target="cron-cli" title="{{ button_copy }}"><i class="fa fa-copy"></i></button></span></div></div>
          <div class="form-group"><label>{{ text_web_cron }}</label><div class="input-group"><input type="password" id="cron-http" class="form-control" readonly value="{{ http_command }}"><span class="input-group-btn"><button class="btn btn-default js-reveal" type="button" data-target="cron-http" title="{{ text_advanced_options }}"><i class="fa fa-eye"></i></button><button class="btn btn-default js-copy" type="button" data-target="cron-http" title="{{ button_copy }}"><i class="fa fa-copy"></i></button></span></div></div>
          <details class="ccp-scheduler-help"><summary><i class="fa fa-question-circle"></i> {{ text_scheduler_usage }}</summary>
            <p>{{ text_existing_codes_info }}</p><p>{{ text_session_cleanup }} {{ text_cache_note }} {{ text_extra_modules }}</p>
          </details>
        </details>
      </div>
    </div>

    <ul class="nav nav-tabs ccp-scheduler-tabs" role="tablist" id="ccp-scheduler-tabs">
      <li class="active"><a href="#ccp-scheduler-tab-tasks" role="tab" data-toggle="tab"><i class="fa fa-clock-o"></i> {{ text_scheduled_tab }}</a></li>
      <li><a href="#ccp-scheduler-tab-external" role="tab" data-toggle="tab"><i class="fa fa-cloud"></i> {{ text_external_tab }}</a></li>
      <li><a href="#ccp-scheduler-tab-queue" role="tab" data-toggle="tab"><i class="fa fa-tasks"></i> {{ text_queue_tab }}{% if queue_stats.failed %} <span class="label label-danger">{{ queue_stats.failed }}</span>{% endif %}</a></li>
    </ul>
    <div class="tab-content ccp-scheduler-tab-content">
    <div class="tab-pane active" id="ccp-scheduler-tab-tasks" role="tabpanel">
    <div class="panel panel-default">
      <div class="panel-heading"><h3 class="panel-title"><i class="fa fa-list"></i> {{ text_jobs }}</h3></div>
      <div class="table-responsive">
        <table class="table table-bordered table-hover codecart-scheduler-table">
          <thead><tr><th>{{ text_job_name_header }}</th><th>{{ column_route }}</th><th>{{ column_interval }}</th><th>{{ column_status }}</th><th>{{ column_last }}</th><th>{{ column_next }}</th><th>{{ column_result }}</th><th class="text-right">{{ column_action }}</th></tr></thead>
          <tbody>
          {% if jobs %}
            {% for job in jobs %}
            <tr data-scheduler-id="{{ job.scheduler_id }}">
              <td class="ccp-scheduler-task-cell"><div class="ccp-task-single-line"><strong class="ccp-task-name" title="{{ job.display_name|e('html_attr') }} — {{ job.code|e('html_attr') }}">{{ job.display_name }}</strong>{% if job.is_core %}<span class="label label-info" title="{{ text_core_task }}">{{ text_core_task }}</span>{% endif %}{% if job.description %}<span class="ccp-scheduler-task-help" data-toggle="tooltip" title="{{ job.description|e('html_attr') }}"><i class="fa fa-question-circle"></i></span>{% endif %}</div></td>
              <td title="{{ job.route|e('html_attr') }}"><code>{{ job.route }}</code></td>
              <td title="{{ job.interval_seconds }} s">{{ job.interval_text }}</td>
              <td>{% if job.status %}<span class="label label-success">{{ text_enabled }}</span>{% else %}<span class="label label-default">{{ text_disabled }}</span>{% endif %}</td>
              <td>{{ job.date_last ?: '—' }}</td>
              <td>{% if job.status %}{{ job.date_next ?: '—' }}{% else %}<span class="text-muted" title="{{ text_task_paused }}">—</span>{% endif %}</td>
              <td>{% if job.last_status %}<span class="label label-{{ job.last_status == 'success' ? 'success' : 'danger' }}" title="{{ job.last_message_localized }}">{{ job.last_status_text }}</span>{% if job.last_duration_ms is not null %} <small>{{ job.last_duration_ms }} ms</small>{% endif %}{% else %}—{% endif %}</td>
              <td class="text-right codecart-scheduler-actions">
                {% if can_modify %}<div class="ccp-scheduler-action-group">
                <form action="{{ action }}" method="post"{% if not job.status %} onsubmit="return confirm('{{ text_manual_run_disabled|e('js') }}');"{% endif %}><input type="hidden" name="scheduler_action" value="run"><input type="hidden" name="scheduler_id" value="{{ job.scheduler_id }}"><button type="submit" class="btn btn-info" data-toggle="tooltip" title="{{ button_run }}{% if not job.status %}: {{ text_manual_run_disabled|e('html_attr') }}{% endif %}"><i class="fa fa-play"></i></button></form>
                <a href="{{ action }}&amp;edit_id={{ job.scheduler_id }}#scheduler-form" data-id="{{ job.scheduler_id }}" class="btn btn-primary js-scheduler-edit" data-toggle="tooltip" title="{{ button_edit }}"><i class="fa fa-pencil"></i></a>
                <form action="{{ action }}" method="post"><input type="hidden" name="scheduler_action" value="toggle"><input type="hidden" name="scheduler_id" value="{{ job.scheduler_id }}"><input type="hidden" name="status" value="{{ job.status ? 0 : 1 }}"><button type="submit" class="btn btn-{{ job.status ? 'warning' : 'success' }}" data-toggle="tooltip" title="{{ job.status ? button_disable : button_enable }}"><i class="fa fa-{{ job.status ? 'pause' : 'play-circle' }}"></i></button></form>
                {% if not job.is_core %}<form action="{{ action }}" method="post" onsubmit="return confirm('{{ text_confirm|e('js') }}');"><input type="hidden" name="scheduler_action" value="delete"><input type="hidden" name="scheduler_id" value="{{ job.scheduler_id }}"><button type="submit" class="btn btn-danger" data-toggle="tooltip" title="{{ button_delete }}"><i class="fa fa-trash-o"></i></button></form>{% endif %}
                </div>{% endif %}
              </td>
            </tr>
            {% endfor %}
          {% else %}<tr><td colspan="8" class="text-center">{{ text_no_results }}</td></tr>{% endif %}
          </tbody>
        </table>
      </div>
      <div class="panel-footer">{{ text_queue }}: {{ text_queue_pending }} {{ queue_stats.pending|default(0) }}, {{ text_queue_processing }} {{ queue_stats.processing|default(0) }}, {{ text_queue_failed }} {{ queue_stats.failed|default(0) }}, {{ text_queue_done }} {{ queue_stats.done|default(0) }}</div>
    </div>

    {% if can_modify %}
    <div class="panel panel-default" id="scheduler-form" data-info-url="{{ task_info_url|e('html_attr') }}" data-loading="{{ text_loading_task|e('html_attr') }}" data-load-error="{{ error_loading_task|e('html_attr') }}" data-add-title="{{ text_add_task|e('html_attr') }}" data-edit-title="{{ text_edit_task|e('html_attr') }}">
      <div class="panel-heading"><h3 class="panel-title"><i class="fa fa-{{ edit_task.scheduler_id ? 'pencil' : 'plus' }}"></i> {{ edit_task.scheduler_id ? text_edit_task : text_add_task }}</h3></div>
      <div class="panel-body">
        <form action="{{ action }}" method="post" class="form-horizontal">
          <input type="hidden" name="scheduler_action" value="save">
          <input type="hidden" name="scheduler_id" value="{{ edit_task.scheduler_id }}">
          <div class="ccp-scheduler-guide help-block">{{ text_create_task_hint }}</div>
          {% if scheduler_form_error %}<div class="alert alert-danger ccp-scheduler-form-error" role="alert"><i class="fa fa-exclamation-triangle"></i> {{ scheduler_form_error }}</div>{% endif %}
          <div class="form-group" id="ccp-scheduler-handler-group"><label class="col-sm-2 control-label" for="input-scheduler-available">{{ text_choose_available_handler }}</label><div class="col-sm-10">
            <select id="input-scheduler-available" name="available_handler" class="form-control"><option value="">{{ text_manual }}</option>{% for handler in available_handlers %}<option value="{{ handler.route }}" data-code="{{ handler.code }}" {{ edit_task.available_handler is defined and edit_task.available_handler == handler.route ? 'selected' : '' }}>{{ handler.route }}</option>{% endfor %}</select>
            <small class="help-block">{{ text_handler_select_help }}</small>
            {% if not available_handlers %}<div class="ccp-scheduler-empty-handlers help-block"><i class="fa fa-info-circle"></i> {{ text_no_free_handler }}</div>{% endif %}
          </div></div>
          <div class="form-group required"><label class="col-sm-2 control-label" for="input-scheduler-frequency">{{ text_interval_preset }}</label><div class="col-sm-10">
            <select id="input-scheduler-frequency" class="form-control">
              {% for preset in frequency_presets %}
              <option value="{{ preset.seconds }}" {{ edit_task.interval_seconds == preset.seconds ? 'selected' : '' }}>{{ preset.label }}</option>
              {% endfor %}
              <option value="custom" {{ edit_task.interval_seconds not in [300,600,900,1800,3600,21600,43200,86400] ? 'selected' : '' }}>{{ text_interval_custom }}</option>
            </select>
            <div class="ccp-scheduler-custom-interval" id="scheduler-custom-interval"><label class="control-label" for="input-scheduler-interval">{{ entry_interval }}</label>
              <input type="number" min="{{ edit_task.scheduler_id ? 60 : 300 }}" max="31536000" step="1" name="interval_seconds" value="{{ edit_task.interval_seconds }}" id="input-scheduler-interval" class="form-control" required>
              <small class="help-block">{{ text_scheduler_limit_info }}</small>
            </div>
          </div></div>
          <details class="ccp-scheduler-advanced"><summary><i class="fa fa-cog"></i> {{ text_advanced_identifiers }}</summary>
          <div class="form-group"><label class="col-sm-2 control-label" for="input-scheduler-code">{{ entry_code }}</label><div class="col-sm-10"><input type="text" name="code" value="{{ edit_task.code }}" id="input-scheduler-code" class="form-control" maxlength="128" readonly><small class="help-block">{{ text_job_code_help }}</small></div></div>
          <div class="form-group"><label class="col-sm-2 control-label" for="input-scheduler-route">{{ entry_route }}</label><div class="col-sm-10"><input type="text" name="route" value="{{ edit_task.route }}" id="input-scheduler-route" class="form-control" readonly><small class="help-block">{{ text_route_help }}</small></div></div>
          <div class="form-group"><label class="col-sm-2 control-label" for="input-scheduler-args"><span data-toggle="tooltip" title="{{ text_args_help }}">{{ entry_args }}</span></label><div class="col-sm-10"><textarea name="args" rows="3" id="input-scheduler-args" class="form-control" spellcheck="false">{{ edit_task.args }}</textarea><small class="help-block">{{ text_json_example }}</small></div></div></details>
          <div class="form-group"><label class="col-sm-2 control-label" for="input-scheduler-status">{{ entry_status }}</label><div class="col-sm-10"><select name="status" id="input-scheduler-status" class="form-control"><option value="1" {{ edit_task.status ? 'selected' : '' }}>{{ text_enabled }}</option><option value="0" {{ not edit_task.status ? 'selected' : '' }}>{{ text_disabled }}</option></select></div></div>
          <div class="text-right"><a href="{{ cancel }}" class="btn btn-default js-scheduler-cancel"><i class="fa fa-reply"></i> {{ button_cancel }}</a> <button type="submit" id="scheduler-save-button" class="btn btn-primary"><i class="fa fa-save"></i> {{ button_save }}</button></div>
        </form>
      </div>
    </div>
    {% endif %}

    <div class="panel panel-default" id="ccp-scheduler-history">
      <div class="panel-heading"><h3 class="panel-title"><i class="fa fa-history"></i> {{ text_run_history }}</h3></div>
      <div class="panel-body ccp-scheduler-history-filter">
        <form method="get" action="{{ history_filter_action }}" class="form-inline">
          <input type="hidden" name="route" value="tool/scheduler"><input type="hidden" name="user_token" value="{{ user_token }}">
          <label for="history-task">{{ text_history_filter }}</label>
          <select id="history-task" name="history_task" class="form-control input-sm">
            <option value="0">{{ text_all }}</option>
            {% for task in jobs %}<option value="{{ task.scheduler_id }}" {{ history_filter_task == task.scheduler_id ? 'selected' : '' }}>{{ task.display_name }}</option>{% endfor %}
          </select>
          <button type="submit" class="btn btn-primary btn-sm" title="{{ button_filter }}"><i class="fa fa-filter"></i></button>
        </form>
      </div>
      <div class="table-responsive"><table class="table table-hover table-bordered ccp-scheduler-history-table">
        <thead><tr><th>{{ text_history_date }}</th><th>{{ text_history_task }}</th><th>{{ text_history_source }}</th><th>{{ text_history_result }}</th><th>{{ text_history_duration }}</th><th>{{ text_history_message }}</th></tr></thead>
        <tbody>{% for history in history_rows %}<tr>
          <td class="text-nowrap">{{ history.date_added }}</td><td><span class="ccp-ellipsis" title="{{ history.task_code|e('html_attr') }}">{{ history.task_code }}</span></td>
          <td>{{ history.source == 'cli' ? text_host_source_cli : (history.source == 'web' ? text_host_source_web : (history.source == 'manual' ? text_history_source_manual : text_history_source_visitor)) }}</td>
          <td><span class="label label-{{ history.result == 'success' ? 'success' : 'danger' }}">{{ history.result == 'success' ? text_success : text_result_error }}</span></td>
          <td>{{ history.duration_ms }} ms</td><td><span class="ccp-ellipsis" title="{{ history.message|e('html_attr') }}">{{ history.message }}</span></td>
        </tr>{% else %}<tr><td colspan="6" class="text-center">{{ text_history_empty }}</td></tr>{% endfor %}</tbody>
      </table></div>
      {% if history_pagination %}<div class="panel-footer ccp-scheduler-history-pagination">{{ history_pagination }}</div>{% endif %}
    </div>
    </div>
    <div class="tab-pane" id="ccp-scheduler-tab-external" role="tabpanel">
    {% if can_modify %}
    <div class="panel panel-default ccp-external-cron-import" id="ccp-external-cron-import">
      <div class="panel-heading"><h3 class="panel-title"><i class="fa fa-cloud"></i> {{ text_external_import_title }}</h3></div>
      <div class="panel-body">
        <p class="help-block">{{ text_external_import_help }}</p>
        <form action="{{ action }}" method="post" class="form-horizontal">
          <input type="hidden" name="scheduler_action" value="save_external">
          <div class="form-group"><label class="col-sm-2 control-label" for="ccp-external-command">{{ text_external_import_command }}</label>
          <div class="col-sm-10"><div class="input-group"><input type="password" name="external_command" id="ccp-external-command" class="form-control" autocomplete="off" spellcheck="false" maxlength="4096" required placeholder="curl -fsSL -H 'X-ACP-Cron-Key: …' 'https://shop.example/index.php?route=extension/module/example/cron'">
          <span class="input-group-btn"><button class="btn btn-default js-reveal" type="button" data-target="ccp-external-command" title="{{ text_advanced_options }}"><i class="fa fa-eye"></i></button></span></div>
          <small class="help-block">{{ text_external_import_secret_note }}</small></div></div>
          <div class="form-group"><label class="col-sm-2 control-label" for="ccp-external-interval">{{ text_external_import_frequency }}</label>
          <div class="col-sm-10"><select name="external_interval" id="ccp-external-interval" class="form-control">
            <option value="300">5 min</option><option value="600">10 min</option><option value="900" selected>15 min</option><option value="1800">30 min</option><option value="3600">1 h</option><option value="21600">6 h</option><option value="43200">12 h</option><option value="86400">24 h</option>
          </select></div></div>
          <div class="text-right"><button type="submit" class="btn btn-primary"><i class="fa fa-plus"></i> {{ text_external_import_submit }}</button></div>
        </form>
        <p class="help-block ccp-external-cron-warning"><i class="fa fa-shield"></i> {{ text_external_import_safety }}</p>
      </div>
    </div>
    {% endif %}

    <details class="ccp-scheduler-host-details"><summary><i class="fa fa-terminal"></i> {{ text_host_task_type }} <i class="fa fa-angle-down"></i></summary>
    <div class="panel panel-default ccp-host-task-helper">
      <div class="panel-heading"><h3 class="panel-title"><i class="fa fa-terminal"></i> {{ text_host_task_type }}</h3></div>
      <div class="panel-body">
        <p class="help-block">{{ text_host_command_help }}</p>
        <div class="form-group"><label for="ccp-host-command">{{ text_host_command_label }}</label>
          <div class="input-group"><input type="password" id="ccp-host-command" class="form-control" autocomplete="off" spellcheck="false" placeholder="php /path/to/module/cron.php" />
            <span class="input-group-btn"><button type="button" class="btn btn-default" id="ccp-host-reveal" title="{{ text_advanced_options }}"><i class="fa fa-eye"></i></button><button type="button" class="btn btn-default" id="ccp-copy-host-command" title="{{ button_copy }}"><i class="fa fa-copy"></i></button></span></div>
        </div>
        <div class="form-group ccp-host-frequency"><label for="ccp-host-frequency">{{ text_interval_preset }}</label>
          <select class="form-control" id="ccp-host-frequency"><option value="5">5 min</option><option value="10">10 min</option><option value="15">15 min</option><option value="30">30 min</option><option value="60">1 h</option><option value="1440">1 d</option><option value="custom">{{ text_interval_custom }}</option></select>
        </div>
        <div class="ccp-host-time-fields">
          {% for field in [{'id':'minute','label':text_host_minute,'value':'*/5'},{'id':'hour','label':text_host_hour,'value':'*'},{'id':'dom','label':text_host_dom,'value':'*'},{'id':'month','label':text_host_month,'value':'*'},{'id':'dow','label':text_host_dow,'value':'*'}] %}
          <div><label for="ccp-host-{{ field.id }}">{{ field.label }}</label><input type="text" class="form-control ccp-host-time" id="ccp-host-{{ field.id }}" value="{{ field.value }}" autocomplete="off" /></div>
          {% endfor %}
        </div>
        <p class="help-block">{{ text_host_schedule_help }}</p>
        <div class="alert alert-info ccp-host-security"><i class="fa fa-info-circle"></i> {{ text_host_security }}</div>
      </div>
    </div>

    </details>
    </div>
    <div class="tab-pane" id="ccp-scheduler-tab-queue" role="tabpanel">
    <div class="panel panel-default codecart-queue-panel">
      <div class="panel-heading clearfix">
        <h3 class="panel-title pull-left"><i class="fa fa-tasks"></i> {{ text_queue_jobs }}</h3>
        {% if can_modify %}
        <form action="{{ action }}" method="post" class="pull-right">
          <input type="hidden" name="scheduler_action" value="run_queue">
          <button type="submit" class="btn btn-primary btn-sm" title="{{ button_run_queue }}"><i class="fa fa-play"></i> {{ button_run_queue }}</button>
        </form>
        {% endif %}
      </div>
      <div class="panel-body">
        <p class="help-block">{{ text_queue_worker_help }}</p>
        <form action="{{ action }}" method="get" class="row codecart-queue-filters">
          <input type="hidden" name="route" value="tool/scheduler">
          <input type="hidden" name="user_token" value="{{ user_token }}">
          <div class="col-sm-5"><label for="input-queue-search">{{ entry_queue_search }}</label><input type="text" name="queue_search" value="{{ queue_filter_search }}" id="input-queue-search" class="form-control"></div>
          <div class="col-sm-3"><label for="input-queue-status">{{ entry_queue_status }}</label><select name="queue_status" id="input-queue-status" class="form-control"><option value="">{{ text_all }}</option><option value="pending" {{ queue_filter_status == 'pending' ? 'selected' : '' }}>{{ text_queue_pending }}</option><option value="processing" {{ queue_filter_status == 'processing' ? 'selected' : '' }}>{{ text_queue_processing }}</option><option value="failed" {{ queue_filter_status == 'failed' ? 'selected' : '' }}>{{ text_queue_failed }}</option><option value="done" {{ queue_filter_status == 'done' ? 'selected' : '' }}>{{ text_queue_done }}</option></select></div>
          <div class="col-sm-2"><label for="input-queue-limit">{{ entry_queue_limit }}</label><select name="queue_limit" id="input-queue-limit" class="form-control">{% for item in [10,25,50,100] %}<option value="{{ item }}" {{ queue_limit == item ? 'selected' : '' }}>{{ item }}</option>{% endfor %}</select></div>
          <div class="col-sm-2 codecart-queue-filter-actions"><label>&nbsp;</label><div><button type="submit" class="btn btn-primary" title="{{ button_filter }}"><i class="fa fa-filter"></i></button> <a href="{{ queue_reset }}" class="btn btn-default" title="{{ button_reset }}"><i class="fa fa-refresh"></i></a></div></div>
        </form>
      </div>
      <div class="table-responsive">
        <table class="table table-bordered table-hover codecart-queue-table">
          <thead><tr><th><a href="{{ queue_sort_links.queue_id }}">{{ column_queue_id }}{% if queue_sort == 'queue_id' %} <i class="fa fa-caret-{{ queue_order == 'ASC' ? 'up' : 'down' }}"></i>{% endif %}</a></th><th><a href="{{ queue_sort_links.code }}">{{ column_code }}{% if queue_sort == 'code' %} <i class="fa fa-caret-{{ queue_order == 'ASC' ? 'up' : 'down' }}"></i>{% endif %}</a></th><th><a href="{{ queue_sort_links.route }}">{{ column_route }}{% if queue_sort == 'route' %} <i class="fa fa-caret-{{ queue_order == 'ASC' ? 'up' : 'down' }}"></i>{% endif %}</a></th><th><a href="{{ queue_sort_links.status }}">{{ column_status }}{% if queue_sort == 'status' %} <i class="fa fa-caret-{{ queue_order == 'ASC' ? 'up' : 'down' }}"></i>{% endif %}</a></th><th><a href="{{ queue_sort_links.attempts }}">{{ column_attempts }}{% if queue_sort == 'attempts' %} <i class="fa fa-caret-{{ queue_order == 'ASC' ? 'up' : 'down' }}"></i>{% endif %}</a></th><th><a href="{{ queue_sort_links.available_at }}">{{ column_available }}{% if queue_sort == 'available_at' %} <i class="fa fa-caret-{{ queue_order == 'ASC' ? 'up' : 'down' }}"></i>{% endif %}</a></th><th><a href="{{ queue_sort_links.date_modified }}">{{ column_modified }}{% if queue_sort == 'date_modified' %} <i class="fa fa-caret-{{ queue_order == 'ASC' ? 'up' : 'down' }}"></i>{% endif %}</a></th><th>{{ column_error }}</th><th class="text-right">{{ column_action }}</th></tr></thead>
          <tbody>
          {% if queue_jobs %}
            {% for job in queue_jobs %}
            <tr>
              <td>{{ job.queue_id }}</td>
              <td><strong class="ccp-ellipsis" title="{{ job.code }}">{{ job.code }}</strong></td>
              <td><code class="ccp-ellipsis" title="{{ job.route }}">{{ job.route }}</code></td>
              <td><span class="label label-{{ job.status == 'done' ? 'success' : (job.status == 'failed' ? 'danger' : (job.status == 'processing' ? 'info' : 'warning')) }}">{% if job.status == 'pending' %}{{ text_queue_pending }}{% elseif job.status == 'processing' %}{{ text_queue_processing }}{% elseif job.status == 'failed' %}{{ text_queue_failed }}{% else %}{{ text_queue_done }}{% endif %}</span></td>
              <td>{{ job.attempts }}/{{ job.max_attempts }}</td>
              <td>{{ job.available_at ?: '—' }}</td>
              <td>{{ job.date_modified ?: '—' }}</td>
              <td><span class="ccp-ellipsis" title="{{ job.last_error_localized ?: '' }}">{{ job.last_error_localized ?: '—' }}</span></td>
              <td class="text-right codecart-queue-actions">
                {% if can_modify and job.status in ['pending','failed'] %}<form action="{{ action }}" method="post" style="display:inline-block"><input type="hidden" name="scheduler_action" value="run_queue_one"><input type="hidden" name="queue_id" value="{{ job.queue_id }}"><input type="hidden" name="retry" value="{{ job.status == 'failed' ? 1 : 0 }}"><button type="submit" class="btn btn-primary btn-sm" title="{{ job.status == 'failed' ? button_queue_retry : button_queue_run }}"><i class="fa fa-{{ job.status == 'failed' ? 'repeat' : 'play' }}"></i></button></form>{% endif %}
                {% if can_modify and job.status != 'processing' %}<form action="{{ action }}" method="post" style="display:inline-block" onsubmit="return confirm('{{ text_queue_confirm_delete|e('js') }}');"><input type="hidden" name="scheduler_action" value="delete_queue_one"><input type="hidden" name="queue_id" value="{{ job.queue_id }}"><button type="submit" class="btn btn-danger btn-sm" title="{{ button_queue_delete }}"><i class="fa fa-trash-o"></i></button></form>{% endif %}
              </td>
            </tr>
            {% endfor %}
          {% else %}<tr><td colspan="9" class="text-center">{{ text_queue_empty }}</td></tr>{% endif %}
          </tbody>
        </table>
      </div>
      <div class="panel-footer clearfix"><div class="pull-left">{{ queue_results }}</div><div class="pull-right">{{ queue_pagination }}</div></div>
    </div>
    </div>
    </div>

  </div>
</div>
