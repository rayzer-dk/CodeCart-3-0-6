{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right"><a href="#scheduler-form" class="btn btn-primary" data-toggle="tooltip" title="{{ button_add }}"><i class="fa fa-plus"></i></a></div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">{% for breadcrumb in breadcrumbs %}<li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>{% endfor %}</ul>
    </div>
  </div>
  <div class="container-fluid">
    {% if warning %}<div class="alert alert-danger alert-dismissible"><button type="button" class="close" data-dismiss="alert" aria-label="Close" title="Close">&times;</button><i class="fa fa-exclamation-circle"></i> {{ warning }}</div>{% endif %}
    {% if success %}<div class="alert alert-success alert-dismissible"><button type="button" class="close" data-dismiss="alert" aria-label="Close" title="Close">&times;</button><i class="fa fa-check-circle"></i> {{ success }}</div>{% endif %}

    <div class="panel panel-default">
      <div class="panel-heading"><h3 class="panel-title"><i class="fa fa-clock-o"></i> {{ heading_title }}</h3></div>
      <div class="panel-body">
        <p class="help-block">{{ help_cron }}</p>
        <div class="form-group"><label>{{ text_cli }}</label><div class="input-group"><input id="cron-cli" class="form-control" readonly value="{{ cli_command }}"><span class="input-group-btn"><button class="btn btn-default js-copy" type="button" data-target="cron-cli" title="{{ button_copy }}"><i class="fa fa-copy"></i></button></span></div></div>
        <div class="form-group"><label>{{ text_web_cron }}</label><div class="input-group"><input id="cron-http" class="form-control" readonly value="{{ http_command }}"><span class="input-group-btn"><button class="btn btn-default js-copy" type="button" data-target="cron-http" title="{{ button_copy }}"><i class="fa fa-copy"></i></button></span></div></div>
      </div>
    </div>

    <div class="panel panel-default">
      <div class="panel-heading"><h3 class="panel-title"><i class="fa fa-list"></i> {{ text_jobs }}</h3></div>
      <div class="table-responsive">
        <table class="table table-bordered table-hover codecart-scheduler-table">
          <thead><tr><th>{{ column_code }}</th><th>{{ column_route }}</th><th>{{ column_interval }}</th><th>{{ column_status }}</th><th>{{ column_last }}</th><th>{{ column_next }}</th><th>{{ column_result }}</th><th class="text-right">{{ column_action }}</th></tr></thead>
          <tbody>
          {% if jobs %}
            {% for job in jobs %}
            <tr>
              <td><strong>{{ job.code }}</strong>{% if job.is_core %} <span class="label label-info">{{ text_core_task }}</span>{% endif %}</td>
              <td><code>{{ job.route }}</code></td>
              <td title="{{ job.interval_seconds }} s">{{ job.interval_text }}</td>
              <td>{% if job.status %}<span class="label label-success">{{ text_enabled }}</span>{% else %}<span class="label label-default">{{ text_disabled }}</span>{% endif %}</td>
              <td>{{ job.date_last ?: '—' }}</td>
              <td>{{ job.date_next ?: '—' }}</td>
              <td>{% if job.last_status %}<span class="label label-{{ job.last_status == 'success' ? 'success' : 'danger' }}" title="{{ job.last_message }}">{{ job.last_status }}</span>{% if job.last_duration_ms is not null %} <small>{{ job.last_duration_ms }} ms</small>{% endif %}{% else %}—{% endif %}</td>
              <td class="text-right" style="white-space:nowrap;">
                {% if can_modify %}
                <form action="{{ action }}" method="post" style="display:inline-block;"><input type="hidden" name="scheduler_action" value="run"><input type="hidden" name="scheduler_id" value="{{ job.scheduler_id }}"><button type="submit" class="btn btn-info" data-toggle="tooltip" title="{{ button_run }}"><i class="fa fa-play"></i></button></form>
                <a href="{{ action }}&edit_id={{ job.scheduler_id }}#scheduler-form" class="btn btn-primary" data-toggle="tooltip" title="{{ button_edit }}"><i class="fa fa-pencil"></i></a>
                <form action="{{ action }}" method="post" style="display:inline-block;"><input type="hidden" name="scheduler_action" value="toggle"><input type="hidden" name="scheduler_id" value="{{ job.scheduler_id }}"><input type="hidden" name="status" value="{{ job.status ? 0 : 1 }}"><button type="submit" class="btn btn-{{ job.status ? 'warning' : 'success' }}" data-toggle="tooltip" title="{{ job.status ? button_disable : button_enable }}"><i class="fa fa-{{ job.status ? 'pause' : 'play-circle' }}"></i></button></form>
                {% if not job.is_core %}<form action="{{ action }}" method="post" style="display:inline-block;" onsubmit="return confirm('{{ text_confirm|e('js') }}');"><input type="hidden" name="scheduler_action" value="delete"><input type="hidden" name="scheduler_id" value="{{ job.scheduler_id }}"><button type="submit" class="btn btn-danger" data-toggle="tooltip" title="{{ button_delete }}"><i class="fa fa-trash-o"></i></button></form>{% endif %}
                {% endif %}
              </td>
            </tr>
            {% endfor %}
          {% else %}<tr><td colspan="8" class="text-center">{{ text_no_results }}</td></tr>{% endif %}
          </tbody>
        </table>
      </div>
      <div class="panel-footer">{{ text_queue }}: {{ text_queue_pending }} {{ queue_stats.pending|default(0) }}, {{ text_queue_processing }} {{ queue_stats.processing|default(0) }}, {{ text_queue_failed }} {{ queue_stats.failed|default(0) }}, {{ text_queue_done }} {{ queue_stats.done|default(0) }}</div>
    </div>

    <div class="panel panel-default codecart-queue-panel">
      <div class="panel-heading clearfix">
        <h3 class="panel-title pull-left"><i class="fa fa-tasks"></i> {{ text_queue_jobs }}</h3>
        {% if can_modify %}
        <form action="{{ action }}" method="post" class="pull-right">
          <input type="hidden" name="scheduler_action" value="run_queue">
          <button type="submit" class="btn btn-primary btn-sm" title="{{ button_run_queue }}"><i class="fa fa-play"></i> {{ button_run_queue }}</button>
        </form>
        {% endif %}
      </div>
      <div class="panel-body">
        <p class="help-block">{{ text_queue_worker_help }}</p>
        <form action="{{ action }}" method="get" class="row codecart-queue-filters">
          <input type="hidden" name="route" value="tool/scheduler">
          <input type="hidden" name="user_token" value="{{ user_token }}">
          <div class="col-sm-5"><label for="input-queue-search">{{ entry_queue_search }}</label><input type="text" name="queue_search" value="{{ queue_filter_search }}" id="input-queue-search" class="form-control"></div>
          <div class="col-sm-3"><label for="input-queue-status">{{ entry_queue_status }}</label><select name="queue_status" id="input-queue-status" class="form-control"><option value="">{{ text_all }}</option><option value="pending" {{ queue_filter_status == 'pending' ? 'selected' : '' }}>{{ text_queue_pending }}</option><option value="processing" {{ queue_filter_status == 'processing' ? 'selected' : '' }}>{{ text_queue_processing }}</option><option value="failed" {{ queue_filter_status == 'failed' ? 'selected' : '' }}>{{ text_queue_failed }}</option><option value="done" {{ queue_filter_status == 'done' ? 'selected' : '' }}>{{ text_queue_done }}</option></select></div>
          <div class="col-sm-2"><label for="input-queue-limit">{{ entry_queue_limit }}</label><select name="queue_limit" id="input-queue-limit" class="form-control">{% for item in [10,25,50,100] %}<option value="{{ item }}" {{ queue_limit == item ? 'selected' : '' }}>{{ item }}</option>{% endfor %}</select></div>
          <div class="col-sm-2 codecart-queue-filter-actions"><label>&nbsp;</label><div><button type="submit" class="btn btn-primary" title="{{ button_filter }}"><i class="fa fa-filter"></i></button> <a href="{{ queue_reset }}" class="btn btn-default" title="{{ button_reset }}"><i class="fa fa-refresh"></i></a></div></div>
        </form>
      </div>
      <div class="table-responsive">
        <table class="table table-bordered table-hover codecart-queue-table">
          <thead><tr><th><a href="{{ queue_sort_links.queue_id }}">{{ column_queue_id }}{% if queue_sort == 'queue_id' %} <i class="fa fa-caret-{{ queue_order == 'ASC' ? 'up' : 'down' }}"></i>{% endif %}</a></th><th><a href="{{ queue_sort_links.code }}">{{ column_code }}{% if queue_sort == 'code' %} <i class="fa fa-caret-{{ queue_order == 'ASC' ? 'up' : 'down' }}"></i>{% endif %}</a></th><th><a href="{{ queue_sort_links.route }}">{{ column_route }}{% if queue_sort == 'route' %} <i class="fa fa-caret-{{ queue_order == 'ASC' ? 'up' : 'down' }}"></i>{% endif %}</a></th><th><a href="{{ queue_sort_links.status }}">{{ column_status }}{% if queue_sort == 'status' %} <i class="fa fa-caret-{{ queue_order == 'ASC' ? 'up' : 'down' }}"></i>{% endif %}</a></th><th><a href="{{ queue_sort_links.attempts }}">{{ column_attempts }}{% if queue_sort == 'attempts' %} <i class="fa fa-caret-{{ queue_order == 'ASC' ? 'up' : 'down' }}"></i>{% endif %}</a></th><th><a href="{{ queue_sort_links.available_at }}">{{ column_available }}{% if queue_sort == 'available_at' %} <i class="fa fa-caret-{{ queue_order == 'ASC' ? 'up' : 'down' }}"></i>{% endif %}</a></th><th><a href="{{ queue_sort_links.date_modified }}">{{ column_modified }}{% if queue_sort == 'date_modified' %} <i class="fa fa-caret-{{ queue_order == 'ASC' ? 'up' : 'down' }}"></i>{% endif %}</a></th><th>{{ column_error }}</th><th class="text-right">{{ column_action }}</th></tr></thead>
          <tbody>
          {% if queue_jobs %}
            {% for job in queue_jobs %}
            <tr>
              <td>{{ job.queue_id }}</td>
              <td><strong class="ccp-ellipsis" title="{{ job.code }}">{{ job.code }}</strong></td>
              <td><code class="ccp-ellipsis" title="{{ job.route }}">{{ job.route }}</code></td>
              <td><span class="label label-{{ job.status == 'done' ? 'success' : (job.status == 'failed' ? 'danger' : (job.status == 'processing' ? 'info' : 'warning')) }}">{% if job.status == 'pending' %}{{ text_queue_pending }}{% elseif job.status == 'processing' %}{{ text_queue_processing }}{% elseif job.status == 'failed' %}{{ text_queue_failed }}{% else %}{{ text_queue_done }}{% endif %}</span></td>
              <td>{{ job.attempts }}/{{ job.max_attempts }}</td>
              <td>{{ job.available_at ?: '—' }}</td>
              <td>{{ job.date_modified ?: '—' }}</td>
              <td><span class="ccp-ellipsis" title="{{ job.last_error ?: '' }}">{{ job.last_error ?: '—' }}</span></td>
              <td class="text-right codecart-queue-actions">
                {% if can_modify and job.status in ['pending','failed'] %}<form action="{{ action }}" method="post" style="display:inline-block"><input type="hidden" name="scheduler_action" value="run_queue_one"><input type="hidden" name="queue_id" value="{{ job.queue_id }}"><input type="hidden" name="retry" value="{{ job.status == 'failed' ? 1 : 0 }}"><button type="submit" class="btn btn-primary btn-sm" title="{{ job.status == 'failed' ? button_queue_retry : button_queue_run }}"><i class="fa fa-{{ job.status == 'failed' ? 'repeat' : 'play' }}"></i></button></form>{% endif %}
                {% if can_modify and job.status != 'processing' %}<form action="{{ action }}" method="post" style="display:inline-block" onsubmit="return confirm('{{ text_queue_confirm_delete|e('js') }}');"><input type="hidden" name="scheduler_action" value="delete_queue_one"><input type="hidden" name="queue_id" value="{{ job.queue_id }}"><button type="submit" class="btn btn-danger btn-sm" title="{{ button_queue_delete }}"><i class="fa fa-trash-o"></i></button></form>{% endif %}
              </td>
            </tr>
            {% endfor %}
          {% else %}<tr><td colspan="9" class="text-center">{{ text_queue_empty }}</td></tr>{% endif %}
          </tbody>
        </table>
      </div>
      <div class="panel-footer clearfix"><div class="pull-left">{{ queue_results }}</div><div class="pull-right">{{ queue_pagination }}</div></div>
    </div>

    {% if can_modify %}
    <div class="panel panel-default" id="scheduler-form">
      <div class="panel-heading"><h3 class="panel-title"><i class="fa fa-{{ edit_task.scheduler_id ? 'pencil' : 'plus' }}"></i> {{ edit_task.scheduler_id ? text_edit_task : text_add_task }}</h3></div>
      <div class="panel-body">
        <form action="{{ action }}" method="post" class="form-horizontal">
          <input type="hidden" name="scheduler_action" value="save">
          <input type="hidden" name="scheduler_id" value="{{ edit_task.scheduler_id }}">
          <div class="form-group required"><label class="col-sm-2 control-label" for="input-scheduler-code">{{ entry_code }}</label><div class="col-sm-10"><input type="text" name="code" value="{{ edit_task.code }}" id="input-scheduler-code" class="form-control" required maxlength="128" {{ edit_task.is_core ? 'readonly' : '' }}></div></div>
          <div class="form-group required"><label class="col-sm-2 control-label" for="input-scheduler-route"><span data-toggle="tooltip" title="{{ text_route_help }}">{{ entry_route }}</span></label><div class="col-sm-10"><input type="text" name="route" value="{{ edit_task.route }}" id="input-scheduler-route" class="form-control" required></div></div>
          <div class="form-group required"><label class="col-sm-2 control-label" for="input-scheduler-interval"><span data-toggle="tooltip" title="{{ text_interval_help }}">{{ entry_interval }}</span></label><div class="col-sm-10"><input type="number" min="60" max="31536000" step="1" name="interval_seconds" value="{{ edit_task.interval_seconds }}" id="input-scheduler-interval" class="form-control" required></div></div>
          <div class="form-group"><label class="col-sm-2 control-label" for="input-scheduler-args"><span data-toggle="tooltip" title="{{ text_args_help }}">{{ entry_args }}</span></label><div class="col-sm-10"><textarea name="args" rows="4" id="input-scheduler-args" class="form-control">{{ edit_task.args }}</textarea></div></div>
          <div class="form-group"><label class="col-sm-2 control-label" for="input-scheduler-status">{{ entry_status }}</label><div class="col-sm-10"><select name="status" id="input-scheduler-status" class="form-control"><option value="1" {{ edit_task.status ? 'selected' : '' }}>{{ text_enabled }}</option><option value="0" {{ not edit_task.status ? 'selected' : '' }}>{{ text_disabled }}</option></select></div></div>
          <div class="text-right"><a href="{{ cancel }}" class="btn btn-default"><i class="fa fa-reply"></i> {{ button_cancel }}</a> <button type="submit" class="btn btn-primary"><i class="fa fa-save"></i> {{ button_save }}</button></div>
        </form>
      </div>
    </div>
    {% endif %}
  </div>
</div>
<style>
.codecart-scheduler-table thead,.codecart-queue-table thead{border-top:3px solid #0057d9}.codecart-scheduler-table thead th,.codecart-queue-table thead th{border-right:1px solid #dce4ed;vertical-align:middle}.codecart-queue-filters{margin-bottom:0}.codecart-queue-filter-actions>label{display:block}.codecart-queue-table{table-layout:fixed;margin-bottom:0}.codecart-queue-table th:nth-child(1){width:65px}.codecart-queue-table th:nth-child(4){width:95px}.codecart-queue-table th:nth-child(5){width:80px}.codecart-queue-table th:nth-child(6),.codecart-queue-table th:nth-child(7){width:155px}.codecart-queue-table th:nth-child(9){width:105px}.codecart-queue-table thead a{color:inherit;white-space:nowrap}.codecart-queue-actions form+form{margin-left:4px}.ccp-ellipsis{display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.codecart-queue-panel .panel-footer .pagination{margin:0}.codecart-queue-panel .panel-footer{min-height:54px;display:flex;align-items:center;justify-content:space-between;gap:12px}.codecart-queue-panel .panel-footer>.pull-left,.codecart-queue-panel .panel-footer>.pull-right{float:none!important}
@media(max-width:767px){.codecart-queue-filters>[class*="col-"]{margin-bottom:8px}.codecart-queue-panel .panel-footer{align-items:flex-start;flex-direction:column}.codecart-queue-table{min-width:980px}}
</style>
<script>
$('.js-copy').on('click',function(){var el=document.getElementById($(this).data('target'));el.select();el.setSelectionRange(0,99999);if(navigator.clipboard){navigator.clipboard.writeText(el.value);}else{document.execCommand('copy');}});
</script>
{{ footer }}
