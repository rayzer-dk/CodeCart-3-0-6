<!DOCTYPE html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>{{ title }}</title></head>
<body style="margin:0;padding:24px 12px;background:#f4f6f8;font-family:Arial,Helvetica,sans-serif;font-size:14px;line-height:1.6;color:#1f2937;"><div style="width:100%;max-width:640px;margin:0 auto;background:#fff;border:1px solid #e5e7eb;border-radius:10px;padding:28px;box-sizing:border-box;"><div style="font-size:20px;font-weight:700;margin-bottom:20px;">{{ store }}</div><table role="presentation" style="border-collapse:collapse;width:100%;margin-bottom:20px;border:1px solid #e5e7eb;"><tr><td style="padding:10px 12px;background:#f7fafc;font-weight:700;width:42%;">{{ text_return_id }}</td><td style="padding:10px 12px;">{{ return_id }}</td></tr><tr><td style="padding:10px 12px;background:#f7fafc;font-weight:700;border-top:1px solid #e5e7eb;">{{ text_date_added }}</td><td style="padding:10px 12px;border-top:1px solid #e5e7eb;">{{ date_added }}</td></tr></table><p style="margin:0 0 10px;">{{ text_return_status }}</p><div style="display:inline-block;margin:0 0 20px;background:#eaf4fb;color:#0f5f94;border-radius:999px;padding:7px 12px;font-weight:700;">{{ return_status }}</div>{% if comment %}<p style="margin:0 0 8px;font-weight:700;">{{ text_comment }}</p><div style="margin:0 0 20px;padding:14px 16px;background:#f7fafc;border-left:3px solid #0b6fd3;">{{ comment }}</div>{% endif %}<p style="margin:0 0 18px;color:#4b5563;">{{ text_footer }}</p><p style="margin:0;"><a href="{{ store_url }}" style="color:#0b6fd3;text-decoration:none;">{{ store }}</a></p></div></body></html>
