<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ title }}</title>
</head>
<body style="margin:0;padding:24px 12px;background:#f4f6f8;font-family:Arial,Helvetica,sans-serif;font-size:14px;line-height:1.6;color:#1f2937;">
<div style="width:100%;max-width:640px;margin:0 auto;background:#ffffff;border:1px solid #e5e7eb;border-radius:10px;padding:28px;box-sizing:border-box;">
  <div style="font-size:20px;font-weight:700;color:#111827;margin-bottom:20px;">{{ store }}</div>
  <p style="margin:0 0 18px;">{{ text_welcome }}</p>
  <p style="margin:0 0 18px;">{{ text_login }}</p>
  <p style="margin:0 0 22px;"><a href="{{ login }}" style="display:inline-block;background:#0b6fd3;color:#ffffff;text-decoration:none;font-weight:700;padding:11px 18px;border-radius:6px;">{{ login }}</a></p>
  <p style="margin:0 0 18px;color:#4b5563;">{{ text_service }}</p>
  <p style="margin:24px 0 0;">{{ text_thanks }}<br><a href="{{ store_url }}" style="color:#0b6fd3;text-decoration:none;">{{ store }}</a></p>
</div>
</body>
</html>
