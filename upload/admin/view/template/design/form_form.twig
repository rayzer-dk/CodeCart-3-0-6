{{ header }}{{ column_left }}
<div id="content" class="ccp-form-admin">
  <div class="page-header"><div class="container-fluid"><div class="pull-right"><button type="submit" form="form-builder" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa fa-save"></i></button> <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default"><i class="fa fa-reply"></i></a></div><h1>{{ heading_title }}</h1><ul class="breadcrumb">{% for breadcrumb in breadcrumbs %}<li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>{% endfor %}</ul></div></div>
  <div class="container-fluid">
    {% if success %}<div class="alert alert-success alert-dismissible"><i class="fa fa-check-circle"></i> {{ success }}<button type="button" class="close" data-dismiss="alert">&times;</button></div>{% endif %}
    {% if error_warning %}<div class="alert alert-danger"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}<button type="button" class="close" data-dismiss="alert">&times;</button></div>{% endif %}
    <div class="panel panel-default"><div class="panel-heading"><h3 class="panel-title"><i class="fa fa-wpforms"></i> {{ text_form }}</h3></div><div class="panel-body">
      <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-builder" class="form-horizontal ccp-reusable-form-builder"
        data-label="{{ entry_field_label|e('html_attr') }}" data-placeholder="{{ entry_field_placeholder|e('html_attr') }}" data-key="{{ entry_field_key|e('html_attr') }}" data-required="{{ entry_field_required|e('html_attr') }}" data-options="{{ entry_field_options|e('html_attr') }}" data-remove="{{ button_remove|e('html_attr') }}" data-up="{{ text_move_up|e('html_attr') }}" data-down="{{ text_move_down|e('html_attr') }}" data-empty="{{ text_fields_empty|e('html_attr') }}">
        <div class="form-group required"><label class="col-sm-2 control-label" for="input-name">{{ entry_name }}</label><div class="col-sm-10"><input type="text" name="name" value="{{ name|e('html_attr') }}" id="input-name" class="form-control" />{% if error_name %}<div class="text-danger">{{ error_name }}</div>{% endif %}<p class="help-block">{{ help_name }}</p></div></div>
        <div class="form-group"><label class="col-sm-2 control-label" for="input-kind">{{ entry_kind }}</label><div class="col-sm-10"><select name="kind" id="input-kind" class="form-control"><option value="request"{% if kind != 'info' %} selected="selected"{% endif %}>{{ text_kind_request }}</option><option value="info"{% if kind == 'info' %} selected="selected"{% endif %}>{{ text_kind_info }}</option></select><p class="help-block">{{ help_kind }}</p></div></div>
        <div class="form-group ccp-request-only"><label class="col-sm-2 control-label" for="input-recipient">{{ entry_recipient }}</label><div class="col-sm-10"><input type="email" name="recipient" value="{{ recipient|e('html_attr') }}" id="input-recipient" class="form-control" placeholder="store@example.com" /><p class="help-block">{{ help_recipient }}</p></div></div>
        <div class="form-group"><label class="col-sm-2 control-label" for="input-status">{{ entry_status }}</label><div class="col-sm-10"><select name="status" id="input-status" class="form-control"><option value="1"{% if status %} selected="selected"{% endif %}>{{ text_enabled }}</option><option value="0"{% if not status %} selected="selected"{% endif %}>{{ text_disabled }}</option></select><p class="help-block">{{ help_status_global }}</p></div></div>
        <div class="form-group ccp-button-style-group"><label class="col-sm-2 control-label">{{ entry_button_colors }}</label><div class="col-sm-10"><div class="ccp-button-style-row">
          <div class="ccp-style-item ccp-style-item-icon"><label>{{ entry_button_icon }}</label><input type="hidden" name="button_icon" value="{{ button_icon }}" id="input-button-icon" /><div class="ccp-icon-picker-field"><button type="button" class="btn btn-default ccp-icon-preview-btn" id="button-icon-picker" data-icons-url="{{ icons_url|e('html_attr') }}" data-catalog-url="view/javascript/codecart-icon-catalog.js?v=3.0.6.0-1.9.12" title="{{ button_choose_icon }}"><span class="ccp-icon-preview"><i class="{{ button_icon|e('html_attr') }}"></i></span></button><button type="button" class="btn btn-default ccp-icon-clear-btn" id="button-icon-clear" title="{{ button_clear_icon }}"><i class="fa fa-times"></i></button></div></div>
          <div class="ccp-style-item"><label>{{ entry_button_bg }}</label><input type="color" name="button_bg" value="{{ button_bg }}" class="form-control ccp-color-input" /></div>
          <div class="ccp-style-item"><label>{{ entry_button_text_color }}</label><input type="color" name="button_text_color" value="{{ button_text_color }}" class="form-control ccp-color-input" /></div>
          <div class="ccp-style-item"><label>{{ entry_button_hover_bg }}</label><input type="color" name="button_hover_bg" value="{{ button_hover_bg }}" class="form-control ccp-color-input" /></div>
        </div><p class="help-block ccp-button-style-help">{{ help_button_style }}</p></div></div>
        {% if form_id %}<div class="form-group"><label class="col-sm-2 control-label">{{ entry_shortcode }}</label><div class="col-sm-10"><div class="ccp-shortcode-box"><code>{{ shortcode }}</code><code>{{ button_shortcode }}</code></div><p class="help-block">{{ help_shortcode }}</p></div></div>{% endif %}
        <div class="ccp-form-presets" data-confirm="{{ text_template_confirm|e('html_attr') }}">
          <div class="ccp-form-presets__head"><strong>{{ text_templates }}</strong><span class="help-block">{{ text_template_help }}</span></div>
          <div class="ccp-form-presets__buttons">
            <button type="button" class="btn btn-default btn-sm" data-form-preset="callback">{{ text_template_callback }}</button>
            <button type="button" class="btn btn-default btn-sm" data-form-preset="question">{{ text_template_question }}</button>
            <button type="button" class="btn btn-default btn-sm" data-form-preset="price">{{ text_template_price }}</button>
            <button type="button" class="btn btn-default btn-sm" data-form-preset="selection">{{ text_template_selection }}</button>
            <button type="button" class="btn btn-default btn-sm" data-form-preset="part">{{ text_template_part }}</button>
            <button type="button" class="btn btn-default btn-sm" data-form-preset="restock">{{ text_template_restock }}</button>
            <button type="button" class="btn btn-default btn-sm" data-form-preset="quote">{{ text_template_quote }}</button>
            <button type="button" class="btn btn-default btn-sm" data-form-preset="size">{{ text_template_size }}</button>
            <button type="button" class="btn btn-info btn-sm" data-form-preset="delivery_info">{{ text_template_delivery_info }}</button>
            <button type="button" class="btn btn-info btn-sm" data-form-preset="instruction_info">{{ text_template_instruction_info }}</button>
            <button type="button" class="btn btn-info btn-sm" data-form-preset="rules_info">{{ text_template_rules_info }}</button>
            <button type="button" class="btn btn-info btn-sm" data-form-preset="shoes_eu">{{ text_template_shoes_eu }}</button>
            <button type="button" class="btn btn-info btn-sm" data-form-preset="clothing_women_eu">{{ text_template_clothing_women_eu }}</button>
            <button type="button" class="btn btn-info btn-sm" data-form-preset="clothing_men_eu">{{ text_template_clothing_men_eu }}</button>
          </div>
        </div>
        <ul class="nav nav-tabs">{% for language in languages %}<li{% if loop.first %} class="active"{% endif %}><a href="#language{{ language.language_id }}" data-toggle="tab"><img src="language/{{ language.code }}/{{ language.code }}.png" title="{{ language.name }}" /> {{ language.name }}</a></li>{% endfor %}</ul>
        <div class="tab-content">{% for language in languages %}{% set fd = form_description[language.language_id] %}<div class="tab-pane{% if loop.first %} active{% endif %}" id="language{{ language.language_id }}" data-language-code="{{ language.code }}">
          <div class="form-group"><label class="col-sm-2 control-label">{{ entry_title }}</label><div class="col-sm-10"><input type="text" name="form_description[{{ language.language_id }}][title]" value="{{ fd.title|e('html_attr') }}" class="form-control" /></div></div>
          <div class="form-group"><label class="col-sm-2 control-label">{{ entry_description }}</label><div class="col-sm-10"><textarea name="form_description[{{ language.language_id }}][description]" rows="3" class="form-control">{{ fd.description|e }}</textarea></div></div>
          <div class="form-group ccp-request-only"><label class="col-sm-2 control-label">{{ entry_submit_text }}</label><div class="col-sm-10"><input type="text" name="form_description[{{ language.language_id }}][submit_text]" value="{{ fd.submit_text|e('html_attr') }}" class="form-control" /></div></div>
          <div class="form-group ccp-request-only"><label class="col-sm-2 control-label">{{ entry_success_text }}</label><div class="col-sm-10"><input type="text" name="form_description[{{ language.language_id }}][success_text]" value="{{ fd.success_text|e('html_attr') }}" class="form-control" /></div></div>
          <div class="ccp-form-fields-pane ccp-request-only">
            <textarea class="ccp-form-fields-json hidden" name="form_description[{{ language.language_id }}][fields_json]">{{ fd.fields_json|e }}</textarea>
            <div class="ccp-form-fields-toolbar"><strong>{{ text_fields }}</strong><div class="btn-group ccp-form-field-add"><button type="button" class="btn btn-primary btn-sm" data-add-field="text"><i class="fa fa-font"></i> {{ text_field_text }}</button><button type="button" class="btn btn-primary btn-sm" data-add-field="email"><i class="fa fa-envelope"></i> Email</button><button type="button" class="btn btn-primary btn-sm" data-add-field="tel"><i class="fa fa-phone"></i> {{ text_field_tel }}</button><button type="button" class="btn btn-primary btn-sm" data-add-field="textarea"><i class="fa fa-align-left"></i> {{ text_field_textarea }}</button><button type="button" class="btn btn-primary btn-sm" data-add-field="select"><i class="fa fa-list"></i> {{ text_field_select }}</button><button type="button" class="btn btn-primary btn-sm" data-add-field="checkbox"><i class="fa fa-check-square-o"></i> {{ text_field_checkbox }}</button></div></div>
            <div class="ccp-form-fields-list"></div>
          </div>
        </div>{% endfor %}</div>
      </form>
    </div></div>
  </div>
</div>
<script>window.CodeCartFormBuilderUkPresets={{ js_presets_json|raw }};</script>

<div class="modal fade" id="ccp-icon-picker-modal" tabindex="-1" role="dialog" aria-hidden="true"><div class="modal-dialog modal-lg" role="document"><div class="modal-content"><div class="modal-header"><button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button><h4 class="modal-title"><i class="fa fa-th"></i> {{ text_icon_picker_title }}</h4></div><div class="modal-body"><div class="form-group"><div class="input-group"><span class="input-group-addon"><i class="fa fa-search"></i></span><input type="text" class="form-control" id="ccp-icon-search" placeholder="{{ text_icon_search }}" /></div></div><div id="ccp-icon-picker-grid" class="ccp-icon-picker-grid"><div class="text-muted text-center">{{ text_icon_loading }}</div></div></div><div class="modal-footer"><button type="button" class="btn btn-default" data-dismiss="modal">{{ button_cancel }}</button></div></div></div></div>
{{ footer }}
