{{ header }}{{ column_left }}
<div id="content" class="ccp-form-admin">
  <div class="page-header"><div class="container-fluid">
    <div class="pull-right"><a href="{{ add }}" data-toggle="tooltip" title="{{ button_add }}" class="btn btn-primary"><i class="fa fa-plus"></i></a> <button type="button" data-toggle="tooltip" title="{{ button_delete }}" class="btn btn-danger" onclick="confirm('{{ text_confirm }}') ? $('#form-form-list').submit() : false;"><i class="fa fa-trash-o"></i></button></div>
    <h1>{{ heading_title }}</h1>
    <ul class="breadcrumb">{% for breadcrumb in breadcrumbs %}<li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>{% endfor %}</ul>
  </div></div>
  <div class="container-fluid">
    {% if error_warning %}<div class="alert alert-danger"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}<button type="button" class="close" data-dismiss="alert">&times;</button></div>{% endif %}
    {% if success %}<div class="alert alert-success"><i class="fa fa-check-circle"></i> {{ success }}<button type="button" class="close" data-dismiss="alert">&times;</button></div>{% endif %}
    <div class="alert alert-info ccp-form-usage"><strong><i class="fa fa-map-signs"></i> {{ text_form_usage_title }}</strong><div class="ccp-form-usage-grid"><span>{{ text_form_usage_product }}</span><span>{{ text_form_usage_category_products }}</span><span>{{ text_form_usage_category_page }}</span><span>{{ text_form_usage_global }}</span><span>{{ text_form_usage_shortcode }}</span></div></div>
    <div class="panel panel-default"><div class="panel-heading"><h3 class="panel-title"><i class="fa fa-wpforms"></i> {{ text_list }}</h3></div>
      <div class="panel-body"><form action="{{ delete }}" method="post" enctype="multipart/form-data" id="form-form-list">
        <div class="table-responsive"><table class="table table-bordered table-hover ccp-form-table">
          <thead><tr><td style="width:1px" class="text-center"><input type="checkbox" onclick="$('input[name*=\'selected\']').prop('checked', this.checked);" /></td><td class="text-left"><a href="{{ sort_name }}">{{ column_name }}</a></td><td class="text-left">{{ column_kind }}</td><td class="text-left"><a href="{{ sort_title }}">{{ column_title }}</a></td><td class="text-left">{{ column_shortcode }}</td><td class="text-left"><a href="{{ sort_status }}">{{ column_status }}</a></td><td class="text-right">{{ column_action }}</td></tr></thead>
          <tbody>{% if forms %}{% for form in forms %}<tr><td class="text-center"><input type="checkbox" name="selected[]" value="{{ form.form_id }}"{% if form.form_id in selected %} checked="checked"{% endif %} /></td><td>{{ form.name|e }}</td><td>{% if form.kind == 'info' %}<span class="label label-info">{{ text_kind_info_short }}</span>{% else %}<span class="label label-primary">{{ text_kind_request_short }}</span>{% endif %}</td><td>{{ form.title|e }}</td><td><div class="ccp-shortcode-row"><code>{{ form.shortcode }}</code><button type="button" class="btn btn-default btn-xs" data-copy="{{ form.shortcode|e('html_attr') }}" title="{{ text_copy }}"><i class="fa fa-copy"></i></button></div><div class="ccp-shortcode-row"><code>{{ form.button_shortcode }}</code><button type="button" class="btn btn-default btn-xs" data-copy="{{ form.button_shortcode|e('html_attr') }}" title="{{ text_copy }}"><i class="fa fa-copy"></i></button></div></td><td>{% if form.status %}<span class="label label-success">{{ text_enabled }}</span>{% else %}<span class="label label-default">{{ text_disabled }}</span>{% endif %}</td><td class="text-right"><a href="{{ form.edit }}" data-toggle="tooltip" title="{{ button_edit }}" class="btn btn-primary"><i class="fa fa-pencil"></i></a></td></tr>{% endfor %}{% else %}<tr><td class="text-center" colspan="7">{{ text_no_results }}</td></tr>{% endif %}</tbody>
        </table></div>
      </form><div class="row"><div class="col-sm-6 text-left">{{ pagination }}</div><div class="col-sm-6 text-right">{{ results }}</div></div></div>
    </div>
  </div>
</div>
<script>$(document).on('click','[data-copy]',function(){var t=$(this).attr('data-copy'); if(navigator.clipboard){navigator.clipboard.writeText(t);} else {var x=$('<textarea>').val(t).appendTo('body').select();document.execCommand('copy');x.remove();}});</script>
{{ footer }}
