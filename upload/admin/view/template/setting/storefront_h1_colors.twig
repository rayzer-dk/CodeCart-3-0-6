{% set h1_color_fields = {
  light: {label: entry_h1_color, help: help_h1_color, fallback: h1_accent_color},
  dark: {label: entry_h1_dark_color, help: help_h1_dark_color, fallback: storefront_h1_dark_default}
} %}
{% for mode, field in h1_color_fields %}
  {% set input_id = 'input-h1-' ~ mode ~ '-color' %}
  {% set color = storefront_h1_colors[mode] %}
  <div class="form-group">
    <label class="col-sm-2 control-label" for="{{ input_id }}">{{ field.label }}</label>
    <div class="col-sm-10">
      <div class="input-group ccp-color-control">
        <span class="input-group-addon"><input type="color" id="{{ input_id }}-picker" class="ccp-color-picker" data-target="#{{ input_id }}" value="{{ color ?: field.fallback }}" aria-label="{{ field.label }}" /></span>
        <input type="text" name="{{ h1_settings_prefix }}h1_{{ mode }}_color" value="{{ color }}" id="{{ input_id }}" class="form-control ccp-color-hex" data-picker="#{{ input_id }}-picker" data-default-color="{{ field.fallback }}" placeholder="{{ field.fallback }}" aria-describedby="{{ input_id }}-help" maxlength="7" pattern="#[0-9A-Fa-f]{6}" spellcheck="false" autocomplete="off" />
      </div>
      <p class="help-block" id="{{ input_id }}-help">{{ field.help }}</p>
    </div>
  </div>
{% endfor %}
