{{ header }}{{ column_left }}
<div id="content" class="ccp-main-ui-order-list">
<style>
#ccp-order-list .ccp-order-id { white-space: nowrap; }
#ccp-order-list .ccp-order-unit-count {
  display: inline-flex; align-items: center; gap: 3px;
  margin-left: 7px; padding: 2px 6px;
  border-radius: 12px; background: #e9f2ff; color: #145d9b;
  border: 1px solid #c4defa; font-size: 12px; font-weight: 600;
  white-space: nowrap; vertical-align: middle; font-variant-numeric: tabular-nums;
}
#ccp-order-list .ccp-order-unit-count small { font-size: 10px; font-weight: 400; }
#ccp-order-list .ccp-order-unit-count.is-empty { background: #f1f3f5; color: #7d8792; border-color: #e1e4e8; }
@media (max-width: 767px) { #ccp-order-list .ccp-order-unit-count { margin-left: 4px; padding: 2px 5px; } }
/* Compact full-width order filters, matching the catalog list. */
#filter-order .panel-body { display:flex; flex-wrap:wrap; align-items:flex-end; gap:8px 12px; padding:10px 12px; }
#filter-order .panel-body > .form-group { flex:1 1 155px; min-width:140px; max-width:240px; margin:0; }
#filter-order .panel-body > .form-group.text-right { flex:0 0 auto; min-width:96px; }
#filter-order .panel-body .control-label { display:block; margin-bottom:3px; font-size:12px; }
#filter-order .panel-body .form-control { height:34px; padding:5px 9px; }
#filter-order .panel-body .help-block { font-size:11px; margin:3px 0 0; }
#filter-order .panel-body .input-group .btn { height:34px; }
@media(max-width:767px){#filter-order .panel-body > .form-group{flex:1 1 100%;max-width:none}}
</style>
<div class="page-header">
  <div class="container-fluid">
    <div class="pull-right">
      <button type="button" data-toggle="tooltip" title="{{ button_filter }}" onclick="$('#filter-order .panel-body').slideToggle(150);" class="btn btn-default hidden-md hidden-lg"><i class="fa fa-filter"></i></button>
      <button type="submit" id="button-shipping" form="form-order" formaction="{{ shipping }}" formtarget="_blank" data-toggle="tooltip" title="{{ button_shipping_print }}" class="btn btn-info"><i class="fa fa-truck"></i></button>
      <button type="submit" id="button-invoice" form="form-order" formaction="{{ invoice }}" formtarget="_blank" data-toggle="tooltip" title="{{ button_invoice_print }}" class="btn btn-info"><i class="fa fa-print"></i></button>
      <button type="button" id="button-export-orders" data-toggle="tooltip" title="{{ button_export_orders }}" class="btn btn-success"><i class="fa fa-download"></i></button>
      <a href="{{ add }}" data-toggle="tooltip" title="{{ button_add }}" class="btn btn-primary"><i class="fa fa-plus"></i></a> </div>
    <h1>{{ heading_title }}</h1>
    <ul class="breadcrumb">
      {% for breadcrumb in breadcrumbs %}
      <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
      {% endfor %}
    </ul>
  </div>
</div>
<div class="container-fluid">{% if error_warning %}
  <div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}
    <button type="button" class="close" data-dismiss="alert">&times;</button>
  </div>
  {% endif %}
  {% if success %}
  <div class="alert alert-success alert-dismissible"><i class="fa fa-check-circle"></i> {{ success }}
    <button type="button" class="close" data-dismiss="alert">&times;</button>
  </div>
  {% endif %}
  <div class="row">
    <div id="filter-order" class="col-md-12 col-sm-12">
      <div class="panel panel-default">
        <div class="panel-heading">
          <h3 class="panel-title"><i class="fa fa-filter"></i> {{ text_filter }}</h3>
        </div>
        <div class="panel-body">
          <div class="form-group">
            <label class="control-label" for="input-order-id">{{ entry_order_id }}</label>
            <input type="text" name="filter_order_id" value="{{ filter_order_id }}" placeholder="{{ entry_order_id }}" id="input-order-id" class="form-control" />
          </div>
          <div class="form-group">
            <label class="control-label" for="input-customer">{{ entry_customer }}</label>
            <input type="text" name="filter_customer" value="{{ filter_customer }}" placeholder="{{ entry_customer }}" id="input-customer" class="form-control" />
          </div>
          <div class="form-group">
            <label class="control-label" for="input-filter-email">{{ entry_filter_email }}</label>
            <input type="email" name="filter_email" value="{{ filter_email }}" id="input-filter-email" class="form-control" autocomplete="off" />
          </div>
          <div class="form-group">
            <label class="control-label" for="input-filter-phone">{{ entry_filter_phone }}</label>
            <input type="tel" name="filter_phone" value="{{ filter_phone }}" id="input-filter-phone" class="form-control" inputmode="numeric" autocomplete="off" />
            <small class="help-block">{{ help_order_phone }}</small>
          </div>
          <div class="form-group">
            <label class="control-label" for="input-filter-product">{{ entry_order_product_search }}</label>
            <input type="text" name="filter_product" value="{{ filter_product }}" id="input-filter-product" class="form-control" />
          </div>
          <div class="form-group">
            <label class="control-label" for="input-filter-shipping">{{ entry_shipping_method }}</label>
            <select name="filter_shipping_method" id="input-filter-shipping" class="form-control">
              <option value=""></option>
              {% for method in shipping_methods %}
              <option value="{{ method }}"{% if method == filter_shipping_method %} selected="selected"{% endif %}>{{ method }}</option>
              {% endfor %}
            </select>
          </div>
          <div class="form-group">
            <label class="control-label" for="input-filter-payment">{{ entry_payment_method }}</label>
            <select name="filter_payment_method" id="input-filter-payment" class="form-control">
              <option value=""></option>
              {% for method in payment_methods %}
              <option value="{{ method }}"{% if method == filter_payment_method %} selected="selected"{% endif %}>{{ method }}</option>
              {% endfor %}
            </select>
          </div>
          <div class="form-group">
            <label class="control-label" for="input-order-status">{{ entry_order_status }}</label>
            <select name="filter_order_status_id" id="input-order-status" class="form-control">
              <option value=""></option>
              {% if filter_order_status_id == '0' %}
              <option value="0" selected="selected">{{ text_missing }}</option>
              {% else %}
              <option value="0">{{ text_missing }}</option>
              {% endif %}
              {% for order_status in order_statuses %}
              {% if order_status.order_status_id == filter_order_status_id %}
              <option value="{{ order_status.order_status_id }}" selected="selected">{{ order_status.name }}</option>
              {% else %}
              <option value="{{ order_status.order_status_id }}">{{ order_status.name }}</option>
              {% endif %}
              {% endfor %}            
            </select>
          </div>
          <div class="form-group">
            <label class="control-label">{{ entry_total }}</label>
            <div class="row">
              <div class="col-xs-6">
                <label class="sr-only" for="input-total-min">{{ entry_total_min }}</label>
                <input type="number" min="0" step="0.01" name="filter_total_min" value="{{ filter_total_min }}" placeholder="{{ entry_total_min }}" title="{{ entry_total_min }}" id="input-total-min" class="form-control" />
              </div>
              <div class="col-xs-6">
                <label class="sr-only" for="input-total-max">{{ entry_total_max }}</label>
                <input type="number" min="0" step="0.01" name="filter_total_max" value="{{ filter_total_max }}" placeholder="{{ entry_total_max }}" title="{{ entry_total_max }}" id="input-total-max" class="form-control" />
              </div>
            </div>
          </div>
          <div class="form-group">
            <label class="control-label" for="input-date-added">{{ entry_date_added }}</label>
            <div class="input-group date">
              <input type="text" name="filter_date_added" value="{{ filter_date_added }}" placeholder="{{ entry_date_added }}" data-date-format="YYYY-MM-DD" id="input-date-added" class="form-control" />
              <span class="input-group-btn">
              <button type="button" class="btn btn-default"><i class="fa fa-calendar"></i></button>
              </span> </div>
          </div>
          <div class="form-group">
            <label class="control-label" for="input-date-start">{{ entry_date_start }}</label>
            <div class="input-group date">
              <input type="text" name="filter_date_start" value="{{ filter_date_start }}" placeholder="{{ entry_date_start }}" data-date-format="YYYY-MM-DD" id="input-date-start" class="form-control" />
              <span class="input-group-btn"><button type="button" class="btn btn-default" title="{{ entry_date_start }}"><i class="fa fa-calendar"></i></button></span> </div>
          </div>
          <div class="form-group">
            <label class="control-label" for="input-date-end">{{ entry_date_end }}</label>
            <div class="input-group date">
              <input type="text" name="filter_date_end" value="{{ filter_date_end }}" placeholder="{{ entry_date_end }}" data-date-format="YYYY-MM-DD" id="input-date-end" class="form-control" />
              <span class="input-group-btn"><button type="button" class="btn btn-default" title="{{ entry_date_end }}"><i class="fa fa-calendar"></i></button></span> </div>
            <p class="help-block">{{ help_export_date }}</p>
          </div>
          <div class="form-group">
            <label class="control-label" for="input-date-modified">{{ entry_date_modified }}</label>
            <div class="input-group date">
              <input type="text" name="filter_date_modified" value="{{ filter_date_modified }}" placeholder="{{ entry_date_modified }}" data-date-format="YYYY-MM-DD" id="input-date-modified" class="form-control" />
              <span class="input-group-btn">
              <button type="button" class="btn btn-default"><i class="fa fa-calendar"></i></button>
              </span> </div>
          </div>
          <div class="form-group text-right">
            <button type="button" id="button-filter" class="btn btn-default"><i class="fa fa-filter"></i> {{ button_filter }}</button>
          </div>
        </div>
      </div>
    </div>
    <div class="col-md-12 col-sm-12">
      <div class="panel panel-default">
        <div class="panel-heading">
          <h3 class="panel-title"><i class="fa fa-list"></i> {{ text_list }}</h3>
        </div>
        <div class="panel-body">
          <form method="post" action="" enctype="multipart/form-data" id="form-order">
            <div class="table-responsive">
              <table class="table table-bordered table-hover ccp-order-list-table" id="ccp-order-list">
                <thead>
                  <tr>
                    <td style="width: 1px;" class="text-center"><input type="checkbox" onclick="$('input[name*=\'selected\']').prop('checked', this.checked).trigger('change');" /></td>
                    <td class="text-right">{% if sort == 'o.order_id' %} <a href="{{ sort_order }}" class="{{ order|lower }}">{{ column_order_id }}</a> {% else %} <a href="{{ sort_order }}">{{ column_order_id }}</a> {% endif %}</td>
                    <td class="text-left">{% if sort == 'customer' %} <a href="{{ sort_customer }}" class="{{ order|lower }}">{{ column_customer }}</a> {% else %} <a href="{{ sort_customer }}">{{ column_customer }}</a> {% endif %}</td>
                    <td class="text-left">{% if sort == 'order_status' %} <a href="{{ sort_status }}" class="{{ order|lower }}">{{ column_status }}</a> {% else %} <a href="{{ sort_status }}">{{ column_status }}</a> {% endif %}</td>
                    <td class="text-right">{% if sort == 'o.total' %} <a href="{{ sort_total }}" class="{{ order|lower }}">{{ column_total }}</a> {% else %} <a href="{{ sort_total }}">{{ column_total }}</a> {% endif %}</td>
                    <td class="text-center">{% if sort == 'o.date_added' %} <a href="{{ sort_date_added }}" class="{{ order|lower }}">{{ column_date_added }}</a> {% else %} <a href="{{ sort_date_added }}">{{ column_date_added }}</a> {% endif %}</td>
                    <td class="text-center">{% if sort == 'o.date_modified' %} <a href="{{ sort_date_modified }}" class="{{ order|lower }}">{{ column_date_modified }}</a> {% else %} <a href="{{ sort_date_modified }}">{{ column_date_modified }}</a> {% endif %}</td>
                    <td class="text-center">{{ column_action }}</td>
                  </tr>
                </thead>
                <tbody>
                
                {% if orders %}
                {% for order in orders %}
                <tr>
                  <td class="text-center"> {% if order.order_id in selected %}
                    <input type="checkbox" name="selected[]" value="{{ order.order_id }}" checked="checked" />
                    {% else %}
                    <input type="checkbox" name="selected[]" value="{{ order.order_id }}" />
                    {% endif %}
                    <input type="hidden" name="shipping_code[]" value="{{ order.shipping_code }}" /></td>
                  <td class="text-right"><span class="ccp-order-id">{{ order.order_id }}</span><span class="ccp-order-unit-count{% if not order.product_units %} is-empty{% endif %}" title="{{ order.product_count_tooltip }}" aria-label="{{ order.product_count_tooltip }}" data-toggle="tooltip" data-container="body">{{ order.product_units }} <small>{{ text_order_units_label }}</small></span></td>
                  <td class="text-left">{{ order.customer }}</td>
                  <td class="text-left">{{ order.order_status }}</td>
                  <td class="text-right">{{ order.total }}</td>
                  <td class="text-center">{{ order.date_added }}</td>
                  <td class="text-center">{{ order.date_modified }}</td>
                  <td class="text-center"><div class="btn-group ccp-order-list-actions" style="white-space:nowrap;">
                      <button type="button" class="btn btn-info js-order-preview" data-order-id="{{ order.order_id }}" aria-expanded="false" data-toggle="tooltip" title="{{ text_order_preview }}" aria-label="{{ text_order_preview }}"><i class="fa fa-list"></i></button>
                      <a href="{{ order.view }}" data-toggle="tooltip" title="{{ button_view }}" class="btn btn-success"><i class="fa fa-eye"></i></a>
                      <a href="{{ order.edit }}" data-toggle="tooltip" title="{{ button_edit }}" class="btn btn-primary"><i class="fa fa-pencil"></i></a>
                      <button type="button" data-order-id="{{ order.order_id }}" data-toggle="tooltip" title="{{ button_delete }}" class="btn btn-danger js-order-delete"><i class="fa fa-trash-o"></i></button>
                    </div></td>
                </tr>
                {% endfor %}
                {% else %}
                <tr>
                  <td class="text-center" colspan="8">{{ text_no_results }}</td>
                </tr>
                {% endif %}
                  </tbody>
                
              </table>
            </div>
          </form>
          <div class="row">
            <div class="col-sm-6 text-left">{{ pagination }}</div>
            <div class="col-sm-6 text-right">{{ results }}</div>
          </div>
        </div>
      </div>
    </div>
  </div>
  <script type="text/javascript"><!--
$('#button-filter').on('click', function() {
	url = '';

	var filter_order_id = $('input[name=\'filter_order_id\']').val();

	if (filter_order_id) {
		url += '&filter_order_id=' + encodeURIComponent(filter_order_id);
	}

	var filter_customer = $('input[name=\'filter_customer\']').val();

	if (filter_customer) {
		url += '&filter_customer=' + encodeURIComponent(filter_customer);
	}

	var filter_order_status_id = $('select[name=\'filter_order_status_id\']').val();

	if (filter_order_status_id !== '') {
		url += '&filter_order_status_id=' + encodeURIComponent(filter_order_status_id);
	}

	['filter_email','filter_phone','filter_product','filter_shipping_method',
	 'filter_payment_method','filter_total_min','filter_total_max'].forEach(function(key) {
		var value = $('#filter-order [name="' + key + '"]').val();
		if (key === 'filter_phone') { value = (value || '').replace(/\D/g, ''); }
		if (value) { url += '&' + key + '=' + encodeURIComponent(value); }
	});

	var filter_date_added = $('input[name=\'filter_date_added\']').val();

	if (filter_date_added) {
		url += '&filter_date_added=' + encodeURIComponent(filter_date_added);
	}

	var filter_date_start = $('input[name=\'filter_date_start\']').val();
	var filter_date_end = $('input[name=\'filter_date_end\']').val();
	if (filter_date_start) { url += '&filter_date_start=' + encodeURIComponent(filter_date_start); }
	if (filter_date_end) { url += '&filter_date_end=' + encodeURIComponent(filter_date_end); }

	var filter_date_modified = $('input[name=\'filter_date_modified\']').val();

	if (filter_date_modified) {
		url += '&filter_date_modified=' + encodeURIComponent(filter_date_modified);
	}

	location = 'index.php?route=sale/order&user_token={{ user_token }}' + url;
});
//--></script> 
  <script type="text/javascript"><!--
$('input[name=\'filter_customer\']').autocomplete({
	'source': function(request, response) {
		$.ajax({
			url: 'index.php?route=customer/customer/autocomplete&user_token={{ user_token }}&filter_name=' +  encodeURIComponent(request),
			dataType: 'json',
			success: function(json) {
				response($.map(json, function(item) {
					return {
						label: item['name'],
						value: item['customer_id']
					}
				}));
			}
		});
	},
	'select': function(item) {
		$('input[name=\'filter_customer\']').val(item['label']);
	}
});
//--></script> 
  <script type="text/javascript"><!--
$('input[name^=\'selected\']').on('change', function() {
	$('#button-shipping, #button-invoice').prop('disabled', true);

	var selected = $('input[name^=\'selected\']:checked');

	if (selected.length) {
		$('#button-invoice').prop('disabled', false);
	}

	for (i = 0; i < selected.length; i++) {
		if ($(selected[i]).parent().find('input[name^=\'shipping_code\']').val()) {
			$('#button-shipping').prop('disabled', false);

			break;
		}
	}
});

$('#button-shipping, #button-invoice').prop('disabled', true);

$('input[name^=\'selected\']:first').trigger('change');

// IE and Edge fix!
$('#button-shipping, #button-invoice').on('click', function(e) {
	$('#form-order').attr('action', this.getAttribute('formAction'));
});

$('.js-order-delete').on('click', function(e) {
	e.preventDefault();
	var element = this;
	var orderId = $(element).data('order-id');
	if (!confirm('{{ text_confirm }}')) { return; }

	$.ajax({
		url: '{{ catalog }}index.php?route=api/order/delete&api_token={{ api_token }}&store_id={{ store_id }}&order_id=' + encodeURIComponent(orderId),
		dataType: 'json',
		beforeSend: function() { $(element).button('loading'); },
		complete: function() { $(element).button('reset'); },
		success: function(json) {
			$('.alert-dismissible').remove();
			if (json['error']) {
				$('#content > .container-fluid').prepend('<div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> ' + json['error'] + ' <button type="button" class="close" data-dismiss="alert">&times;</button></div>');
			}
			if (json['success']) { location = '{{ delete }}'; }
		},
		error: function(xhr, ajaxOptions, thrownError) { CodeCartAdmin.ajaxError(xhr, thrownError); }
	});
});
//--></script> 
  <script type="text/javascript"><!--
$('.date').datetimepicker({
	language: '{{ datepicker }}',
	pickTime: false
});
$('#filter-order').on('keydown', function(e) {
  if (e.keyCode == 13) {
      $('#button-filter').trigger('click')
  }
});
//-->
$('#button-export-orders').on('click', function() {
	var url = '{{ export|replace({'&amp;':'&'}) }}';
	var start = $('input[name=\'filter_date_start\']').val();
	var end = $('input[name=\'filter_date_end\']').val();
	var status = $('select[name=\'filter_order_status_id\']').val();
	if (start) { url += '&filter_date_start=' + encodeURIComponent(start); }
	if (end) { url += '&filter_date_end=' + encodeURIComponent(end); }
	if (status !== '') { url += '&filter_order_status_id=' + encodeURIComponent(status); }
	window.location = url;
});
</script></div>
<script>
(function($) {
  var captions = {
    photo: '{{ column_image|e('js') }}',
    product: '{{ column_product|e('js') }}',
    model: '{{ column_model|e('js') }}',
    quantity: '{{ column_quantity|e('js') }}',
    price: '{{ column_price|e('js') }}',
    total: '{{ column_total|e('js') }}',
    loading: '{{ text_order_preview_loading|e('js') }}',
    empty: '{{ text_order_preview_empty|e('js') }}',
    error: '{{ text_order_preview_error|e('js') }}'
  };
  function cell(tr, value, alignment) {
    var td = $('<td>').addClass('text-' + (alignment || 'left'));
    if (typeof value === 'string') { td.text(value); }
    else { td.append(value); }
    tr.append(td);
  }
  $(document).on('click', '.js-order-preview', function() {
    var button = $(this), orderId = button.attr('data-order-id'), tr = button.closest('tr');
    var current = tr.next('.ccp-order-preview-row');
    if (current.length) {
      current.remove();
      button.attr('aria-expanded','false').find('i').removeClass('fa-chevron-up').addClass('fa-list');
      return;
    }
    $('.ccp-order-preview-row').remove();
    $('.js-order-preview').attr('aria-expanded','false').find('i.fa-chevron-up').removeClass('fa-chevron-up').addClass('fa-list');
    button.attr('aria-expanded','true').find('i').removeClass('fa-list').addClass('fa-chevron-up');
    var holder = $('<div class="ccp-order-preview-content">').text(captions.loading);
    var details = $('<tr class="ccp-order-preview-row">').append($('<td colspan="8">').append(holder));
    tr.after(details);
    $.ajax({
      url: '{{ order_preview_url|replace({'&amp;':'&'}) }}' + '&order_id=' + encodeURIComponent(orderId),
      dataType: 'json',
      cache: false
    }).done(function(json) {
      if (!details.parent().length) { return; }
      holder.empty();
      if (!json || !Array.isArray(json.products)) {
        holder.text(json && json.error ? json.error : captions.error); return;
      }
      if (!json.products.length) { holder.text(captions.empty); return; }
      var head = $('<tr>');
      [captions.photo,captions.product,captions.model,captions.quantity,captions.price,captions.total]
        .forEach(function(label) { cell(head,label,'left'); });
      var rows = $('<tbody>');
      json.products.forEach(function(item) {
        var row = $('<tr>');
        var thumb = $('<img class="img-thumbnail ccp-order-photo" width="40" height="40" loading="lazy">')
          .attr('src',item.image).attr('alt',item.name);
        cell(row,thumb,'center');
        var name = item.href ? $('<a>').attr('href',item.href).text(item.name) : $('<span>').text(item.name);
        cell(row,name,'left');
        cell(row,item.model,'left');
        cell(row,String(item.quantity),'right');
        cell(row,item.price,'right');
        cell(row,item.total,'right');
        rows.append(row);
      });
      var table = $('<table class="table table-bordered ccp-order-preview-table">')
        .append($('<thead>').append(head)).append(rows);
      holder.append($('<div class="table-responsive">').append(table));
    }).fail(function() { if (details.parent().length) { holder.text(captions.error); } });
  });
})(jQuery);
</script>
