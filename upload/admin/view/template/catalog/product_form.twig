  $('#button-image-multiple').on('click', function() {
	  $('#modal-image').remove();
	  $.get('index.php?route=common/filemanager&user_token=' + getURLVar('user_token') + '&multiple=1' + (typeof codecartFileManagerDirectoryParam === 'function' ? codecartFileManagerDirectoryParam() : ''), function(html) {
		  $('body').append('<div id="modal-image" class="modal">' + html + '</div>');
		  $('#modal-image').modal('show');
	  });
  });

  $(document).off('codecart.images.selected.product').on('codecart.images.selected.product', function(e, images) {
	  $.each(images || [], function(index, item) {
		  var row = image_row;
		  addImage();
		  $('#input-image' + row).val(item.path);
		  $('#thumb-image' + row + ' img').attr('src', item.thumb);
		  $('#image-row' + row + ' input[name$="[sort_order]"]').val(row);
	  });
  });

