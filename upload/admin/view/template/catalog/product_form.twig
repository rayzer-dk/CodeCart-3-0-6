		  $('#product-filter' + item['value']).remove();

		  $('#product-filter').append('<div id="product-filter' + item['value'] + '"><i class="fa fa-minus-circle"></i> ' + item['label'] + '<input type="hidden" name="product_filter[]" value="' + item['value'] + '" /></div>');
	  }
  });

  $('#product-filter').delegate('.fa-minus-circle', 'click', function() {
	  $(this).parent().remove();
  });

  // Both selectors only modify the current product form; persistence happens
  // with OpenCart's standard Save button, never on autocomplete selection.
  function codecartAddProductFile($list, id, label) {
    id = parseInt(id, 10);
    if (!id || !$list.length) return;
    var prefix = $list.attr('data-prefix');
    if ($('#' + prefix + id).length) return;
    var title = $list.attr('data-remove-title');
    var $row = $('<div/>', {'id': prefix + id, 'class': 'cc-product-file-row'});
    $('<span/>', {'class': 'cc-product-file-name'}).text(label).appendTo($row);
    var $button = $('<button/>', {'type': 'button', 'class': 'btn btn-danger btn-xs cc-product-file-remove', 'title': title, 'aria-label': title});
    $('<i/>', {'class': 'fa fa-trash-o'}).appendTo($button);
    $row.append($button);
    $('<input/>', {'type': 'hidden', 'name': $list.attr('data-name'), 'value': id}).appendTo($row);
    $list.append($row);
  }
  $('#input-download, #input-public-document').each(function() {
    var $input = $(this);
    var isPublic = $input.attr('id') === 'input-public-document';
    var $list = $(isPublic ? '#product-public-documents' : '#product-download');
    var route = isPublic ? 'catalog/public_document/autocomplete' : 'catalog/download/autocomplete';
    $input.autocomplete({
      source: function(request, response) {
        $.ajax({
          url: 'index.php?route=' + route + '&user_token={{ user_token }}&filter_name=' + encodeURIComponent(request),
          dataType: 'json',
          success: function(items) {
            response($.map(items, function(item) {
              return {label: item.name, value: isPublic ? item.document_id : item.download_id};
            }));
          },
          error: function() { response([]); }
        });
      },
      select: function(item) {
        $input.val('');
        codecartAddProductFile($list, item.value, item.label);
      }
    });
  });
  $('#product-download, #product-public-documents').on('click', '.cc-product-file-remove', function() {
    $(this).closest('.cc-product-file-row').remove();
  });

  // Related
  $('input[name=\'related\']').autocomplete({
	  'source': function(request, response) {
		  $.ajax({
			  url: 'index.php?route=catalog/product/autocomplete&user_token={{ user_token }}&filter_name=' + encodeURIComponent(request),
			  dataType: 'json',
