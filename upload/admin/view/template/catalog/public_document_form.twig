{{ header }}{{ column_left }}
<div id="content" class="cc-documents-admin">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        {% if can_modify %}<button type="submit" form="form-document" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa fa-save"></i></button>{% endif %}
        <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default"><i class="fa fa-reply"></i></a>
      </div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">
        <li><a href="{{ dashboard_url }}">{{ text_home }}</a></li>
        <li><a href="{{ cancel }}">{{ heading_title }}</a></li>
      </ul>
    </div>
  </div>
  <div class="container-fluid">
    {% if error_warning %}<div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}</div>{% endif %}
    <div class="panel panel-default">
      <div class="panel-heading"><h3 class="panel-title"><i class="fa fa-pencil"></i> {{ text_form }}</h3></div>
      <div class="panel-body">
        <form action="{{ action }}" method="post" enctype="multipart/form-data" class="form-horizontal" id="form-document">
        <div class="form-group required"><label class="col-sm-2 control-label">{{ entry_title }}</label>
          <div class="col-sm-10">
            {% for lang in languages %}
              <div class="input-group" style="margin-bottom:6px;">
                <span class="input-group-addon" title="{{ lang.name }}"><img src="language/{{ lang.code }}/{{ lang.code }}.png" alt="{{ lang.name }}" title="{{ lang.name }}" style="width:18px;vertical-align:middle;"></span>
                <input type="text" name="document_description[{{ lang.language_id }}]" maxlength="200" class="form-control" value="{{ titles[lang.language_id] is defined ? titles[lang.language_id] : '' }}" placeholder="{{ lang.name }}" aria-label="{{ entry_title }} — {{ lang.name }}">
              </div>
            {% endfor %}
          </div>
        </div>
        <div class="form-group required"><label class="col-sm-2 control-label" for="doc-file">{{ entry_file }}</label><div class="col-sm-10">
          <input type="file" name="file" id="doc-file" class="form-control" {% if not edit_mode %}required{% endif %} accept=".pdf,.doc,.docx,.xls,.xlsx,.jpg,.jpeg,.png,.webp,.txt,.zip">
          <p class="help-block">{{ help_file }}{% if document.original_name %} {{ text_current }}: {{ document.original_name }}{% endif %}</p>
        </div></div>
      </form></div>
    </div>
  </div>
</div>{{ footer }}
