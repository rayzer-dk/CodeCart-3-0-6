{{ header }}{{ column_left }}
<div id="content">
<div id="cc-tree-config" data-cc-tree-url="{{ category_tree_edit_url }}" data-cc-tree-autocomplete="{{ category_tree_autocomplete }}" data-cc-tree-kind="{{ category_tree_kind }}" data-cc-tree-error="{{ tree_error }}" data-cc-tree-choose="{{ tree_choose }}" data-cc-tree-done="{{ tree_done }}"></div>
<link rel="stylesheet" href="view/stylesheet/codecart-category-tree.css?v=3.0.6.1.5" />
<script src="view/javascript/codecart/category-tree.js?v=3.0.6.1.5" defer></script>
<link rel="stylesheet" href="view/stylesheet/codecart-catalog-quality.css?v=3.0.6.1.5" />
<script src="view/javascript/codecart/catalog-quality.js?v=3.0.6.1.5" defer></script>
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right"><a href="{{ add }}" data-toggle="tooltip" title="{{ button_add }}" class="btn btn-primary"><i class="fa fa-plus"></i></a>
	  <a href="{{ repair }}" data-toggle="tooltip" title="{{ button_rebuild }}" class="btn btn-default"><i class="fa fa-refresh"></i></a>
		<button type="submit" form="form-category" formaction="{{ enabled }}" data-toggle="tooltip" title="{{ button_enable }}" class="btn btn-default"><i class="fa fa-play"></i></button>
		<button type="submit" form="form-category" formaction="{{ disabled }}" data-toggle="tooltip" title="{{ button_disable }}" class="btn btn-default"><i class="fa fa-pause"></i></button>
		<button type="button" form="form-category" formaction="{{ delete }}" data-toggle="tooltip" title="{{ button_delete }}" class="btn btn-danger" onclick="confirm('{{ text_confirm }}') ? $('#form-category').submit() : false;"><i class="fa fa-trash-o"></i></button>
      </div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
        <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>
  <div class="container-fluid">
    {% if error_warning %}
    <div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    {% if success %}
    <div class="alert alert-success alert-dismissible"><i class="fa fa-check-circle"></i> {{ success }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    <div class="panel panel-default">
      <div class="panel-heading">
        <button type="button" class="btn btn-default btn-xs pull-right cc-tree-expand-all" aria-expanded="false" title="{{ tree_expand_all }}"><i class="fa fa-angles-down" aria-hidden="true"></i> {{ tree_expand_all }}</button>
        <h3 class="panel-title"><i class="fa fa-list"></i> {{ text_list }}</h3>
      </div>
      <div class="panel-body">
        <div class="cc-tree-root cc-tree-root-inline" data-cc-tree-target="0" tabindex="0" title="{{ tree_drag_help }}"><i class="fa fa-level-up" aria-hidden="true"></i> {{ tree_root }}</div>
        <form action="{{ delete }}" method="post" enctype="multipart/form-data" id="form-category">
          <div class="table-responsive">
            <table class="table table-bordered table-hover cc-quality-table cc-category-list-drag" data-quality-url="{{ quality_endpoint }}" data-quality-count="{{ quality_count_label }}">
              <thead>
                <tr>
                  <td style="width: 1px;" class="text-center"><input type="checkbox" onclick="$('input[name*=\'selected\']').prop('checked', this.checked);" /></td>
                  <td class="text-left">{{ column_name }}</td>
                  <td class="text-right">{{ column_sort_order }}</td>
				  <td class="text-right">{% if sort == 'noindex' %}
                    <a href="{{ sort_noindex }}" class="{{ order|lower }}">{{ column_noindex }}</a>
                    {% else %}
                    <a href="{{ sort_noindex }}">{{ column_noindex }}</a>
					{% endif %}</td>
                  <td class="text-right">{{ column_action }}</td>
                </tr>
              </thead>
              <tbody>
                {% if categories %}
                {% for category in categories %}
                <tr class="cc-tree-row cc-tree-list-row" data-cc-tree-id="{{ category.category_id }}" data-cc-tree-parent="{{ category.parent_id }}" data-cc-tree-path="{{ category.ancestor_path }}" data-cc-tree-depth="{{ category.depth }}" draggable="true">
                  <td class="text-center">{% if category.category_id in selected %}
                    <input type="checkbox" name="selected[]" value="{{ category.category_id }}" checked="checked" />
                    {% else %}
                    <input type="checkbox" name="selected[]" value="{{ category.category_id }}" />
                    {% endif %}</td>
				  {% if category.href %}
                  <td class="left"><span class="cc-tree-handle" role="button" tabindex="0" title="{{ tree_drag_help }}" aria-label="{{ tree_drag_help }}"><i class="fa fa-grip-vertical fa-bars" aria-hidden="true"></i></span><span class="cc-tree-indent" style="--cc-tree-depth:{{ category.depth }}"></span>{% if category.has_children %}<button type="button" class="cc-tree-collapse" aria-expanded="false" title="{{ tree_expand }}" aria-label="{{ tree_expand }}"><i class="fa fa-angle-right" aria-hidden="true"></i></button>{% else %}<span class="cc-tree-collapse is-placeholder"></span>{% endif %}<a href="{{ category.edit }}">{{ category.name }}</a> <span class="cc-quality" data-quality-id="{{ category.category_id }}"><a href="{{ category.products_href }}" class="cc-quality-count cc-quality-count-link" title="{{ quality_count_label }}" aria-label="{{ quality_count_label }}: {{ category.name|striptags }}" hidden><span class="cc-quality-count-number"></span><i class="fa fa-arrow-right" aria-hidden="true"></i></a><span class="cc-quality-score">···</span></span> </td>
					{% else %}
                  <td class="left"><span class="cc-tree-handle" role="button" tabindex="0" title="{{ tree_drag_help }}" aria-label="{{ tree_drag_help }}"><i class="fa fa-grip-vertical fa-bars" aria-hidden="true"></i></span><span class="cc-tree-indent" style="--cc-tree-depth:{{ category.depth }}"></span>{% if category.has_children %}<button type="button" class="cc-tree-collapse" aria-expanded="false" title="{{ tree_expand }}" aria-label="{{ tree_expand }}"><i class="fa fa-angle-right" aria-hidden="true"></i></button>{% else %}<span class="cc-tree-collapse is-placeholder"></span>{% endif %}<a href="{{ category.edit }}">{{ category.name }}</a> <span class="cc-quality" data-quality-id="{{ category.category_id }}"><a href="{{ category.products_href }}" class="cc-quality-count cc-quality-count-link" title="{{ quality_count_label }}" aria-label="{{ quality_count_label }}: {{ category.name|striptags }}" hidden><span class="cc-quality-count-number"></span><i class="fa fa-arrow-right" aria-hidden="true"></i></a><span class="cc-quality-score">···</span></span></td>
                  {% endif %}
                  <td class="text-right"><span class="cc-category-sort-wrap"><input type="text" inputmode="numeric" pattern="-?[0-9]*" class="cc-category-sort" data-cc-sort-id="{{ category.category_id }}" data-cc-sort-expected="{{ category.sort_order }}" value="{{ category.sort_order }}" min="-999999" max="999999" step="1" aria-label="{{ tree_sort }} — {{ category.name|striptags }}" title="{{ tree_sort }}"  readonly="readonly" /><button type="button" class="cc-category-sort-pencil" aria-label="{{ tree_sort }}" title="{{ tree_sort }}"><i class="fa fa-pencil" aria-hidden="true"></i></button></span></td>
				  <td class="text-right">{{ category.noindex }}</td>
                  <td class="text-right">
					<a target="_blank" href="{{ category.href_shop }}" data-toggle="tooltip" title="{{ button_shop }}" class="btn btn-success"><i class="fa fa-eye"></i></a>
					<a href="{{ category.edit }}" data-toggle="tooltip" title="{{ button_edit }}" class="btn btn-primary"><i class="fa fa-pencil"></i></a>
				  </td>
                </tr>
                {% endfor %}
                {% else %}
                <tr>
                  <td class="text-center" colspan="4">{{ text_no_results }}</td>
                </tr>
                {% endif %}
              </tbody>
            </table>
          </div>
        </form>
        <div class="row">
          <div class="col-sm-6 text-left">{{ pagination }}</div>
          <div class="col-sm-6 text-right">{{ results }}</div>
        </div>
      </div>
    </div>
  </div>

  <div class="modal fade" id="cc-tree-move-modal" tabindex="-1" role="dialog" aria-labelledby="cc-tree-move-title">
    <div class="modal-dialog modal-sm" role="document">
      <div class="modal-content">
        <div class="modal-header">
          <button type="button" class="close" data-dismiss="modal" aria-label="{{ tree_cancel }}">&times;</button>
          <h4 class="modal-title" id="cc-tree-move-title">{{ tree_move }}</h4>
        </div>
        <div class="modal-body">
          <p class="cc-tree-moving-name"></p>
          <label for="cc-tree-parent-search">{{ tree_search }}</label>
          <input id="cc-tree-parent-search" type="text" class="form-control" autocomplete="off" placeholder="{{ tree_search }}" />
          <input id="cc-tree-parent-id" type="hidden" value="0" />
          <p class="cc-tree-selected-parent text-muted">{{ tree_root_option }}</p>
          <button type="button" class="btn btn-default btn-xs cc-tree-select-root">{{ tree_root_option }}</button>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-default" data-dismiss="modal">{{ tree_cancel }}</button>
          <button type="button" class="btn btn-primary cc-tree-confirm-move">{{ tree_save }}</button>
        </div>
      </div>
    </div>
  </div>

    <script type="text/javascript"><!--
// IE and Edge fix!
$('button[form=\'form-category\']').on('click', function(e) {
	$('#form-category').attr('action', $(this).attr('formaction'));
});
 //--></script>
</div>
{{ footer }}