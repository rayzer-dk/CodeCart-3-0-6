{{ promotion }}
<fieldset>
  <legend>{{ heading_title }}</legend>
  {% if error_warning %}
  <div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}
    <button type="button" class="close" data-dismiss="alert">&times;</button>
  </div>
  {% endif %}
  {% if success %}
  <div class="alert alert-success alert-dismissible"><i class="fa fa-check-circle"></i> {{ success }}
    <button type="button" class="close" data-dismiss="alert">&times;</button>
  </div>
  {% endif %}
  <div class="table-responsive">
    <table class="table table-bordered table-hover ccp-extension-table ccp-extension-cols-6">
      <thead>
        <tr>
          <th scope="col" class="text-left"><button type="button" class="ccp-extension-sort" data-ccp-sort="name" title="{{ text_sort_ascending }}" data-sort-asc="{{ text_sort_ascending }}" data-sort-desc="{{ text_sort_descending }}"><span class="ccp-extension-sort-label">{{ column_name }}</span> <i class="fa fa-sort" aria-hidden="true"></i></button></th>
          <th scope="col" class="text-center"><button type="button" class="ccp-extension-sort" data-ccp-sort="status" title="{{ text_sort_ascending }}" data-sort-asc="{{ text_sort_ascending }}" data-sort-desc="{{ text_sort_descending }}"><span class="ccp-extension-sort-label">{{ column_status }}</span> <i class="fa fa-sort" aria-hidden="true"></i></button></th>
          <th scope="col" class="text-center"><button type="button" class="ccp-extension-sort" data-ccp-sort="installed" title="{{ text_sort_ascending }}" data-sort-asc="{{ text_sort_ascending }}" data-sort-desc="{{ text_sort_descending }}"><span class="ccp-extension-sort-label">{{ column_installed }}</span> <i class="fa fa-sort" aria-hidden="true"></i></button></th>
          <th scope="col" class="text-center"><button type="button" class="ccp-extension-sort" data-ccp-sort="upload" title="{{ text_sort_ascending }}" data-sort-asc="{{ text_sort_ascending }}" data-sort-desc="{{ text_sort_descending }}"><span class="ccp-extension-sort-label">{{ column_upload_date }}</span> <i class="fa fa-sort" aria-hidden="true"></i></button></th>
          <th scope="col" class="text-center"><button type="button" class="ccp-extension-sort" data-ccp-sort="date" title="{{ text_sort_ascending }}" data-sort-asc="{{ text_sort_ascending }}" data-sort-desc="{{ text_sort_descending }}"><span class="ccp-extension-sort-label">{{ column_install_date }}</span> <i class="fa fa-sort" aria-hidden="true"></i></button></th>
          <th scope="col" class="text-center">{{ column_action }}</th>
        </tr>
      </thead>
      <tbody>
        {% if extensions %}
        {% for extension in extensions %}
        <tr class="ccp-extension-main" data-sort-name="{{ extension.name|e('html_attr') }}" data-sort-status="{{ extension.status|default('')|e('html_attr') }}" data-sort-installed="{{ extension.installed ? '1' : '0' }}" data-sort-upload="{{ extension.date_uploaded|e('html_attr') }}" data-sort-date="{{ extension.date_installed|e('html_attr') }}">
          <td class="text-left">{{ extension.name }}</td>
          <td class="text-left">{{ extension.status }}</td>
          <td class="text-center">{% if extension.installed %}<span class="label label-success">{{ text_installed }}</span>{% else %}<span class="label label-default">{{ text_not_installed }}</span>{% endif %}</td>
          <td class="text-center ccp-extension-date">{% if extension.date_uploaded_label %}{{ extension.date_uploaded_label }}{% else %}<span class="text-muted" title="{{ text_upload_date_unknown }}">—</span>{% endif %}</td>
          <td class="text-center ccp-extension-date">{% if extension.date_installed_label %}{{ extension.date_installed_label }}{% else %}<span class="text-muted" title="{{ text_date_unknown }}">—</span>{% endif %}</td>
          <td class="text-center">{% if extension.installed %}
            <a href="{{ extension.edit }}" data-toggle="tooltip" title="{{ button_edit }}" class="btn btn-primary"><i class="fa fa-pencil"></i></a>
            {% else %}
            <button type="button" class="btn btn-primary" disabled="disabled" title="{{ button_edit }}"><i class="fa fa-pencil"></i></button>
            {% endif %}
            {% if not extension.installed %}
            <a href="{{ extension.install }}" data-toggle="tooltip" title="{{ button_install }}" class="btn btn-success"><i class="fa fa-plus-circle"></i></a>
            {% else %}
            <a href="{{ extension.uninstall }}" data-toggle="tooltip" title="{{ button_uninstall }}" class="btn btn-danger"><i class="fa fa-minus-circle"></i></a>
            {% endif %}</td>
        </tr>
        {% endfor %}
        {% else %}
        <tr>
          <td class="text-center" colspan="6">{{ text_no_results }}</td>
        </tr>
        {% endif %}
      </tbody>
    </table>
  </div>
</fieldset>
