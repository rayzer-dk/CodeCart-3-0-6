{{ promotion }}
<fieldset>
  <legend>{{ heading_title }}</legend>
  {% if error_warning %}
  <div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}
    <button type="button" class="close" data-dismiss="alert">&times;</button>
  </div>
  {% endif %}
  {% if success %}
  <div class="alert alert-success alert-dismissible"><i class="fa fa-check-circle"></i> {{ success }}
    <button type="button" class="close" data-dismiss="alert">&times;</button>
  </div>
  {% endif %}
  <div class="alert alert-info"><i class="fa fa-info-circle"></i> {{ text_layout }}</div>
   {% if hiden is not empty %}
    <div class="alert alert-info"><i class="fa fa-check-circle"></i> {{ text_hide_modules }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
  <div class="table-responsive">
    <table class="table table-bordered table-hover ccp-extension-table ccp-extension-cols-4">
      <thead>
        <tr>
          <th scope="col" class="text-left"><button type="button" class="ccp-extension-sort" data-ccp-sort="name" title="{{ text_sort_ascending }}" data-sort-asc="{{ text_sort_ascending }}" data-sort-desc="{{ text_sort_descending }}"><span class="ccp-extension-sort-label">{{ column_name }}</span> <i class="fa fa-sort" aria-hidden="true"></i></button></th>
          <th scope="col" class="text-center"><button type="button" class="ccp-extension-sort" data-ccp-sort="status" title="{{ text_sort_ascending }}" data-sort-asc="{{ text_sort_ascending }}" data-sort-desc="{{ text_sort_descending }}"><span class="ccp-extension-sort-label">{{ column_status }}</span> <i class="fa fa-sort" aria-hidden="true"></i></button></th>
          <th scope="col" class="text-center"><button type="button" class="ccp-extension-sort" data-ccp-sort="upload" title="{{ text_sort_ascending }}" data-sort-asc="{{ text_sort_ascending }}" data-sort-desc="{{ text_sort_descending }}"><span class="ccp-extension-sort-label">{{ column_upload_date }}</span> <i class="fa fa-sort" aria-hidden="true"></i></button></th>
          <th scope="col" class="text-center">{{ column_action }}</th>
        </tr>
      </thead>
      <tbody>
      
      {% if extensions %}
      {% for extension in extensions %}
      <tr class="ccp-extension-main" data-sort-name="{{ extension.name|e('html_attr') }}" data-sort-status="{{ extension.status|default('')|e('html_attr') }}" data-sort-upload="{{ extension.date_uploaded|e('html_attr') }}">
        <td><b>{{ extension.name }}</b></td>
        <td><span class="ccp-extension-status {{ extension.status_enabled ? 'ccp-extension-status-on' : 'ccp-extension-status-off' }}">{{ extension.status }}</span></td>
          <td class="text-center ccp-extension-date">{% if extension.date_uploaded_label %}{{ extension.date_uploaded_label }}{% else %}<span class="text-muted" title="{{ text_upload_date_unknown }}">—</span>{% endif %}</td>
          <td class="text-center">{% if extension.installed %}
          {% if extension.module %} <a href="{{ extension.edit }}" data-toggle="tooltip" title="{{ button_add }}" class="btn btn-primary"><i class="fa fa-plus-circle"></i></a> {% else %} <a href="{{ extension.edit }}" data-toggle="tooltip" title="{{ button_edit }}" class="btn btn-primary"><i class="fa fa-pencil"></i></a> {% endif %}
          {% else %}
          <button type="button" class="btn btn-primary" disabled="disabled" title="{{ button_edit }}"><i class="fa fa-pencil"></i></button>
          {% endif %}
          {% if not extension.installed %}<a href="{{ extension.install }}" data-toggle="tooltip" title="{{ button_install }}" class="btn btn-success"><i class="fa fa-plus-circle"></i></a> {% else %} <a href="{{ extension.uninstall }}" data-toggle="tooltip" title="{{ button_uninstall }}" class="btn btn-danger"><i class="fa fa-minus-circle"></i></a>{% endif %}</td>
      </tr>
      {% for module in extension.module %}
      <tr class="ccp-extension-child">
        <td class="text-left">&nbsp;&nbsp;&nbsp;<i class="fa fa-folder-open"></i>&nbsp;&nbsp;&nbsp;{{ module.name }}</td>
        <td><span class="ccp-extension-status {{ module.status_enabled ? 'ccp-extension-status-on' : 'ccp-extension-status-off' }}">{{ module.status }}</span></td>
        <td></td>
          <td class="text-center"><a href="{{ module.edit }}" data-toggle="tooltip" title="{{ button_edit }}" class="btn btn-info"><i class="fa fa-pencil"></i></a> <a href="{{ module.delete }}" data-toggle="tooltip" title="{{ button_delete }}" class="btn btn-warning"><i class="fa fa-trash-o"></i></a></td>
      </tr>
      {% endfor %}
      {% endfor %}
      {% else %}
      <tr>
        <td class="text-center" colspan="4">{{ text_no_results }}</td>
      </tr>
      {% endif %}
      </tbody>
      
    </table>
  </div>
</fieldset>
