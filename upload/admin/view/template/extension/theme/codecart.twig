{{ header }}{{ column_left }}
<div id="content" class="ccp-theme-admin">
<link href="../catalog/view/theme/default/stylesheet/inter.css?v=3.0.6.0" rel="stylesheet" type="text/css" />
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <button type="submit" form="form-theme" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa fa-save"></i></button>
        <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default"><i class="fa fa-reply"></i></a></div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
        <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>
  <div class="container-fluid">
    {% if error_warning %}
    <div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    <div class="panel panel-default">
      <div class="panel-heading">
        <h3 class="panel-title"><i class="fa fa-pencil"></i> {{ text_edit }}</h3>
      </div>
      <div class="panel-body">
        <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-theme" class="form-horizontal">
          <fieldset>
            <legend>{{ text_general }}</legend>
            <input type="hidden" name="theme_codecart_directory" value="codecart" id="input-directory" />
            <div class="form-group">
              <label class="col-sm-2 control-label" for="input-status">{{ entry_status }}</label>
              <div class="col-sm-10">
                <select name="theme_codecart_status" id="input-status" class="form-control">
                  {% if theme_codecart_status %}
                  <option value="1" selected="selected">{{ text_enabled }}</option>
                  <option value="0">{{ text_disabled }}</option>
                  {% else %}
                  <option value="1">{{ text_enabled }}</option>
                  <option value="0" selected="selected">{{ text_disabled }}</option>
                  {% endif %}
                </select>
              </div>
            </div>
          </fieldset>


          <fieldset class="ccp-storefront-modes">
            <legend><i class="fa fa-plug"></i> {{ text_storefront_modes }}</legend>
            <div class="form-group">
              <label class="col-sm-2 control-label" for="input-commerce-style"><span data-toggle="tooltip" title="{{ help_commerce_style }}">{{ entry_commerce_style }}</span></label>
              <div class="col-sm-10">
                <select name="theme_codecart_commerce_style" id="input-commerce-style" class="form-control">
                  {% for value, label in commerce_styles %}<option value="{{ value }}"{% if value == theme_codecart_commerce_style %} selected{% endif %}>{{ label }}</option>{% endfor %}
                </select>
              </div>
            </div>
            <div class="form-group">
              <label class="col-sm-2 control-label" for="input-catalog-ajax"><span data-toggle="tooltip" title="{{ help_catalog_ajax }}">{{ entry_catalog_ajax }}</span></label>
              <div class="col-sm-10">
                <select name="theme_codecart_catalog_ajax_status" id="input-catalog-ajax" class="form-control">
                  {% if theme_codecart_catalog_ajax_status %}
                  <option value="1" selected="selected">{{ text_enabled }}</option>
                  <option value="0">{{ text_disabled }}</option>
                  {% else %}
                  <option value="1">{{ text_enabled }}</option>
                  <option value="0" selected="selected">{{ text_disabled }}</option>
                  {% endif %}
                </select>
                <p class="help-block">{{ text_catalog_ajax_help }}</p>
                <button type="button" id="button-catalog-ajax-check" class="btn btn-default" data-loading-text="{{ text_loading }}"><i class="fa fa-check-circle"></i> {{ button_catalog_ajax_check }}</button>
                <div id="catalog-ajax-check-result" class="alert" style="display:none;margin-top:10px" aria-live="polite"></div>
              </div>
            </div>
          </fieldset>

          <fieldset>
            <legend><i class="fa fa-paint-brush"></i> {{ text_appearance }}</legend>
            <div class="form-group">
              <label class="col-sm-2 control-label" for="input-font-family"><span data-toggle="tooltip" title="{{ help_font_family }}">{{ entry_font_family }}</span></label>
