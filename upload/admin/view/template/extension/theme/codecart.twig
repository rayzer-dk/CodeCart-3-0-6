                <div class="row ccp-font-picker-row">
                  <div class="col-md-5">
                    <select name="theme_codecart_font_family" id="input-font-family" class="form-control">
                      {% for value, label in font_families %}<option value="{{ value }}"{% if value == theme_codecart_font_family %} selected{% endif %}>{{ label }}</option>{% endfor %}
                    </select>
                  </div>
                  <div class="col-md-7">
                    <div id="ccp-font-preview" class="ccp-font-preview" aria-live="polite">
                      <span class="ccp-font-preview-name">{{ text_font_preview }}</span>
                    </div>
                  </div>
                </div>
              </div>
            </div>
            <div class="form-group">
