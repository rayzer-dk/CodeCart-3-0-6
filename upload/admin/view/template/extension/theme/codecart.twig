<script type="text/javascript">
(function($){
  var focusId = String(window.location.hash || '').replace(/^#/, '');
  if (!/^[A-Za-z0-9_-]+$/.test(focusId)) { return; }

  window.setTimeout(function(){
    var el = document.getElementById(focusId);
    if (!el) { return; }
    var $group = $(el).closest('.form-group');
    if ($group.length) {
      $group.addClass('ccp-setting-search-focus');
      window.setTimeout(function(){ $group.removeClass('ccp-setting-search-focus'); }, 2600);
    }
    if (el.scrollIntoView) { el.scrollIntoView({behavior:'smooth', block:'center'}); }
  }, 120);
})(jQuery);
</script>
