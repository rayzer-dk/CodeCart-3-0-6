<script type="text/javascript">
(function($) {
  var fontStacks = {
    system: '-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Arial,sans-serif',
    inter: 'Inter,-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Arial,sans-serif',
    arial: 'Arial,Helvetica,sans-serif',
    verdana: 'Verdana,Geneva,sans-serif',
    tahoma: 'Tahoma,Verdana,sans-serif',
    trebuchet: '"Trebuchet MS",Arial,sans-serif',
    georgia: 'Georgia,"Times New Roman",serif'
  };
  function updateFontPreview() {
    var key = String($('#input-font-family').val() || 'system');
    $('#ccp-font-preview').css('font-family', fontStacks[key] || fontStacks.system);
  }
  $('#input-font-family').on('change', updateFontPreview);
  updateFontPreview();

  $('.ccp-color-control').closest('.form-group').addClass('ccp-color-item');
  $('fieldset').each(function(){
    var $field=$(this), $items=$field.children('.ccp-color-item');
    if($items.length>1){
      var $grid=$('<div class="ccp-color-grid"></div>');
      $items.first().before($grid);
      $items.appendTo($grid);
    }
  });

  function normalizeHex(value) {
    value = $.trim(String(value || '')).toLowerCase();
    if (/^#[0-9a-f]{6}$/.test(value)) return value;
    if (/^[0-9a-f]{6}$/.test(value)) return '#' + value;
    return '';
  }

  function syncFromText(input, restoreInvalid) {
    var $input = $(input);
    var picker = $input.data('picker');
    var color = normalizeHex($input.val());

    if (color) {
      $input.val(color).removeClass('is-invalid');
      if (picker) $(picker).val(color);
      return;
    }

    if (restoreInvalid && picker && normalizeHex($(picker).val())) {
      $input.val(normalizeHex($(picker).val())).removeClass('is-invalid');
    } else {
      $input.addClass('is-invalid');
    }
  }

  $('.ccp-color-hex').each(function() { syncFromText(this, true); });

  $(document).on('input change', '.ccp-color-picker', function() {
    var color = normalizeHex(this.value);
    var target = $(this).data('target');
    if (color && target) $(target).val(color).removeClass('is-invalid').trigger('ccp:color-sync');
  });

  $(document).on('input change', '.ccp-color-hex', function() {
    syncFromText(this, false);
  });

  $(document).on('blur', '.ccp-color-hex', function() {
    syncFromText(this, true);
  });
})(jQuery);
</script>

