{{ header }}{{ column_left }}
<div id="content" class="ccp-manufacturer-wall-admin">
  <div class="page-header"><div class="container-fluid"><div class="pull-right"><button type="submit" form="form-module" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa fa-save"></i></button> <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default"><i class="fa fa-reply"></i></a></div><h1>{{ heading_title }}</h1><ul class="breadcrumb">{% for breadcrumb in breadcrumbs %}<li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>{% endfor %}</ul></div></div>
  <div class="container-fluid">{% if error_warning %}<div class="alert alert-danger"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}</div>{% endif %}
    <div class="panel panel-default"><div class="panel-heading"><h3 class="panel-title"><i class="fa fa-picture-o"></i> {{ text_edit }}</h3></div><div class="panel-body">
      <form action="{{ action }}" method="post" id="form-module" class="form-horizontal">
        <div class="form-group{% if error_name %} has-error{% endif %}"><label class="col-sm-3 control-label" for="input-name">{{ entry_name }}</label><div class="col-sm-9"><input type="text" name="name" value="{{ name }}" id="input-name" class="form-control" />{% if error_name %}<div class="text-danger">{{ error_name }}</div>{% endif %}</div></div>
        <div class="form-group"><label class="col-sm-3 control-label">{{ entry_heading }}</label><div class="col-sm-9">{% for language in languages %}<div class="input-group" style="margin-bottom:6px"><span class="input-group-addon"><img src="language/{{ language.code }}/{{ language.code }}.png" title="{{ language.name }}" /></span><input type="text" name="heading[{{ language.language_id }}]" value="{{ heading[language.language_id] is defined ? heading[language.language_id] : '' }}" class="form-control" /></div>{% endfor %}</div></div><div class="form-group"><label class="col-sm-3 control-label"><span data-toggle="tooltip" title="{{ help_show_heading }}">{{ entry_show_heading }}</span></label><div class="col-sm-3"><select name="show_heading" class="form-control"><option value="1"{% if show_heading %} selected{% endif %}>{{ text_enabled }}</option><option value="0"{% if not show_heading %} selected{% endif %}>{{ text_disabled }}</option></select></div></div>
        <div class="form-group"><label class="col-sm-3 control-label" for="input-source">{{ entry_source }}</label><div class="col-sm-9"><select name="source" id="input-source" class="form-control"><option value="all"{% if source=='all' %} selected{% endif %}>{{ text_source_all }}</option><option value="selected"{% if source=='selected' %} selected{% endif %}>{{ text_source_selected }}</option></select></div></div>
        <div class="form-group ccp-source-selected"><label class="col-sm-3 control-label"><span data-toggle="tooltip" title="{{ help_manufacturer }}">{{ entry_manufacturer }}</span></label><div class="col-sm-9"><input type="text" value="" placeholder="{{ entry_manufacturer }}" id="input-manufacturer" class="form-control" /><div id="manufacturer-wall-manufacturers" class="well well-sm" style="height:150px;overflow:auto;margin-top:8px">{% for manufacturer in manufacturers %}<div id="manufacturer-wall-manufacturer{{ manufacturer.manufacturer_id }}"><i class="fa fa-minus-circle"></i> {{ manufacturer.name }}<input type="hidden" name="manufacturer[]" value="{{ manufacturer.manufacturer_id }}" /></div>{% endfor %}</div></div></div>
        <div class="form-group"><label class="col-sm-3 control-label">{{ text_display_settings }}</label><div class="col-sm-3"><select name="display_mode" id="input-display-mode" class="form-control"><option value="grid"{% if display_mode=='grid' %} selected{% endif %}>{{ text_grid }}</option><option value="carousel"{% if display_mode=='carousel' %} selected{% endif %}>{{ text_carousel }}</option></select></div><label class="col-sm-2 control-label">{{ entry_limit }}</label><div class="col-sm-2"><input type="number" min="1" max="100" name="limit" value="{{ limit }}" class="form-control" /></div></div>
        <div class="form-group"><label class="col-sm-3 control-label"><span data-toggle="tooltip" title="{{ help_columns }}">{{ entry_columns_desktop }}</span></label><div class="col-sm-2"><input type="number" min="2" max="10" name="columns_desktop" value="{{ columns_desktop }}" class="form-control" /></div><label class="col-sm-2 control-label">{{ entry_columns_tablet }}</label><div class="col-sm-2"><input type="number" min="1" max="8" name="columns_tablet" value="{{ columns_tablet }}" class="form-control" /></div><label class="col-sm-1 control-label">{{ entry_columns_mobile }}</label><div class="col-sm-2"><input type="number" min="1" max="3" name="columns_mobile" value="{{ columns_mobile }}" class="form-control" /></div></div>
        <div class="form-group"><label class="col-sm-3 control-label">{{ entry_width }} × {{ entry_height }}</label><div class="col-sm-2"><input type="number" min="40" max="1200" name="width" value="{{ width }}" class="form-control" /></div><div class="col-sm-2"><input type="number" min="40" max="1200" name="height" value="{{ height }}" class="form-control" /></div><label class="col-sm-2 control-label">{{ entry_image_fit }}</label><div class="col-sm-3"><select name="image_fit" class="form-control"><option value="contain"{% if image_fit=='contain' %} selected{% endif %}>{{ text_fit_contain }}</option><option value="cover"{% if image_fit=='cover' %} selected{% endif %}>{{ text_fit_cover }}</option></select></div></div>
        <div class="form-group ccp-carousel-only"><label class="col-sm-3 control-label">{{ entry_autoplay }}</label><div class="col-sm-2"><select name="autoplay" id="input-autoplay" class="form-control"><option value="1"{% if autoplay %} selected{% endif %}>{{ text_enabled }}</option><option value="0"{% if not autoplay %} selected{% endif %}>{{ text_disabled }}</option></select></div><label class="col-sm-3 control-label"><span data-toggle="tooltip" title="{{ help_autoplay_delay }}">{{ entry_autoplay_delay }}</span></label><div class="col-sm-2"><input type="number" min="1500" max="20000" step="500" name="autoplay_delay" value="{{ autoplay_delay }}" id="input-autoplay-delay" class="form-control" /></div></div>
        <div class="form-group ccp-carousel-only"><label class="col-sm-3 control-label">{{ entry_show_arrows }}</label><div class="col-sm-2"><select name="show_arrows" class="form-control"><option value="1"{% if show_arrows %} selected{% endif %}>{{ text_enabled }}</option><option value="0"{% if not show_arrows %} selected{% endif %}>{{ text_disabled }}</option></select></div><label class="col-sm-2 control-label">{{ entry_show_dots }}</label><div class="col-sm-2"><select name="show_dots" class="form-control"><option value="1"{% if show_dots %} selected{% endif %}>{{ text_enabled }}</option><option value="0"{% if not show_dots %} selected{% endif %}>{{ text_disabled }}</option></select></div><label class="col-sm-1 control-label">{{ entry_loop }}</label><div class="col-sm-2"><select name="loop" class="form-control"><option value="1"{% if loop %} selected{% endif %}>{{ text_enabled }}</option><option value="0"{% if not loop %} selected{% endif %}>{{ text_disabled }}</option></select></div></div>
        <div class="form-group ccp-carousel-only"><label class="col-sm-3 control-label"><span data-toggle="tooltip" title="{{ help_carousel_step }}">{{ entry_carousel_step }}</span></label><div class="col-sm-3"><select name="carousel_step" class="form-control"><option value="item"{% if carousel_step=='item' %} selected{% endif %}>{{ text_step_item }}</option><option value="page"{% if carousel_step=='page' %} selected{% endif %}>{{ text_step_page }}</option></select></div><label class="col-sm-2 control-label">{{ entry_sort }}</label><div class="col-sm-3"><select name="sort" class="form-control"><option value="sort_order"{% if sort=='sort_order' %} selected{% endif %}>{{ text_sort_order }}</option><option value="name"{% if sort=='name' %} selected{% endif %}>{{ text_sort_name }}</option></select></div></div>
        <div class="form-group"><label class="col-sm-3 control-label">{{ entry_show_name }}</label><div class="col-sm-2"><select name="show_name" class="form-control"><option value="1"{% if show_name %} selected{% endif %}>{{ text_enabled }}</option><option value="0"{% if not show_name %} selected{% endif %}>{{ text_disabled }}</option></select></div><label class="col-sm-3 control-label">{{ entry_show_image }}</label><div class="col-sm-2"><select name="show_image" class="form-control"><option value="1"{% if show_image %} selected{% endif %}>{{ text_enabled }}</option><option value="0"{% if not show_image %} selected{% endif %}>{{ text_disabled }}</option></select></div></div>
        <div class="form-group"><label class="col-sm-3 control-label">{{ entry_show_count }}</label><div class="col-sm-2"><select name="show_count" class="form-control"><option value="1"{% if show_count %} selected{% endif %}>{{ text_enabled }}</option><option value="0"{% if not show_count %} selected{% endif %}>{{ text_disabled }}</option></select></div><label class="col-sm-3 control-label">{{ entry_hide_empty }}</label><div class="col-sm-2"><select name="hide_empty" class="form-control"><option value="1"{% if hide_empty %} selected{% endif %}>{{ text_enabled }}</option><option value="0"{% if not hide_empty %} selected{% endif %}>{{ text_disabled }}</option></select></div></div>
        <div class="form-group"><label class="col-sm-3 control-label">{{ entry_hide_without_image }}</label><div class="col-sm-3"><select name="hide_without_image" class="form-control"><option value="1"{% if hide_without_image %} selected{% endif %}>{{ text_enabled }}</option><option value="0"{% if not hide_without_image %} selected{% endif %}>{{ text_disabled }}</option></select></div></div>
        <div class="form-group"><label class="col-sm-3 control-label">{{ entry_status }}</label><div class="col-sm-3"><select name="status" class="form-control"><option value="1"{% if status %} selected{% endif %}>{{ text_enabled }}</option><option value="0"{% if not status %} selected{% endif %}>{{ text_disabled }}</option></select></div></div>
      </form>
    </div></div>
  </div>
</div>
<script type="text/javascript">
function ccpManufacturerWallSource(){var v=$('#input-source').val();$('.ccp-source-selected').toggle(v==='selected');}$('#input-source').on('change',ccpManufacturerWallSource);ccpManufacturerWallSource();
$('#input-manufacturer').autocomplete({source:function(request,response){$.ajax({url:'index.php?route=catalog/manufacturer/autocomplete&user_token={{ user_token }}&filter_name='+encodeURIComponent(request),dataType:'json',success:function(json){response($.map(json,function(item){return{label:item.name,value:item.manufacturer_id};}));}});},select:function(item){$('#input-manufacturer').val('');$('#manufacturer-wall-manufacturer'+item.value).remove();$('#manufacturer-wall-manufacturers').append('<div id="manufacturer-wall-manufacturer'+item.value+'"><i class="fa fa-minus-circle"></i> '+item.label+'<input type="hidden" name="manufacturer[]" value="'+item.value+'" /></div>');}});$('#manufacturer-wall-manufacturers').on('click','.fa-minus-circle',function(){$(this).parent().remove();});
</script>
{{ footer }}
