{{ header }}{{ column_left }}
<div id="content" class="ccp-google-login-admin">
  <div class="page-header"><div class="container-fluid"><div class="pull-right">
    <button type="submit" form="form-google-login" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa fa-save"></i></button>
    <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default"><i class="fa fa-reply"></i></a>
  </div><h1>{{ heading_title }}</h1><ul class="breadcrumb">{% for breadcrumb in breadcrumbs %}<li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>{% endfor %}</ul></div></div>
  <div class="container-fluid">
    {% if error_warning %}<div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}<button type="button" class="close" data-dismiss="alert">&times;</button></div>{% endif %}
    <div class="panel panel-default" style="border-top:3px solid #0057d9">
      <div class="panel-heading"><h3 class="panel-title"><i class="fa-brands fa-google"></i> {{ text_edit }}</h3></div>
      <div class="panel-body">
        <div class="alert alert-info">{{ text_help }}</div>
        <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-google-login" class="form-horizontal">
          <div class="form-group"><label class="col-sm-3 control-label" for="input-status">{{ entry_status }}</label><div class="col-sm-9"><select name="module_google_login_status" id="input-status" class="form-control"><option value="1"{% if module_google_login_status %} selected{% endif %}>{{ text_enabled }}</option><option value="0"{% if not module_google_login_status %} selected{% endif %}>{{ text_disabled }}</option></select></div></div>
          <div class="form-group"><label class="col-sm-3 control-label" for="input-client-id">{{ entry_client_id }}</label><div class="col-sm-9"><input type="text" name="module_google_login_client_id" value="{{ module_google_login_client_id }}" id="input-client-id" class="form-control" autocomplete="off" /></div></div>
          <div class="form-group"><label class="col-sm-3 control-label" for="input-client-secret">{{ entry_client_secret }}</label><div class="col-sm-9"><div class="input-group"><input type="password" name="module_google_login_client_secret" value="{{ module_google_login_client_secret }}" id="input-client-secret" class="form-control" autocomplete="new-password" /><span class="input-group-btn"><button type="button" class="btn btn-default ccp-secret-toggle" data-target="#input-client-secret" title="{{ button_show_secret|e('html_attr') }}" aria-label="{{ button_show_secret|e('html_attr') }}"><i class="fa fa-eye"></i></button></span></div></div></div>
          <div class="form-group"><label class="col-sm-3 control-label" for="input-redirect">{{ entry_redirect_uri }}</label><div class="col-sm-9"><div class="input-group"><input type="text" value="{{ redirect_uri }}" id="input-redirect" class="form-control" readonly /><span class="input-group-btn"><button type="button" class="btn btn-default ccp-copy" data-target="#input-redirect" title="{{ button_copy|e('html_attr') }}" aria-label="{{ button_copy|e('html_attr') }}"><i class="fa fa-copy"></i></button></span></div></div></div>
          <div class="form-group"><label class="col-sm-3 control-label" for="input-auto-register">{{ entry_auto_register }}</label><div class="col-sm-9"><select name="module_google_login_auto_register" id="input-auto-register" class="form-control"><option value="1"{% if module_google_login_auto_register %} selected{% endif %}>{{ text_enabled }}</option><option value="0"{% if not module_google_login_auto_register %} selected{% endif %}>{{ text_disabled }}</option></select><p class="help-block">{{ help_auto_register }}</p></div></div>
          <div class="form-group"><label class="col-sm-3 control-label" for="input-show-login">{{ entry_show_login }}</label><div class="col-sm-9"><select name="module_google_login_show_login" id="input-show-login" class="form-control"><option value="1"{% if module_google_login_show_login %} selected{% endif %}>{{ text_enabled }}</option><option value="0"{% if not module_google_login_show_login %} selected{% endif %}>{{ text_disabled }}</option></select></div></div>
          <div class="form-group"><label class="col-sm-3 control-label" for="input-show-checkout">{{ entry_show_checkout }}</label><div class="col-sm-9"><select name="module_google_login_show_checkout" id="input-show-checkout" class="form-control"><option value="1"{% if module_google_login_show_checkout %} selected{% endif %}>{{ text_enabled }}</option><option value="0"{% if not module_google_login_show_checkout %} selected{% endif %}>{{ text_disabled }}</option></select><p class="help-block">{{ help_checkout }}</p></div></div>
        </form>
      </div>
    </div>
  </div>
</div>
<script type="text/javascript">
$('.ccp-secret-toggle').on('click',function(){var $i=$($(this).data('target'));$i.attr('type',$i.attr('type')==='password'?'text':'password');$(this).find('i').toggleClass('fa-eye fa-eye-slash');});
$('.ccp-copy').on('click',function(){var el=$($(this).data('target')).get(0);if(!el){return;}el.select();if(navigator.clipboard&&navigator.clipboard.writeText){navigator.clipboard.writeText(el.value);}else{document.execCommand('copy');}});
</script>
{{ footer }}
