{{ header }}{{ column_left }}
<div id="content" class="ccp-category-wall-admin">
  <div class="page-header"><div class="container-fluid"><div class="pull-right"><button type="submit" form="form-module" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa-solid fa-floppy-disk"></i></button> <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default"><i class="fa fa-reply"></i></a></div><h1>{{ heading_title }}</h1><ul class="breadcrumb">{% for breadcrumb in breadcrumbs %}<li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>{% endfor %}</ul></div></div>
  <div class="container-fluid">{% if error_warning %}<div class="alert alert-danger"><i class="fa-solid fa-circle-exclamation"></i> {{ error_warning }}</div>{% endif %}
    <div class="panel panel-default"><div class="panel-heading"><h3 class="panel-title"><i class="fa-solid fa-table-cells-large"></i> {{ text_edit }}</h3></div><div class="panel-body">
      <form action="{{ action }}" method="post" id="form-module" class="form-horizontal">
        <div class="form-group{% if error_name %} has-error{% endif %}"><label class="col-sm-3 control-label" for="input-name">{{ entry_name }}</label><div class="col-sm-9"><input type="text" name="name" value="{{ name }}" id="input-name" class="form-control" />{% if error_name %}<div class="text-danger">{{ error_name }}</div>{% endif %}</div></div>
        <div class="form-group"><label class="col-sm-3 control-label">{{ entry_heading }}</label><div class="col-sm-9">{% for language in languages %}<div class="input-group" style="margin-bottom:6px"><span class="input-group-addon"><img src="language/{{ language.code }}/{{ language.code }}.png" title="{{ language.name }}" /></span><input type="text" name="heading[{{ language.language_id }}]" value="{{ heading[language.language_id] is defined ? heading[language.language_id] : '' }}" class="form-control" /></div>{% endfor %}</div></div>
        <div class="form-group"><label class="col-sm-3 control-label" for="input-source">{{ entry_source }}</label><div class="col-sm-9"><select name="source" id="input-source" class="form-control"><option value="selected"{% if source=='selected' %} selected{% endif %}>{{ text_source_selected }}</option><option value="top"{% if source=='top' %} selected{% endif %}>{{ text_source_top }}</option><option value="children"{% if source=='children' %} selected{% endif %}>{{ text_source_children }}</option><option value="current"{% if source=='current' %} selected{% endif %}>{{ text_source_current }}</option></select></div></div>
        <div class="form-group ccp-source-selected"><label class="col-sm-3 control-label"><span data-toggle="tooltip" title="{{ help_category }}">{{ entry_category }}</span></label><div class="col-sm-9"><input type="text" id="input-category" class="form-control" autocomplete="off" /><div id="category-wall-categories" class="well well-sm" style="max-height:180px;overflow:auto;margin-top:6px">{% for category in categories %}<div id="category-wall-category{{ category.category_id }}" class="ccp-category-wall-selected-row" data-category-id="{{ category.category_id }}"><button type="button" class="btn btn-link btn-xs ccp-category-wall-remove" title="{{ button_remove|default('Remove') }}" aria-label="{{ button_remove|default('Remove') }}"><i class="fa fa-minus-circle"></i></button> <strong>{{ category.name }}</strong><input type="hidden" name="category[]" value="{{ category.category_id }}" /></div>{% endfor %}</div><div class="help-block">{{ help_category }}</div></div></div>
        <div class="form-group ccp-source-selected"><label class="col-sm-3 control-label"><span data-toggle="tooltip" title="{{ help_subcategories }}">{{ text_subcategories }}</span></label><div class="col-sm-9"><div id="category-wall-subcategories" class="ccp-category-wall-subcategories">{% for category in categories %}<div class="ccp-category-wall-subcategory-block" id="category-wall-subcategories-{{ category.category_id }}" data-category-id="{{ category.category_id }}"><div class="ccp-category-wall-subcategory-title">{{ category.name }}</div><div class="ccp-category-wall-subcategory-options">{% if category_subcategories[category.category_id] is defined and category_subcategories[category.category_id] %}{% for child in category_subcategories[category.category_id] %}<label class="checkbox-inline"><input type="checkbox" name="subcategory[{{ category.category_id }}][]" value="{{ child.category_id }}"{% if child.selected %} checked{% endif %}> {{ child.name }}</label>{% endfor %}{% else %}<span class="text-muted">—</span>{% endif %}</div></div>{% endfor %}</div><div class="help-block">{{ help_subcategories }}</div></div></div>
        <div class="form-group ccp-source-parent"><label class="col-sm-3 control-label"><span data-toggle="tooltip" title="{{ help_parent }}">{{ entry_parent }}</span></label><div class="col-sm-9"><input type="text" id="input-parent" value="{{ parent_name }}" class="form-control" autocomplete="off" /><input type="hidden" name="parent_id" value="{{ parent_id }}" /></div></div>
        <div class="form-group"><label class="col-sm-3 control-label" for="input-limit">{{ entry_limit }}</label><div class="col-sm-3"><input type="number" min="1" max="100" name="limit" value="{{ limit }}" id="input-limit" class="form-control" /></div></div>
        <div class="form-group"><label class="col-sm-3 control-label" for="input-subcategory-limit"><span data-toggle="tooltip" title="{{ help_subcategory_limit }}">{{ entry_subcategory_limit }}</span></label><div class="col-sm-3"><input type="number" min="1" max="30" name="subcategory_limit" value="{{ subcategory_limit }}" id="input-subcategory-limit" class="form-control" /><p class="help-block">{{ help_subcategory_limit }}</p></div></div>
        <fieldset class="ccp-native-module-display-settings"><legend>{{ text_display_settings }}</legend>
          <div class="form-group"><label class="col-sm-3 control-label" for="input-display-mode"><span data-toggle="tooltip" title="{{ help_display_mode }}">{{ entry_display_mode }}</span></label><div class="col-sm-3"><select name="display_mode" id="input-display-mode" class="form-control"><option value="grid"{% if display_mode == 'grid' %} selected{% endif %}>{{ text_grid }}</option><option value="carousel"{% if display_mode == 'carousel' %} selected{% endif %}>{{ text_carousel }}</option></select></div></div>
          <div class="form-group"><label class="col-sm-3 control-label" for="input-display-mode-mobile"><span data-toggle="tooltip" title="{{ help_display_mode_mobile }}">{{ entry_display_mode_mobile }}</span></label><div class="col-sm-3"><select name="display_mode_mobile" id="input-display-mode-mobile" class="form-control"><option value="inherit"{% if display_mode_mobile == 'inherit' %} selected{% endif %}>{{ text_mobile_same }}</option><option value="grid"{% if display_mode_mobile == 'grid' %} selected{% endif %}>{{ text_mobile_grid }}</option></select><p class="help-block">{{ help_display_mode_mobile }}</p></div></div>
          <div class="form-group ccp-carousel-only"><label class="col-sm-3 control-label">{{ entry_autoplay }}</label><div class="col-sm-2"><select name="autoplay" id="input-autoplay" class="form-control"><option value="1"{% if autoplay %} selected{% endif %}>{{ text_enabled }}</option><option value="0"{% if not autoplay %} selected{% endif %}>{{ text_disabled }}</option></select></div><label class="col-sm-2 control-label"><span data-toggle="tooltip" title="{{ help_autoplay_delay }}">{{ entry_autoplay_delay }}</span></label><div class="col-sm-2"><input type="number" min="1500" max="20000" step="500" name="autoplay_delay" value="{{ autoplay_delay }}" id="input-autoplay-delay" class="form-control" /></div></div>
          <div class="form-group ccp-carousel-only"><label class="col-sm-3 control-label">{{ entry_show_arrows }}</label><div class="col-sm-2"><select name="show_arrows" class="form-control"><option value="1"{% if show_arrows %} selected{% endif %}>{{ text_enabled }}</option><option value="0"{% if not show_arrows %} selected{% endif %}>{{ text_disabled }}</option></select></div><label class="col-sm-2 control-label">{{ entry_show_dots }}</label><div class="col-sm-2"><select name="show_dots" class="form-control"><option value="1"{% if show_dots %} selected{% endif %}>{{ text_enabled }}</option><option value="0"{% if not show_dots %} selected{% endif %}>{{ text_disabled }}</option></select></div><label class="col-sm-1 control-label">{{ entry_loop }}</label><div class="col-sm-2"><select name="loop" class="form-control"><option value="1"{% if loop %} selected{% endif %}>{{ text_enabled }}</option><option value="0"{% if not loop %} selected{% endif %}>{{ text_disabled }}</option></select></div></div>
        </fieldset>
        <div class="form-group"><label class="col-sm-3 control-label"><span data-toggle="tooltip" title="{{ help_columns }}">{{ entry_columns_desktop }}</span></label><div class="col-sm-2"><input type="number" min="2" max="8" name="columns_desktop" value="{{ columns_desktop }}" class="form-control" /></div><label class="col-sm-2 control-label">{{ entry_columns_tablet }}</label><div class="col-sm-2"><input type="number" min="1" max="6" name="columns_tablet" value="{{ columns_tablet }}" class="form-control" /></div><label class="col-sm-1 control-label">{{ entry_columns_mobile }}</label><div class="col-sm-2"><input type="number" min="1" max="3" name="columns_mobile" value="{{ columns_mobile }}" class="form-control" /></div></div>
        <div class="form-group ccp-carousel-only"><label class="col-sm-3 control-label"><span data-toggle="tooltip" title="{{ help_mobile_peek }}">{{ entry_mobile_peek }}</span></label><div class="col-sm-3"><select name="mobile_peek" class="form-control"><option value="0"{% if mobile_peek == '0' %} selected{% endif %}>{{ text_peek_off }}</option><option value="1.2"{% if mobile_peek == '1.2' %} selected{% endif %}>1.2</option><option value="1.3"{% if mobile_peek == '1.3' %} selected{% endif %}>1.3</option><option value="1.4"{% if mobile_peek == '1.4' %} selected{% endif %}>1.4</option></select></div></div>
        <div class="form-group"><label class="col-sm-3 control-label"><span data-toggle="tooltip" title="{{ help_image_mode }}">{{ entry_image_mode }}</span></label><div class="col-sm-4"><select name="image_mode" id="input-image-mode" class="form-control"><option value="image_text"{% if image_mode == 'image_text' %} selected{% endif %}>{{ text_image_text }}</option><option value="text_only"{% if image_mode == 'text_only' %} selected{% endif %}>{{ text_text_only }}</option></select></div></div>
        <div class="form-group ccp-image-only"><label class="col-sm-3 control-label">{{ entry_width }} × {{ entry_height }}</label><div class="col-sm-2"><input type="number" min="40" max="1600" name="width" value="{{ width }}" class="form-control" /></div><div class="col-sm-2"><input type="number" min="40" max="1600" name="height" value="{{ height }}" class="form-control" /></div><label class="col-sm-2 control-label">{{ entry_image_fit }}</label><div class="col-sm-3"><select name="image_fit" class="form-control"><option value="contain"{% if image_fit=='contain' %} selected{% endif %}>{{ text_fit_contain }}</option><option value="cover"{% if image_fit=='cover' %} selected{% endif %}>{{ text_fit_cover }}</option></select></div></div>
        <div class="form-group ccp-image-only"><label class="col-sm-3 control-label">{{ entry_width_mobile }} × {{ entry_height_mobile }}</label><div class="col-sm-2"><input type="number" min="40" max="1200" name="width_mobile" value="{{ width_mobile }}" class="form-control" /></div><div class="col-sm-2"><input type="number" min="40" max="1200" name="height_mobile" value="{{ height_mobile }}" class="form-control" /></div></div>
        <div class="form-group"><label class="col-sm-3 control-label">{{ entry_sort }}</label><div class="col-sm-3"><select name="sort" class="form-control"><option value="sort_order"{% if sort=='sort_order' %} selected{% endif %}>{{ text_sort_order }}</option><option value="name"{% if sort=='name' %} selected{% endif %}>{{ text_sort_name }}</option></select></div><label class="col-sm-2 control-label">{{ entry_show_count }}</label><div class="col-sm-1"><input type="checkbox" name="show_count" value="1"{% if show_count %} checked{% endif %} /></div><label class="col-sm-2 control-label">{{ entry_hide_empty }}</label><div class="col-sm-1"><input type="checkbox" name="hide_empty" value="1"{% if hide_empty %} checked{% endif %} /></div></div>
        <div class="form-group ccp-carousel-only"><label class="col-sm-3 control-label"><span data-toggle="tooltip" title="{{ help_carousel_step }}">{{ entry_carousel_step }}</span></label><div class="col-sm-3"><select name="carousel_step" class="form-control"><option value="item"{% if carousel_step == 'item' %} selected{% endif %}>{{ text_step_item }}</option><option value="page"{% if carousel_step == 'page' %} selected{% endif %}>{{ text_step_page }}</option></select></div></div>
        <div class="form-group"><label class="col-sm-3 control-label">{{ entry_status }}</label><div class="col-sm-3"><select name="status" class="form-control"><option value="1"{% if status %} selected{% endif %}>{{ text_enabled }}</option><option value="0"{% if not status %} selected{% endif %}>{{ text_disabled }}</option></select></div></div>
      </form>
    </div></div>
  </div>
</div>
<script type="text/javascript">
function ccpCategoryWallSource(){var v=$('#input-source').val();$('.ccp-source-selected').toggle(v==='selected');$('.ccp-source-parent').toggle(v==='children');}$('#input-source').on('change',ccpCategoryWallSource);ccpCategoryWallSource();
function ccpCategoryWallDisplay(){var carousel=$('#input-display-mode').val()==='carousel';$('.ccp-carousel-only').toggle(carousel);$('.ccp-image-only').toggle($('#input-image-mode').val()==='image_text');}$('#input-display-mode,#input-image-mode').on('change',ccpCategoryWallDisplay);ccpCategoryWallDisplay();
$('#input-category').autocomplete({source:function(request,response){$.ajax({url:'index.php?route=catalog/category/autocomplete&user_token={{ user_token }}&filter_name='+encodeURIComponent(request),dataType:'json',success:function(json){response($.map(json,function(item){return{label:item.name,value:item.category_id};}));}});},select:function(item){$('#input-category').val('');$('#category-wall-category'+item.value).remove();$('#category-wall-subcategories-'+item.value).remove();$('#category-wall-categories').append('<div id="category-wall-category'+item.value+'" class="ccp-category-wall-selected-row" data-category-id="'+item.value+'"><button type="button" class="btn btn-link btn-xs ccp-category-wall-remove" title="Remove"><i class="fa fa-minus-circle"></i></button> <strong>'+item.label+'</strong><input type="hidden" name="category[]" value="'+item.value+'" /></div>');ccpCategoryWallLoadSubcategories(item.value,item.label);}});
$('#input-parent').autocomplete({source:function(request,response){$.ajax({url:'index.php?route=catalog/category/autocomplete&user_token={{ user_token }}&filter_name='+encodeURIComponent(request),dataType:'json',success:function(json){response($.map(json,function(item){return{label:item.name,value:item.category_id};}));}});},select:function(item){$('#input-parent').val(item.label);$('input[name="parent_id"]').val(item.value);}});

function ccpCategoryWallLoadSubcategories(categoryId, categoryName) {
  var $wrap = $('#category-wall-subcategories-' + categoryId);
  if (!$wrap.length) {
    $wrap = $('<div>', {id:'category-wall-subcategories-' + categoryId, 'class':'ccp-category-wall-subcategory-block', 'data-category-id':categoryId})
      .append($('<div>', {'class':'ccp-category-wall-subcategory-title'}).text(categoryName))
      .append($('<div>', {'class':'ccp-category-wall-subcategory-options'}).append($('<span>', {'class':'text-muted'}).text('…')))
      .appendTo('#category-wall-subcategories');
  }
  $.ajax({
    url: 'index.php?route=extension/module/category_wall/subcategories&user_token={{ user_token }}&category_id=' + encodeURIComponent(categoryId),
    dataType: 'json',
    success: function(json) {
      var $options = $wrap.find('.ccp-category-wall-subcategory-options').empty();
      if (!json || json.error || !json.children || !json.children.length) {
        $options.append($('<span>', {'class':'text-muted'}).text('—'));
        return;
      }
      $.each(json.children, function(i, child) {
        var input = $('<input>', {type:'checkbox', name:'subcategory[' + categoryId + '][]', value:child.category_id});
        $('<label>', {'class':'checkbox-inline'}).append(input).append(document.createTextNode(' ' + child.name)).appendTo($options);
      });
    }
  });
}

$('#category-wall-categories').on('click', '.ccp-category-wall-remove', function() {
  var $row = $(this).closest('.ccp-category-wall-selected-row');
  var id = $row.data('category-id');
  $row.remove();
  $('#category-wall-subcategories-' + id).remove();
});
</script>
{{ footer }}
