{{ header }}{{ column_left }}
<div id="content" class="ccp-lost-url-report">
  <div class="page-header"><div class="container-fluid"><h1>{{ heading_title|e }} <span class="label label-primary">PRO</span> <small>{{ build|e }}</small></h1><p>CodeCart PRO</p></div></div>
  <div class="container-fluid">
    {% if error_warning %}<div class="alert alert-danger">{{ error_warning|e }}</div>{% endif %}
    {% if success %}<div class="alert alert-success">{{ success|e }}</div>{% endif %}
    <div class="panel panel-default"><div class="panel-heading"><strong>{{ heading_title|e }}</strong> <span class="label {{ enabled ? 'label-success' : 'label-default' }}">{{ enabled ? text_enabled|e : text_disabled|e }}</span></div><div class="panel-body">
      <p>{{ text_help|e }}</p><p class="text-muted">{{ text_privacy|e }}</p>
      <form action="{{ action|replace({'&amp;':'&'})|e }}" method="post" class="ccp-toolbar" onsubmit="return this.elements.cleanup_mode.value !== 'all' || !this.elements.enabled.checked || confirm('{{ text_confirm|e('js') }}');"><input type="hidden" name="action" value="settings"><label><input type="checkbox" name="enabled" value="1" {% if enabled %}checked{% endif %} {% if not can_modify %}disabled{% endif %}> {{ text_enabled|e }}</label><div><label for="input-days">{{ entry_days|e }}</label><select id="input-days" name="days" class="form-control" {% if not can_modify %}disabled{% endif %}>{% for value in [30,60,90] %}<option value="{{ value }}" {% if value == days %}selected{% endif %}>{{ value }} {{ text_days|e }}</option>{% endfor %}</select></div><div><label for="input-cleanup">{{ entry_cleanup_mode|e }}</label><select id="input-cleanup" name="cleanup_mode" class="form-control" {% if not can_modify %}disabled{% endif %}><option value="safe" {% if cleanup_mode == 'safe' %}selected{% endif %}>{{ text_cleanup_safe|e }}</option><option value="all" {% if cleanup_mode == 'all' %}selected{% endif %}>{{ text_cleanup_all|e }}</option></select></div> <button class="btn btn-primary" {% if not can_modify %}disabled{% endif %}><i class="fa fa-save"></i> {{ button_save|e }}</button></form>
      <p class="help-block">{{ help_retention|e }}</p><p class="help-block">{{ text_backup|e }} {{ text_cron|e }}</p>
      <details><summary>{{ text_bot_help|e }}</summary><p>{{ text_counts|e }}</p></details>
    </div></div>
    <div class="panel panel-default"><div class="panel-body">
      <form method="get" action="index.php" class="ccp-filters"><input type="hidden" name="route" value="report/lost_url"><input type="hidden" name="user_token" value="{{ user_token|e }}">
        <div><label for="input-store">{{ entry_store|e }}</label><select id="input-store" name="store_id" class="form-control">{% for store in stores %}<option value="{{ store.store_id }}" {% if store.store_id == store_id %}selected{% endif %}>{{ store.name|e }}</option>{% endfor %}</select></div>
        <div><label for="input-view">{{ entry_view|e }}</label><select id="input-view" name="view" class="form-control">{% for key in ['attention','doubtful','all','ignored','fixed'] %}<option value="{{ key }}" {% if key == view %}selected{% endif %}>{{ attribute(_context, 'text_' ~ key)|e }}</option>{% endfor %}</select></div>
        <div><label for="input-search">{{ entry_search|e }}</label><input id="input-search" name="search" value="{{ search|e }}" class="form-control" maxlength="200"></div><button class="btn btn-default"><i class="fa fa-filter"></i> {{ button_filter|e }}</button>
      </form>
    </div><div class="table-responsive"><table class="table table-bordered table-hover"><thead><tr><th><a href="{{ sort_url|replace({'&amp;':'&'})|e }}">{{ column_url|e }}</a></th><th><a href="{{ sort_browser_hits|replace({'&amp;':'&'})|e }}">{{ column_hits|e }}</a></th><th>{{ column_bots|e }}</th><th><a href="{{ sort_last_seen|replace({'&amp;':'&'})|e }}">{{ column_seen|e }}</a></th><th>{{ column_referrer|e }}</th></tr></thead><tbody>
    {% for row in rows %}<tr><td class="ccp-url"><code>{{ row.url|e }}</code><div><span class="label {{ row.status == 'fixed' ? 'label-success' : (row.status == 'ignored' ? 'label-default' : 'label-warning') }}">{{ attribute(_context, 'text_' ~ (row.status == 'new' ? 'attention' : row.status))|e }}</span> {{ column_language|e }}: {{ row.language_id }}</div>
      {% if can_modify and enabled %}<div class="ccp-row-actions"><form action="{{ action|replace({'&amp;':'&'})|e }}" method="post"><input type="hidden" name="id" value="{{ row.lost_url_id }}"><button name="action" value="{{ row.status == 'ignored' ? 'reopen' : 'ignore' }}" class="btn btn-default btn-sm">{{ row.status == 'ignored' ? button_reopen|e : button_ignore|e }}</button></form>
      {% if row.slug %}<details><summary>{{ button_redirect|e }}</summary><form action="{{ action|replace({'&amp;':'&'})|e }}" method="post"><input type="hidden" name="id" value="{{ row.lost_url_id }}"><input type="hidden" name="action" value="redirect"><label>{{ row.slug|e }} → <input name="target" class="form-control" required maxlength="191" pattern="[a-z0-9][a-z0-9_-]*" placeholder="{{ entry_target|e }}"></label><p class="help-block">{{ text_redirect_help|e }}</p><button class="btn btn-primary btn-sm" onclick="return confirm('{{ text_confirm|e('js') }}');">{{ button_redirect|e }}</button></form></details>{% endif %}</div>{% endif %}
    </td><td>{{ row.browser_hits }}</td><td>{{ row.bot_hits }}</td><td>{{ row.last_seen|e }}<br><small class="text-muted">{{ row.first_seen|e }}</small></td><td class="ccp-referrer">{{ row.referer|e }}</td></tr>{% else %}<tr><td colspan="5" class="text-center">{{ text_empty|e }}</td></tr>{% endfor %}
    </tbody></table></div><div class="panel-footer">{{ pagination }} <span class="text-muted">{{ total }}</span></div></div>
    {% if redirects %}<div class="panel panel-default"><div class="panel-heading">{{ text_redirects|e }}</div><div class="table-responsive"><table class="table table-bordered"><tbody>{% for rule in redirects %}<tr><td><code>{{ rule.old_slug|e }}</code> → <code>{{ rule.new_slug|e }}</code></td><td>{{ column_language|e }}: {{ rule.language_id }}</td><td>{% if can_modify and enabled %}<form action="{{ action|replace({'&amp;':'&'})|e }}" method="post"><input type="hidden" name="id" value="{{ rule.redirect_id }}"><button class="btn btn-danger btn-sm" name="action" value="delete_redirect" onclick="return confirm('{{ text_confirm|e('js') }}');">{{ button_delete|e }}</button></form>{% endif %}</td></tr>{% endfor %}</tbody></table></div><div class="panel-footer">{{ redirect_pagination }}</div></div>{% endif %}
  </div>
</div>{{ footer }}
