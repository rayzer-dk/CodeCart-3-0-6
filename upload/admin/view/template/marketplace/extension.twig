{{ header }}{{ column_left }}

<div id="content">
<style>

/* Extension tables: safe content width, readable headings, predictable geometry. */
#extension, #extension fieldset, #extension .table-responsive {min-width:0;max-width:100%;box-sizing:border-box;}
#extension .table-responsive {display:block;width:100%;overflow-x:auto;overflow-y:hidden;-webkit-overflow-scrolling:touch;}
#extension .ccp-extension-table {width:100%;min-width:960px;margin:0;table-layout:fixed;border-collapse:collapse;}
#extension .ccp-extension-cols-4 {min-width:720px;}
#extension .ccp-extension-cols-4 th:nth-child(1) {width:54%;}
#extension .ccp-extension-cols-4 th:nth-child(2) {width:14%;}
#extension .ccp-extension-cols-4 th:nth-child(3) {width:20%;}
#extension .ccp-extension-cols-4 th:nth-child(4) {width:12%;}
#extension .ccp-extension-status{display:inline-block;min-width:94px;padding:5px 10px;border-radius:5px;font-weight:600;font-size:12px;text-align:center;}
#extension .ccp-extension-status-on{color:#126434;background:#d9f5e3;border:1px solid #a9e7bb;}
#extension .ccp-extension-status-off{color:#8c3430;background:#fce5e3;border:1px solid #f1c5c2;}
html.ccp-admin-dark #extension .ccp-extension-status-on{color:#a5e6b8;background:#19402a;border-color:#28613c;}
html.ccp-admin-dark #extension .ccp-extension-status-off{color:#ffb5b1;background:#502b2d;border-color:#773e3f;}
#extension .ccp-extension-cols-7 {min-width:1050px;}
#extension .ccp-extension-cols-8 {min-width:1140px;}
#extension .ccp-extension-table thead {border-top:3px solid #0057d9;}
#extension .ccp-extension-table thead th {vertical-align:middle;background:#f8fbff;border-right:1px solid #d9e1ed;padding:9px 7px;font-weight:600;white-space:normal;}
#extension .ccp-extension-table thead th:last-child {text-align:center;}
#extension .ccp-extension-table .ccp-extension-sort {display:inline-flex;align-items:center;justify-content:center;gap:4px;max-width:100%;min-width:0;background:transparent;color:#1457a7;border:0;padding:3px 0;font:inherit;font-weight:600;line-height:1.3;text-align:center;white-space:normal;cursor:pointer;}
#extension .ccp-extension-table thead th:first-child .ccp-extension-sort {justify-content:flex-start;text-align:left;}
#extension .ccp-extension-table .ccp-extension-sort:hover,#extension .ccp-extension-table .ccp-extension-sort:focus {color:#00449f;text-decoration:underline;}
#extension .ccp-extension-table .ccp-extension-sort-label {flex:0 1 auto;min-width:0;overflow-wrap:normal;}
#extension .ccp-extension-table .ccp-extension-sort i {flex:0 0 auto;opacity:.8;margin:0;}
#extension .ccp-extension-table tbody td {vertical-align:middle;overflow:hidden;text-overflow:ellipsis;}
#extension .ccp-extension-table tbody td:first-child {text-align:left;overflow-wrap:anywhere;}
#extension .ccp-extension-table tbody td:not(:first-child):not(:last-child) {text-align:center;}
#extension .ccp-extension-table tbody .ccp-extension-date {white-space:nowrap;font-variant-numeric:tabular-nums;}
#extension .ccp-extension-table tbody td:last-child {text-align:center;white-space:nowrap;overflow:visible;padding:7px 3px;}
#extension .ccp-extension-table tbody td:last-child .btn {margin:0 1px;}
#extension .ccp-extension-table .ccp-extension-child td {background:#f7f9fc;}
#extension .ccp-extension-cols-6 th:nth-child(1) {width:35%;}
#extension .ccp-extension-cols-6 th:nth-child(2) {width:11%;}
#extension .ccp-extension-cols-6 th:nth-child(3) {width:12%;}
#extension .ccp-extension-cols-6 th:nth-child(4) {width:15%;}
#extension .ccp-extension-cols-6 th:nth-child(5) {width:15%;}
#extension .ccp-extension-cols-6 th:nth-child(6) {width:12%;}
#extension .ccp-extension-cols-7 th:nth-child(1) {width:30%;}
#extension .ccp-extension-cols-7 th:nth-child(2) {width:10%;}
#extension .ccp-extension-cols-7 th:nth-child(3) {width:9%;}
#extension .ccp-extension-cols-7 th:nth-child(4) {width:10%;}
#extension .ccp-extension-cols-7 th:nth-child(5) {width:15%;}
#extension .ccp-extension-cols-7 th:nth-child(6) {width:15%;}
#extension .ccp-extension-cols-7 th:nth-child(7) {width:11%;}
#extension .ccp-extension-cols-8 th:nth-child(1) {width:25%;}
#extension .ccp-extension-cols-8 th:nth-child(2) {width:9%;}
#extension .ccp-extension-cols-8 th:nth-child(3) {width:10%;}
#extension .ccp-extension-cols-8 th:nth-child(4) {width:8%;}
#extension .ccp-extension-cols-8 th:nth-child(5) {width:10%;}
#extension .ccp-extension-cols-8 th:nth-child(6) {width:13%;}
#extension .ccp-extension-cols-8 th:nth-child(7) {width:13%;}
#extension .ccp-extension-cols-8 th:nth-child(8) {width:12%;}
html.ccp-admin-dark #extension .ccp-extension-table thead th {background:#1d2936;border-right-color:#384757;}
html.ccp-admin-dark #extension .ccp-extension-table .ccp-extension-sort {color:#9fcaff;}
html.ccp-admin-dark #extension .ccp-extension-table .ccp-extension-child td {background:#1b2632;}
html.ccp-admin-dark #extension .ccp-extension-table .text-muted {color:#a1b0c0;}
</style>
<script src="view/javascript/codecart-extension-sort.js?v=3.0.6.0-227"></script>
  <div class="page-header">
    <div class="container-fluid">
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
        <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>
  <div class="container-fluid">
    <div class="panel panel-default">
      <div class="panel-heading">
        <h3 class="panel-title"><i class="fa fa-puzzle-piece"></i> {{ text_list }}</h3>
      </div>
      <div class="panel-body">
        <fieldset>
          <legend>{{ text_type }}</legend>
          <div class="well">
            <div class="input-group">
              <select name="type" class="form-control">
                {% for category in categories %}
                {% if type == category.code %}
                <option value="{{ category.href }}" selected="selected">{{ category.text }}</option>
                {% else %}
                <option value="{{ category.href }}">{{ category.text }}</option>
                {% endif %}
                {% endfor %}
              </select>
              <span class="input-group-addon"><i class="fa fa-filter"></i> {{ text_filter }}</span>
            </div>
          </div>
        </fieldset>
        <div id="extension"></div>
      </div>
    </div>
  </div>
  {% if categories %}
  <script type="text/javascript"><!--
$('select[name="type"]').on('change', function() {
	$.ajax({
		url: $('select[name="type"]').val(),
		dataType: 'html',
		beforeSend: function() {
			$('.fa-filter').addClass('fa-circle-o-notch fa-spin');
			$('.fa-filter').removeClass('fa-filter');
			$('select[name=\'type\']').prop('disabled', true);
		},
		complete: function() {
			$('.fa-circle-o-notch').addClass('fa-filter');
			$('.fa-circle-o-notch').removeClass('fa-circle-o-notch fa-spin');
			$('select[name=\'type\']').prop('disabled', false);
		},
		success: function(html) {
			$('#extension').html(html);
            if (window.CodeCartExtensionSort) { window.CodeCartExtensionSort.apply(); }
		},
		error: function(xhr, ajaxOptions, thrownError) {
			alert(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
		}
	});
});

$('select[name="type"]').trigger('change');

$('#extension').on('click', '.btn-success', function(e) {
	e.preventDefault();
	
	var element = this;

	$.ajax({
		url: $(element).attr('href'),
		dataType: 'html',
		beforeSend: function() {
			$(element).button('loading');
		},
		complete: function() {
			$(element).button('reset');
		},
		success: function(html) {
			$('#extension').html(html);
            if (window.CodeCartExtensionSort) { window.CodeCartExtensionSort.apply(); }
		},
		error: function(xhr, ajaxOptions, thrownError) {
			alert(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
		}
	});
});

$('#extension').on('click', '.btn-danger, .btn-warning', function(e) {
	e.preventDefault();
	
	if (confirm('{{ text_confirm }}')) {
		var element = this;
	
		$.ajax({
			url: $(element).attr('href'),
			dataType: 'html',
			beforeSend: function() {
				$(element).button('loading');
			},
			complete: function() {
				$(element).button('reset');
			},
			success: function(html) {
				// refresh menu and extension list
				$.ajax({
					url: 'index.php?route=marketplace/extension/refreshMenu&user_token={{ user_token }}',
					dataType: 'html',
					success: function(html) {
						if (html) {
							$('#column-left').replaceWith(html);
						}
					},
					complete: function() {
						$('select[name="type"]').trigger('change');
					},
					error: function(xhr, ajaxOptions, thrownError) {
						alert(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
					}
				});
			},
			error: function(xhr, ajaxOptions, thrownError) {
				alert(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
			}
		});
	}
});
//--></script>
  {% endif %}
</div>
{{ footer }} 