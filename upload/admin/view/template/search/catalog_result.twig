<div class="oc-search-result-list">
  {% if can_products %}
  <div class="oc-search-group">
    <strong>{{ text_products }}</strong>
    {% if products %}
      {% for product in products %}
      <a href="{{ product.url }}" class="ccp-search-rich-row">
        <img src="{{ product.image }}" alt="" />
        <span class="ccp-search-rich-copy">
          <span class="ccp-search-rich-title">{{ product.name }}</span>
          <small>{% if product.model %}{{ product.model }}{% endif %}{% if product.sku %}{% if product.model %} · {% endif %}{{ product.sku }}{% endif %}</small>
        </span>
      </a>
      {% endfor %}
    {% else %}<div class="oc-search-empty">{{ text_no_result }}</div>{% endif %}
  </div>
  {% endif %}

  {% if can_categories %}
  <div class="oc-search-group">
    <strong>{{ text_categories }}</strong>
    {% if categories %}
      {% for category in categories %}
      <a href="{{ category.url }}" class="ccp-search-rich-row"><img src="{{ category.image }}" alt="" /><span class="ccp-search-rich-copy"><span class="ccp-search-rich-title">{{ category.name }}</span></span></a>
      {% endfor %}
    {% else %}<div class="oc-search-empty">{{ text_no_result }}</div>{% endif %}
  </div>
  {% endif %}

  {% if can_manufacturers %}
  <div class="oc-search-group">
    <strong>{{ text_manufacturers }}</strong>
    {% if manufacturers %}
      {% for manufacturer in manufacturers %}
      <a href="{{ manufacturer.url }}" class="ccp-search-rich-row"><img src="{{ manufacturer.image }}" alt="" /><span class="ccp-search-rich-copy"><span class="ccp-search-rich-title">{{ manufacturer.name }}</span></span></a>
      {% endfor %}
    {% else %}<div class="oc-search-empty">{{ text_no_result }}</div>{% endif %}
  </div>
  {% endif %}
</div>
