<div class="oc-search-result-list">
  <div class="oc-search-group">
    <strong>{{ text_orders }}</strong>
    {% if orders %}
      {% for order in orders %}
      <a href="{{ order.url }}" class="ccp-search-rich-row">
        <i class="fa fa-money fa-fw"></i>
        <span class="ccp-search-rich-copy">
          <span class="ccp-search-rich-title">{{ text_order_id }}{{ order.order_id }}{% if order.customer is defined and order.customer|trim != '' %} · {{ order.customer }}{% endif %}</span>
          <small>{{ order.email }}{% if order.telephone %} · {{ order.telephone }}{% endif %} · {{ order.date_added }}</small>
        </span>
      </a>
      {% endfor %}
    {% else %}
      <div class="oc-search-empty">{{ text_no_result }}</div>
    {% endif %}
  </div>
</div>
