<div class="oc-search-result-list">
  {% if information %}
  <div class="oc-search-group">
    <strong>{{ text_information }}</strong>
    {% for item in information %}
    <a href="{{ item.url }}" class="ccp-search-rich-row">
      <i class="fa fa-info-circle fa-fw"></i>
      <span class="ccp-search-rich-copy"><span class="ccp-search-rich-title">{{ item.title }}</span></span>
    </a>
    {% endfor %}
  </div>
  {% endif %}

  {% if articles %}
  <div class="oc-search-group">
    <strong>{{ text_articles }}</strong>
    {% for item in articles %}
    <a href="{{ item.url }}" class="ccp-search-rich-row">
      <i class="fa fa-newspaper-o fa-fw"></i>
      <span class="ccp-search-rich-copy"><span class="ccp-search-rich-title">{{ item.name }}</span></span>
    </a>
    {% endfor %}
  </div>
  {% endif %}

  {% if modules %}
  <div class="oc-search-group">
    <strong>{{ text_modules }}</strong>
    {% for item in modules %}
    <a href="{{ item.url }}" class="ccp-search-rich-row">
      <i class="fa fa-puzzle-piece fa-fw"></i>
      <span class="ccp-search-rich-copy">
        <span class="ccp-search-rich-title">{{ item.title }}</span>
        {% if item.name %}<small>{{ text_module_instance }}: {{ item.name }}</small>{% endif %}
        <code>{{ item.code }}{% if item.module_id %} #{{ item.module_id }}{% endif %}</code>
      </span>
    </a>
    {% endfor %}
  </div>
  {% endif %}

  {% if not information and not articles and not modules %}<div class="oc-search-empty">{{ text_no_result }}</div>{% endif %}
</div>
