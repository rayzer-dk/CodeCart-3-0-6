<nav id="column-left">
  <div id="navigation"><span class="fa fa-bars"></span> {{ text_navigation }}</div>
  <ul id="menu">
    {% set i = 0 %}
    {% for menu in menus %}
    <li id="{{ menu.id }}">
        {% if menu.href %}<a href="{{ menu.href }}" title="{{ menu.name }}"><i class="fa {{ menu.icon }} fw"></i><span class="menu-label">{{ menu.name }}</span></a>{% else %}<a href="#collapse{{ i }}" data-toggle="collapse" class="parent collapsed" title="{{ menu.name }}"><i class="fa {{ menu.icon }} fw"></i><span class="menu-label">{{ menu.name }}</span></a>{% endif %}
        {% if menu.children %}
          <ul id="collapse{{ i }}" class="collapse">
            {% set j = 0 %}
            {% for children_1 in menu.children %}
              <li>{% if children_1.href %}
                  <a href="{{ children_1.href }}">{{ children_1.name }}</a>
                {% else %}
                  <a href="#collapse{{ i }}-{{ j }}" data-toggle="collapse" class="parent collapsed">{{ children_1.name }}</a>
                {% endif %}

                {% if children_1.children %}
                  <ul id="collapse{{ i }}-{{ j }}" class="collapse">
                    {% set k = 0 %}
                    {% for children_2 in children_1.children %}
                      <li>{% if children_2.href %}
                          <a href="{{ children_2.href }}">{{ children_2.name }}</a>
                        {% else %}
                          <a href="#collapse-{{ i }}-{{ j }}-{{ k }}" data-toggle="collapse" class="parent collapsed">{{ children_2.name }}</a>
                        {% endif %}
                        {% if children_2.children %}
                          <ul id="collapse-{{ i }}-{{ j }}-{{ k }}" class="collapse">
                            {% for children_3 in children_2.children %}
                              <li><a href="{{ children_3.href }}">{{ children_3.name }}</a></li>
                            {% endfor %}
                          </ul>
                        {% endif %}</li>
                      {% set k = k + 1 %}
                    {% endfor %}
                  </ul>
                {% endif %} </li>
              {% set j = j + 1 %}
            {% endfor %}
          </ul>
        {% endif %}
      </li>
    {% set i = i + 1 %}
    {% endfor %}
    {% if product_stats %}
    <li id="menu-product-stats">
      <a href="#stats" class="parent collapsed" data-toggle="collapse" aria-expanded="false" aria-controls="stats" aria-label="{{ text_product_stats }}" title="{{ text_product_stats }}"><i class="fa fa-bar-chart fw" aria-hidden="true"></i><span class="menu-label">{{ text_product_stats }}</span></a>
      <section id="stats" class="collapse" aria-label="{{ text_product_stats }}">
        <h2 class="stats-title">{{ text_product_stats }}</h2>
        <ul>
          {% for stat in product_stats %}
          <li data-stat="{{ stat.key }}">
            {% if stat.key == 'small_image' %}<div class="stats-photo-row">{% endif %}
            <a href="{{ stat.href }}" class="stats-link"{% if stat.current %} aria-current="page"{% endif %}{% if not stat.ready %} hidden{% endif %}>
              <span>{{ stat.label|e }}</span><span class="stats-count">{{ stat.count }}/{{ stat.total }} ({{ stat.percent }}%)</span>
            </a>
            {% if not stat.ready %}
            <span class="stats-link"><span>{{ stat.label|e }}</span><span class="stats-count">&ndash;</span></span>
            {% endif %}
            {% if stat.key == 'small_image' %}
              {% if photo_scan_url %}
              <button type="button" class="btn btn-xs stats-photo-button" id="button-product-photo-scan"
                title="{{ button_stats_scan|e('html_attr') }}" aria-label="{{ button_stats_scan|e('html_attr') }}"
                data-url="{{ photo_scan_url }}"
                data-progress="{{ text_stats_scan_progress|e('html_attr') }}"
                data-complete="{{ text_stats_scan_complete|e('html_attr') }}"
                data-error="{{ text_stats_scan_error|e('html_attr') }}">
                <i class="fa fa-refresh" aria-hidden="true"></i>
              </button>
              {% endif %}
            </div>
            {% endif %}
            <div class="progress" aria-hidden="true"{% if not stat.ready %} hidden{% endif %}>
              <div class="progress-bar{% if stat.key == 'enabled' %} progress-bar-success{% elseif stat.key == 'disabled' %} progress-bar-danger{% elseif stat.key == 'out_of_stock' %} progress-bar-warning{% endif %}" style="width: {{ stat.percent }}%"></div>
            </div>
          </li>
          {% endfor %}
        </ul>
        {% if photo_scan_url %}
        <p id="product-photo-scan-progress" role="status" aria-live="polite"></p>
        <script src="view/javascript/codecart/product-photo-scan.js?v=2.3.18" defer></script>
        {% endif %}
      </section>
    </li>
    {% endif %}
  </ul>
</nav>
