{{ header }}<div class="container" style="max-width:560px;margin:50px auto;"><div class="panel panel-default"><div class="panel-heading"><h3 class="panel-title"><i class="fa fa-shield"></i> {{ heading_title }}</h3></div><div class="panel-body">{% if error_warning %}<div class="alert alert-danger">{{ error_warning }}</div>{% endif %}<p>{{ text_instruction }}</p><form action="{{ action }}" method="post"><div class="form-group"><label for="input-code">{{ entry_code }}</label><input type="text" name="code" value="" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" autocomplete="one-time-code" id="input-code" class="form-control" autofocus></div><button type="submit" class="btn btn-primary"><i class="fa fa-check"></i> {{ button_verify }}</button> <a href="{{ logout }}" class="btn btn-default">{{ text_logout }}</a></form></div></div></div>{{ footer }}
