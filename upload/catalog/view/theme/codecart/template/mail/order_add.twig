<!DOCTYPE html PUBLIC "-//W3C//DTD HTML 4.01//EN" "http://www.w3.org/TR/1999/REC-html401-19991224/strict.dtd">
<html>
<head>
<meta http-equiv="Content-Type" content="text/html; charset=utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0"><style>
@media only screen and (max-width:620px){.ccp-wrap{width:100%!important;max-width:100%!important}.ccp-pad{padding:18px 14px!important}.ccp-stack,.ccp-stack td{display:block!important;width:100%!important;box-sizing:border-box!important}.ccp-mobile-center{text-align:center!important}.ccp-hide-mobile{display:none!important}.ccp-product-table thead{display:none!important}.ccp-product-table,.ccp-product-table tbody,.ccp-product-table tr,.ccp-product-table td{display:block!important;width:100%!important;box-sizing:border-box!important}.ccp-product-table tr{border-bottom:1px solid #e5e7eb!important;padding:10px 0!important}.ccp-product-table td{border:0!important;text-align:left!important;padding:6px 10px!important}.ccp-product-table td:before{display:inline-block!important;min-width:92px;font-weight:700;color:#667085}.ccp-product-table td:nth-child(2):before{content:'Model: '}.ccp-product-table td:nth-child(3):before{content:'Qty: '}.ccp-product-table td:nth-child(4):before{content:'Price: '}.ccp-product-table td:nth-child(5):before{content:'Total: '}.ccp-btn{display:block!important;width:100%!important;box-sizing:border-box!important;text-align:center!important}.ccp-address{margin-bottom:12px!important}.ccp-logo{max-width:300px!important;height:auto!important}}
</style>
<title>{{ title }}</title>
</head>
<body style="margin:0; padding:24px 12px; background:#f4f6f8; font-family:Arial, Helvetica, sans-serif; font-size:14px; line-height:1.5; color:#1f2937;">
<div style="width:100%; max-width:640px; margin:0 auto; background:#ffffff; border:1px solid #e5e7eb; border-radius:8px; padding:20px; box-sizing:border-box;"><table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%; border-collapse:collapse;"><tr><td style="padding:0 0 20px 0;"><div style="width:100%; max-width:600px; min-height:100px; background:#ffffff; border:1px solid #edf1f5; border-radius:8px; box-sizing:border-box; padding:10px; text-align:left;"><a href="{{ store_url }}" title="{{ store_name }}" style="display:block; text-decoration:none;"><img src="{{ logo }}" alt="{{ store_name }}" width="{{ logo_width }}" height="{{ logo_height }}" style="display:block; width:{{ logo_width }}px; height:{{ logo_height }}px; max-width:100%; border:0; outline:none; text-decoration:none;" /></a></div></td></tr></table>
  <p style="margin-top: 0px; margin-bottom: 20px;">{{ text_greeting }}</p>
  {% if customer_id %}
  <p style="margin-top: 0px; margin-bottom: 20px;">{{ text_link }}</p>
  <p style="margin-top: 0px; margin-bottom: 20px;"><a href="{{ link }}">{{ link }}</a></p>
  {% endif %}
  {% if download %}
  <p style="margin-top: 0px; margin-bottom: 20px;">{{ text_download }}</p>
  <p style="margin-top: 0px; margin-bottom: 20px;"><a href="{{ download }}">{{ download }}</a></p>
  {% endif %}
  <table class="ccp-product-table" style="border-collapse: collapse; width: 100%; border: 1px solid #dfe4ea; margin-bottom: 20px; table-layout:fixed;">
    <thead>
      <tr>
        <td style="font-size: 13px; border-right: 1px solid #dfe4ea; border-bottom: 1px solid #dfe4ea; background-color: #f3f6f9; font-weight: bold; text-align: left; padding: 10px; color: #222222;" colspan="2">{{ text_order_detail }}</td>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td style="font-size: 13px;	border-right: 1px solid #dfe4ea; border-bottom: 1px solid #dfe4ea; text-align: left; padding: 10px;"><b>{{ text_order_id }}</b> {{ order_id }}<br/>
          <b>{{ text_date_added }}</b> {{ date_added }}<br/>
          <b>{{ text_payment_method }}</b> {{ payment_method }}<br/>
          {% if shipping_method %} <b>{{ text_shipping_method }}</b> {{ shipping_method }}
          {% endif %}</td>
        <td style="font-size: 13px;	border-right: 1px solid #dfe4ea; border-bottom: 1px solid #dfe4ea; text-align: left; padding: 10px;"><b>{{ text_email }}</b> {{ email }}<br/>
          <b>{{ text_telephone }}</b> {{ telephone }}<br/>
          <b>{{ text_ip }}</b> {{ ip }}<br/>
          <b>{{ text_order_status }}</b> {{ order_status }}<br/></td>
      </tr>
    </tbody>
  </table>
  {% if comment %}
  <table style="border-collapse: collapse; width: 100%; border: 1px solid #dfe4ea; margin-bottom: 20px;">
    <thead>
      <tr>
        <td style="font-size: 13px; border-right: 1px solid #dfe4ea; border-bottom: 1px solid #dfe4ea; background-color: #f3f6f9; font-weight: bold; text-align: left; padding: 10px; color: #222222;">{{ text_instruction }}</td>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td style="font-size: 13px;	border-right: 1px solid #dfe4ea; border-bottom: 1px solid #dfe4ea; text-align: left; padding: 10px;">{{ comment }}</td>
      </tr>
    </tbody>
  </table>
  {% endif %}
  <table style="border-collapse: collapse; width: 100%; border: 1px solid #dfe4ea; margin-bottom: 20px;">
    <thead>
      <tr>
        <td style="font-size: 13px; border-right: 1px solid #dfe4ea; border-bottom: 1px solid #dfe4ea; background-color: #f3f6f9; font-weight: bold; text-align: left; padding: 10px; color: #222222;">{{ text_payment_address }}</td>
        {% if shipping_address %}
        <td style="font-size: 13px; border-right: 1px solid #dfe4ea; border-bottom: 1px solid #dfe4ea; background-color: #f3f6f9; font-weight: bold; text-align: left; padding: 10px; color: #222222;">{{ text_shipping_address }}</td>
        {% endif %} </tr>
    </thead>
    <tbody>
      <tr>
        <td style="font-size: 13px;	border-right: 1px solid #dfe4ea; border-bottom: 1px solid #dfe4ea; text-align: left; padding: 10px;">{{ payment_address }}</td>
        {% if shipping_address %}
        <td style="font-size: 13px;	border-right: 1px solid #dfe4ea; border-bottom: 1px solid #dfe4ea; text-align: left; padding: 10px;">{{ shipping_address }}</td>
        {% endif %} </tr>
    </tbody>
  </table>
  <table style="border-collapse: collapse; width: 100%; border: 1px solid #dfe4ea; margin-bottom: 20px;">
    <thead>
      <tr>
        <td style="font-size: 13px; border-right: 1px solid #dfe4ea; border-bottom: 1px solid #dfe4ea; background-color: #f3f6f9; font-weight: bold; text-align: left; padding: 10px; color: #222222;">{{ text_product }}</td>
        <td style="font-size: 13px; border-right: 1px solid #dfe4ea; border-bottom: 1px solid #dfe4ea; background-color: #f3f6f9; font-weight: bold; text-align: left; padding: 10px; color: #222222;">{{ text_model }}</td>
        <td style="font-size: 13px; border-right: 1px solid #dfe4ea; border-bottom: 1px solid #dfe4ea; background-color: #f3f6f9; font-weight: bold; text-align: right; padding: 10px; color: #222222;">{{ text_quantity }}</td>
        <td style="font-size: 13px; border-right: 1px solid #dfe4ea; border-bottom: 1px solid #dfe4ea; background-color: #f3f6f9; font-weight: bold; text-align: right; padding: 10px; color: #222222;">{{ text_price }}</td>
        <td style="font-size: 13px; border-right: 1px solid #dfe4ea; border-bottom: 1px solid #dfe4ea; background-color: #f3f6f9; font-weight: bold; text-align: right; padding: 10px; color: #222222;">{{ text_total }}</td>
      </tr>
    </thead>
    <tbody>
    
    {% for product in products %}
    <tr>
      <td style="font-size:13px; border-right:1px solid #dfe4ea; border-bottom:1px solid #dfe4ea; text-align:left; padding:10px;">
        <table role="presentation" style="border-collapse:collapse; width:100%;"><tr>
          {% if product.image %}<td style="width:72px; vertical-align:top; padding:0 10px 0 0;"><a href="{{ product.href }}" style="text-decoration:none;"><img src="{{ product.image }}" alt="{{ product.name }}" width="64" height="64" style="display:block; width:64px; height:64px; object-fit:contain; border:1px solid #edf1f5; border-radius:6px; background:#fff;" /></a></td>{% endif %}
          <td style="vertical-align:top; padding:0;">{% if product.href %}<a href="{{ product.href }}" style="color:#0b6fd3; font-weight:700; text-decoration:none;">{{ product.name }}</a>{% else %}<strong>{{ product.name }}</strong>{% endif %}
            {% for option in product.option %}<br/><small style="color:#667085;">{{ option.name }}: {{ option.value }}</small>{% endfor %}
          </td>
        </tr></table>
      </td>
      <td style="font-size: 13px; border-right: 1px solid #dfe4ea; border-bottom: 1px solid #dfe4ea; text-align: left; padding: 10px;">{{ product.model }}</td>
      <td style="font-size: 13px;	border-right: 1px solid #dfe4ea; border-bottom: 1px solid #dfe4ea; text-align: right; padding: 10px;">{{ product.quantity }}</td>
      <td style="font-size: 13px;	border-right: 1px solid #dfe4ea; border-bottom: 1px solid #dfe4ea; text-align: right; padding: 10px;">{{ product.price }}</td>
      <td style="font-size: 13px;	border-right: 1px solid #dfe4ea; border-bottom: 1px solid #dfe4ea; text-align: right; padding: 10px;">{{ product.total }}</td>
    </tr>
    {% endfor %}
    {% for voucher in vouchers %}
    <tr>
      <td style="font-size: 13px;	border-right: 1px solid #dfe4ea; border-bottom: 1px solid #dfe4ea; text-align: left; padding: 10px;">{{ voucher.description }}</td>
      <td style="font-size: 13px;	border-right: 1px solid #dfe4ea; border-bottom: 1px solid #dfe4ea; text-align: left; padding: 10px;"></td>
      <td style="font-size: 13px;	border-right: 1px solid #dfe4ea; border-bottom: 1px solid #dfe4ea; text-align: right; padding: 10px;">1</td>
      <td style="font-size: 13px;	border-right: 1px solid #dfe4ea; border-bottom: 1px solid #dfe4ea; text-align: right; padding: 10px;">{{ voucher.amount }}</td>
      <td style="font-size: 13px;	border-right: 1px solid #dfe4ea; border-bottom: 1px solid #dfe4ea; text-align: right; padding: 10px;">{{ voucher.amount }}</td>
    </tr>
    {% endfor %}
      </tbody>
    
    <tfoot>
    
    {% for total in totals %}
    <tr>
      <td style="font-size: 13px;	border-right: 1px solid #dfe4ea; border-bottom: 1px solid #dfe4ea; text-align: right; padding: 10px;" colspan="4"><b>{{ total.title }}:</b></td>
      <td style="font-size: 13px;	border-right: 1px solid #dfe4ea; border-bottom: 1px solid #dfe4ea; text-align: right; padding: 10px;">{{ total.text }}</td>
    </tr>
    {% endfor %}
      </tfoot>
    
  </table>
  <p style="margin-top: 0px; margin-bottom: 20px;">{{ text_footer }}</p>
</div>
</body>
</html>
