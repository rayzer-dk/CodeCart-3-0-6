<!DOCTYPE html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1.0"><title>{{ text_received }}</title><style>
@media only screen and (max-width:620px){.ccp-wrap{width:100%!important;max-width:100%!important}.ccp-pad{padding:16px 12px!important}.ccp-logo{max-width:260px!important;height:auto!important}}
</style></head><body style="margin:0;padding:20px 8px;background:#f4f6f8;font-family:Arial,Helvetica,sans-serif;font-size:14px;line-height:1.5;color:#1f2937;"><table role="presentation" width="100%" cellpadding="0" cellspacing="0"><tr><td align="center"><table role="presentation" class="ccp-wrap" width="600" cellpadding="0" cellspacing="0" style="width:100%;max-width:600px;background:#fff;border:1px solid #e5e7eb;border-radius:12px;overflow:hidden;"><tr><td class="ccp-pad" style="padding:24px;word-break:break-word;overflow-wrap:anywhere;"><div style="text-align:center;padding-bottom:20px;border-bottom:1px solid #eef1f4;margin-bottom:22px;"><a href="{{ store_url }}"><img class="ccp-logo" src="{{ logo }}" alt="{{ store }}" width="{{ logo_width }}" height="{{ logo_height }}" style="display:block;width:{{ logo_width }}px;height:{{ logo_height }}px;max-width:300px;max-height:80px;object-fit:contain;margin:0 auto;border:0;"></a></div><h1 style="margin:0 0 18px;font-size:22px;color:#111827;">{{ text_received }}</h1>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-collapse:collapse;margin-bottom:18px;border:1px solid #e5e7eb;table-layout:fixed;"><tr><td width="42%" style="padding:10px 12px;background:#f7fafc;font-weight:700;">{{ text_order_id }}</td><td style="padding:10px 12px;">{{ order_id }}</td></tr><tr><td style="padding:10px 12px;background:#f7fafc;font-weight:700;border-top:1px solid #e5e7eb;">{{ text_date_added }}</td><td style="padding:10px 12px;border-top:1px solid #e5e7eb;">{{ date_added }}</td></tr><tr><td style="padding:10px 12px;background:#f7fafc;font-weight:700;border-top:1px solid #e5e7eb;">{{ text_order_status }}</td><td style="padding:10px 12px;border-top:1px solid #e5e7eb;">{{ order_status }}</td></tr></table>
{% for product in products %}<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-collapse:collapse;border:1px solid #e5e7eb;margin-bottom:10px;table-layout:fixed;"><tr><td colspan="2" style="padding:11px 12px;background:#fbfcfd;font-weight:700;">{{ product.name }}{% for option in product.option %}<br><small style="color:#667085;font-weight:400;">{{ option.name }}: {{ option.value }}</small>{% endfor %}</td></tr><tr><td width="42%" style="padding:8px 12px;border-top:1px solid #e5e7eb;background:#f7fafc;font-weight:700;">{{ text_model }}</td><td style="padding:8px 12px;border-top:1px solid #e5e7eb;">{{ product.model }}</td></tr><tr><td style="padding:8px 12px;border-top:1px solid #e5e7eb;background:#f7fafc;font-weight:700;">{{ text_quantity }}</td><td style="padding:8px 12px;border-top:1px solid #e5e7eb;">{{ product.quantity }}</td></tr><tr><td style="padding:8px 12px;border-top:1px solid #e5e7eb;background:#f7fafc;font-weight:700;">{{ text_total }}</td><td style="padding:8px 12px;border-top:1px solid #e5e7eb;font-weight:700;">{{ product.total }}</td></tr></table>{% endfor %}
{% for voucher in vouchers %}<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-collapse:collapse;border:1px solid #e5e7eb;margin-bottom:10px;table-layout:fixed;"><tr><td style="padding:11px 12px;font-weight:700;">{{ voucher.description }}</td><td width="32%" style="padding:11px 12px;text-align:right;font-weight:700;">{{ voucher.amount }}</td></tr></table>{% endfor %}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-collapse:collapse;border:1px solid #e5e7eb;margin:18px 0;table-layout:fixed;">{% for total in totals %}<tr><td width="68%" style="padding:10px 12px;border-top:{% if loop.first %}0{% else %}1px{% endif %} solid #e5e7eb;text-align:right;font-weight:700;">{{ total.title }}</td><td style="padding:10px 12px;border-top:{% if loop.first %}0{% else %}1px{% endif %} solid #e5e7eb;text-align:right;font-weight:700;">{{ total.value }}</td></tr>{% endfor %}</table>{% if comment %}<div style="padding:14px 16px;background:#f7fafc;border-left:3px solid #0b6fd3;">{{ comment }}</div>{% endif %}</td></tr></table></td></tr></table></body></html>
