<!DOCTYPE html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1.0"><title>{{ text_signup }}</title><style>
@media only screen and (max-width:620px){.ccp-wrap{width:100%!important;max-width:100%!important}.ccp-pad{padding:18px 14px!important}.ccp-stack,.ccp-stack td{display:block!important;width:100%!important;box-sizing:border-box!important}.ccp-mobile-center{text-align:center!important}.ccp-hide-mobile{display:none!important}.ccp-product-table thead{display:none!important}.ccp-product-table,.ccp-product-table tbody,.ccp-product-table tr,.ccp-product-table td{display:block!important;width:100%!important;box-sizing:border-box!important}.ccp-product-table tr{border-bottom:1px solid #e5e7eb!important;padding:10px 0!important}.ccp-product-table td{border:0!important;text-align:left!important;padding:6px 10px!important}.ccp-product-table td:before{display:inline-block!important;min-width:92px;font-weight:700;color:#667085}.ccp-product-table td:nth-child(2):before{content:'Model: '}.ccp-product-table td:nth-child(3):before{content:'Qty: '}.ccp-product-table td:nth-child(4):before{content:'Price: '}.ccp-product-table td:nth-child(5):before{content:'Total: '}.ccp-btn{display:block!important;width:100%!important;box-sizing:border-box!important;text-align:center!important}.ccp-address{margin-bottom:12px!important}.ccp-logo{max-width:300px!important;height:auto!important}}
</style></head><body style="margin:0;padding:24px 10px;background:#f4f6f8;font-family:Arial,Helvetica,sans-serif;font-size:14px;line-height:1.6;color:#1f2937;"><table role="presentation" width="100%" cellpadding="0" cellspacing="0"><tr><td align="center"><table role="presentation" class="ccp-wrap" width="600" cellpadding="0" cellspacing="0" style="width:100%;max-width:600px;background:#fff;border:1px solid #e5e7eb;border-radius:12px;overflow:hidden;"><tr><td class="ccp-pad" style="padding:26px;"><div style="text-align:center;padding-bottom:22px;border-bottom:1px solid #eef1f4;margin-bottom:24px;"><a href="{{ store_url }}"><img class="ccp-logo" src="{{ logo }}" alt="{{ store }}" width="{{ logo_width }}" height="{{ logo_height }}" style="display:block;width:{{ logo_width }}px;height:{{ logo_height }}px;max-width:300px;max-height:80px;object-fit:contain;margin:0 auto;border:0;"></a></div><h1 style="margin:0 0 20px;font-size:22px;line-height:1.3;color:#111827;">{{ text_signup }}</h1><table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-collapse:collapse;border:1px solid #e5e7eb;"><tr><td style="padding:10px 12px;background:#f7fafc;font-weight:700;width:38%;">{{ text_firstname }}</td><td style="padding:10px 12px;">{{ firstname }}</td></tr><tr><td style="padding:10px 12px;background:#f7fafc;font-weight:700;border-top:1px solid #e5e7eb;">{{ text_lastname }}</td><td style="padding:10px 12px;border-top:1px solid #e5e7eb;">{{ lastname }}</td></tr>{% if customer_group %}<tr><td style="padding:10px 12px;background:#f7fafc;font-weight:700;border-top:1px solid #e5e7eb;">{{ text_customer_group }}</td><td style="padding:10px 12px;border-top:1px solid #e5e7eb;">{{ customer_group }}</td></tr>{% endif %}<tr><td style="padding:10px 12px;background:#f7fafc;font-weight:700;border-top:1px solid #e5e7eb;">{{ text_email }}</td><td style="padding:10px 12px;border-top:1px solid #e5e7eb;word-break:break-word;">{{ email }}</td></tr><tr><td style="padding:10px 12px;background:#f7fafc;font-weight:700;border-top:1px solid #e5e7eb;">{{ text_telephone }}</td><td style="padding:10px 12px;border-top:1px solid #e5e7eb;">{{ telephone }}</td></tr></table></td></tr></table></td></tr></table></body></html>