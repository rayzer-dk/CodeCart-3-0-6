<!DOCTYPE html>
<!--[if IE]><![endif]-->
<!--[if IE 8 ]><html dir="{{ direction }}" lang="{{ lang }}" class="ie8"><![endif]-->
<!--[if IE 9 ]><html dir="{{ direction }}" lang="{{ lang }}" class="ie9"><![endif]-->
<!--[if (gt IE 9)|!(IE)]><!-->
<html dir="{{ direction }}" lang="{{ lang }}" data-ccp-picker-theme="{{ theme_datetimepicker_theme }}" data-ccp-workbox="{{ codecart_workbox_enabled ? '1' : '0' }}" data-ccp-pwa="{{ codecart_pwa_enabled ? '1' : '0' }}"{% if codecart_pwa_enabled %} data-ccp-pwa-install="{{ text_pwa_install|e('html_attr') }}" data-ccp-pwa-banner-title="{{ text_pwa_banner_title|e('html_attr') }}" data-ccp-pwa-banner-desc="{{ text_pwa_banner_desc|e('html_attr') }}" data-ccp-pwa-dismiss="{{ text_pwa_dismiss|e('html_attr') }}" data-ccp-pwa-prompt-days="{{ codecart_pwa_prompt_days }}" data-ccp-pwa-ios-help="{{ text_pwa_ios_help|e('html_attr') }}" data-ccp-pwa-mac-help="{{ text_pwa_mac_help|e('html_attr') }}"{% endif %}>
<!--<![endif]-->
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<title>{{ title_text|e }}</title>
{% if robots %}
<meta name="robots" content="{{ robots|e }}" />
{% endif %}
<base href="{{ base|e }}" />
{% if codecart_pwa_enabled %}
<style>
.ccp-pwa-install-banner{box-sizing:border-box;position:relative;z-index:1035;width:100%;padding:9px 15px;background:#edf5ff;color:#153354;border-bottom:1px solid #c8def8;font-family:inherit}
.ccp-pwa-install-banner-content{max-width:1180px;min-height:42px;margin:0 auto;display:flex;align-items:center;gap:14px}
.ccp-pwa-install-copy{display:flex;align-items:center;flex-wrap:wrap;gap:6px 10px;flex:1 1 auto;min-width:0;font-size:13px;line-height:1.4}
.ccp-pwa-install-copy strong{font-size:14px;font-weight:700}
.ccp-pwa-install-copy span{opacity:.89}
.ccp-pwa-install-action{flex:0 0 auto;padding:8px 15px;border:0;border-radius:7px;background:#096cce;color:#fff;font-weight:600;cursor:pointer;min-height:38px}
.ccp-pwa-install-action:hover,.ccp-pwa-install-action:focus{background:#0757a9;color:#fff}
.ccp-pwa-install-dismiss{display:flex;align-items:center;justify-content:center;flex:0 0 34px;width:34px;height:34px;border:0;border-radius:7px;background:transparent;color:#42617f;font-size:25px;line-height:1;cursor:pointer}
.ccp-pwa-install-dismiss:hover,.ccp-pwa-install-dismiss:focus{background:#d9eaff;color:#153354}
.ccp-pwa-install-banner [hidden]{display:none!important}
html.ccp-theme-dark .ccp-pwa-install-banner{background:#182c43;border-bottom-color:#34506c;color:#e9f3ff}
html.ccp-theme-dark .ccp-pwa-install-dismiss{color:#c9dbee}
@media(max-width:767px){.ccp-pwa-install-banner{padding:8px 12px}.ccp-pwa-install-banner-content{gap:8px;flex-wrap:wrap}.ccp-pwa-install-copy{flex-basis:calc(100% - 45px);font-size:12px}.ccp-pwa-install-copy strong{font-size:13px}.ccp-pwa-install-action{order:3;min-height:36px;padding:7px 13px}.ccp-pwa-install-dismiss{order:2;margin-left:auto}}
</style>
{% endif %}
{% if codecart_pwa_enabled %}
<link rel="manifest" href="{{ codecart_pwa_manifest_url|e('html_attr') }}" crossorigin="use-credentials" />
<meta name="theme-color" content="#0b6fd3" />
<meta name="apple-mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-status-bar-style" content="default" />
<link rel="apple-touch-icon" sizes="180x180" href="{{ codecart_pwa_icon_url|e('html_attr') }}" />
{% endif %}
{% if description %}
<meta name="description" content="{{ description_text|e }}" />
{% endif %}
{% if keywords %}
<meta name="keywords" content="{{ keywords_text|e }}" />
{% endif %}
<meta property="og:title" content="{{ title_text|e }}" />
<meta property="og:type" content="{{ og_type|e }}" />
<meta property="og:url" content="{{ og_url|e }}" />
{% if og_description %}<meta property="og:description" content="{{ og_description|e }}" />{% endif %}
{% if og_image %}
    <meta property="og:image" content="{{ og_image|e }}" />
    <meta property="og:image:alt" content="{{ title_text|e }}" />
{% elseif logo %}
    <meta property="og:image" content="{{ logo|e }}" />
    <meta property="og:image:alt" content="{{ name|e }}" />
{% endif %}
<meta property="og:site_name" content="{{ name|e }}" />
<meta name="twitter:card" content="{% if og_image %}summary_large_image{% else %}summary{% endif %}" />
<meta name="twitter:title" content="{{ title_text|e }}" />
{% if og_description %}<meta name="twitter:description" content="{{ og_description|e }}" />{% endif %}
{% if og_image %}<meta name="twitter:image" content="{{ og_image|e }}" />
<meta name="twitter:image:alt" content="{{ title_text|e }}" />{% elseif logo %}<meta name="twitter:image" content="{{ logo|e }}" />
<meta name="twitter:image:alt" content="{{ name|e }}" />{% endif %}
{% for alternate in alternate_links %}
<link rel="alternate" hreflang="{{ alternate.hreflang|e }}" href="{{ alternate.href|e }}" />
{% endfor %}
<script src="catalog/view/javascript/jquery/jquery-3.7.1.min.js" type="text/javascript"></script>
<script src="catalog/view/javascript/jquery/jquery-migrate-3.4.1.min.js" type="text/javascript"></script>
<link href="catalog/view/javascript/bootstrap/css/bootstrap.min.css" rel="stylesheet" media="screen" />
<script src="catalog/view/javascript/bootstrap/js/bootstrap.min.js" type="text/javascript"></script>
<link href="{{ font_awesome_css }}" rel="stylesheet" type="text/css" />
{% if theme_font_key == 'inter' %}<link rel="preload" href="catalog/view/theme/codecart/fonts/inter/inter-regular.woff2?v=3.019" as="font" type="font/woff2" crossorigin /><link href="catalog/view/theme/codecart/stylesheet/inter.css?v=3.0.6.1" rel="stylesheet" type="text/css" />{% endif %}
{% if theme_dark_mode_status %}<script>(function(){try{var m=localStorage.getItem('ccp-theme')||'{{ theme_dark_mode_default }}';if(m==='system'){m=window.matchMedia&&window.matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light';}if(m==='dark'){document.documentElement.classList.add('ccp-theme-dark');}}catch(e){}})();</script>{% endif %}
{% if developer_theme %}<link href="catalog/view/theme/codecart/stylesheet/stylesheet.css?v=3.0.6.1-2.3.30" rel="stylesheet">{% else %}<link href="catalog/view/theme/codecart/stylesheet/stylesheet.min.css?v=3.0.6.1-2.3.30" rel="stylesheet">{% endif %}
<style>:root{--ccp-store-accent:{{ theme_accent_color }};--ccp-store-accent-hover:{{ theme_accent_hover }};--ccp-store-button:{{ theme_button_color }};--ccp-store-button-hover:{{ theme_button_hover }};--ccp-store-button-text:{{ theme_button_text_color }};--ccp-store-buy:{{ theme_buy_button_color }};--ccp-store-buy-hover:{{ theme_buy_button_hover }};--ccp-store-buy-text:{{ theme_buy_button_text_color }};--ccp-store-sale:{{ theme_sale_price_color }};--ccp-store-cart:{{ theme_cart_button_color }};--ccp-store-cart-hover:{{ theme_cart_button_hover }};--ccp-store-cart-text:{{ theme_cart_button_text_color }};--ccp-store-text:{{ theme_text_color }};--ccp-store-heading:{{ theme_heading_color }};--ccp-store-h1:{{ theme_h1_color }};--ccp-store-page-title:{{ theme_page_title_color }};--ccp-store-page-title-dark:{{ theme_page_title_dark_color }};--ccp-store-h2:{{ theme_h2_color }};--ccp-store-background:{{ theme_background_color }};--ccp-store-surface:{{ theme_surface_color }};--ccp-store-border:{{ theme_border_color }};--ccp-store-footer-background:{{ theme_footer_background_color }};--ccp-store-footer-text:{{ theme_footer_text_color }};--ccp-store-footer-link:{{ theme_footer_link_color }};--ccp-store-footer-heading:{{ theme_footer_heading_color }};--ccp-store-font:{{ theme_font_family }};--ccp-store-radius:{{ theme_border_radius }}px;{% for context, options in product_image_options %}--ccp-image-{{ context }}-background:{{ options.background == 'white' ? '#fff' : (options.background == 'dark' ? '#171e27' : 'transparent') }};{% endfor %}}</style>
{% if theme_custom_css %}<style id="ccp-custom-css">{{ theme_custom_css|raw }}</style>{% endif %}
{% for style in styles %}
<link href="{{ style.href }}" type="text/css" rel="{{ style.rel }}" media="{{ style.media }}" />
{% endfor %}
{% if font_awesome_unresolved_css %}<style id="ccp-fa-unresolved-placeholder">{{ font_awesome_unresolved_css|raw }}</style>{% endif %}
{% for asset_id, asset in modern_assets %}
{% if asset.preload %}<link rel="preload" href="{{ asset.url }}" as="{% if asset.type == 'style' %}style{% else %}script{% endif %}" />{% endif %}
{% if asset.type == 'style' %}<link rel="stylesheet" href="{{ asset.url }}" media="{{ asset.media }}" />{% elseif asset.type == 'script' %}<script src="{{ asset.url }}"{% if asset.module %} type="module"{% else %} type="text/javascript"{% endif %}{% if asset.defer %} defer{% endif %}{% if asset.async %} async{% endif %}></script>{% endif %}
{% endfor %}
{% for script in scripts %}
<script src="{{ script }}" type="text/javascript"></script>
{% endfor %}
<script>window.CodeCartI18n={{ codecart_ui_i18n|json_encode|raw }};</script>
<script>window.CodeCartRoutes={{ codecart_ui_routes|json_encode|raw }};</script>

<script src="{{ core_script|e('html_attr') }}" type="text/javascript"></script>
<script src="catalog/view/javascript/codecart/feedback/feedback.js?v=3.0.6.1-fb2" type="text/javascript"></script>

{% if codecart_workbox_enabled or codecart_pwa_enabled %}
<script src="catalog/view/javascript/codecart/workbox/register.js?v=3.0.6.1-pwa2" defer></script>
{% elseif codecart_workbox_used or codecart_pwa_used %}
{# Clear only workers and cache entries previously installed by CodeCart. #}
<script>
(function () {
  if (!('serviceWorker' in navigator)) return;
  window.addEventListener('load', function () {
    var base = document.querySelector('base[href]');
    var root;
    try { root = new URL(base ? base.href : document.baseURI, window.location.href); }
    catch (error) { return; }
    if (root.origin !== window.location.origin) return;
    var scope = new URL('./', root);
    var allowed = [
      new URL('codecart-sw.js', root).href,
      new URL('codecart-app-sw.js', root).href
    ];
    navigator.serviceWorker.getRegistration(scope.href).then(function (registration) {
      if (!registration || registration.scope !== scope.href) return;
      var scripts = [registration.active, registration.waiting, registration.installing].filter(Boolean);
      if (!scripts.length || scripts.some(function (script) { return allowed.indexOf(script.scriptURL) === -1; })) return;
      return registration.unregister();
    }).then(function () {
      if (!('caches' in window)) return;
      var prefix = 'ccp-workbox-' + encodeURIComponent(scope.pathname) + '-';
      return window.caches.keys().then(function (keys) {
        return Promise.all(keys.filter(function (key) {
          return key.indexOf(prefix) === 0;
        }).map(function (key) { return window.caches.delete(key); }));
      });
    }).catch(function () {});
  }, { once: true });
})();
</script>
{% endif %}

{% if catalog_ajax_status %}<script src="catalog/view/javascript/codecart/catalog/catalog-ajax.js?v=3.0.6.1" type="text/javascript" defer></script>{% endif %}
{% for link in links %}
<link href="{{ link.href }}" rel="{{ link.rel }}" />
{% endfor %}
{% for analytic in analytics %}
{{ analytic }}
{% endfor %}
</head>
<body data-ccp-cart-url="{{ shopping_cart }}" data-ccp-cart-add-url="{{ cart_add_url }}" data-ccp-cart-edit-url="{{ cart_edit_url }}" data-ccp-cart-remove-url="{{ cart_remove_url }}" data-ccp-cart-info-url="{{ cart_info_url }}" data-ccp-wishlist-add-url="{{ wishlist_add_url }}" data-ccp-compare-add-url="{{ compare_add_url }}" data-ccp-in-cart="{{ button_in_cart }}">
<nav id="top">
  <div class="container">{{ currency }}
    {{ language }}
	{{ blog_menu }}
    <div id="top-links" class="nav pull-right">
      <ul class="list-inline">
        {% if theme_header_phone_status and telephone %}<li class="hidden-xs ccp-top-contact"><a href="tel:{{ telephone|replace({' ': '', '(': '', ')': '', '-': ''}) }}" title="{{ telephone }}"><i class="fa-solid fa-phone-volume" aria-hidden="true"></i> <span>{{ telephone }}</span></a></li>{% endif %}
        {% if theme_header_email_status and email %}<li class="hidden-xs ccp-top-contact hidden-sm"><a href="mailto:{{ email }}" title="{{ email }}"><i class="fa fa-envelope" aria-hidden="true"></i> <span>{{ email }}</span></a></li>{% endif %}
        {% if theme_dark_mode_status %}<li><button type="button" class="ccp-theme-toggle" title="{{ text_theme_toggle }}" aria-label="{{ text_theme_toggle }}"><i class="fa fa-moon ccp-theme-fa" aria-hidden="true"></i></button></li>{% endif %}
        <li class="dropdown"><a href="{{ account }}" title="{{ text_account }}" class="dropdown-toggle" data-toggle="dropdown"><i class="fa fa-user"></i> <span class="hidden-xs hidden-sm hidden-md">{{ text_account }}</span> <span class="caret"></span></a>
          <ul class="dropdown-menu dropdown-menu-right">
            {% if logged %}
            <li><a href="{{ account }}">{{ text_account }}</a></li>
            <li><a href="{{ order }}">{{ text_order }}</a></li>
            <li><a href="{{ transaction }}">{{ text_transaction }}</a></li>
            <li><a href="{{ download }}">{{ text_download }}</a></li>
            <li><a href="{{ logout }}">{{ text_logout }}</a></li>
            {% else %}
            <li><a href="{{ register }}">{{ text_register }}</a></li>
            <li><a href="{{ login }}">{{ text_login }}</a></li>
            {% endif %}
          </ul>
        </li>
        <li><a href="{{ wishlist }}" id="wishlist-total" title="{{ text_wishlist }}"><i class="fa fa-heart"></i> <span class="hidden-xs hidden-sm hidden-md">{{ text_wishlist }}</span></a></li>
        {% if not quick_checkout_enabled %}<li><a href="{{ shopping_cart }}" title="{{ text_shopping_cart }}"><i class="fa fa-shopping-cart"></i> <span class="hidden-xs hidden-sm hidden-md">{{ text_shopping_cart }}</span></a></li>{% endif %}
        <li><a href="{{ checkout }}" title="{{ text_checkout }}"><i class="fa fa-share"></i> <span class="hidden-xs hidden-sm hidden-md">{{ text_checkout }}</span></a></li>
      </ul>
    </div>
  </div>
</nav>
<div class="ccp-head">
<header>
  <div class="container">
    <div class="row">
      <div class="col-sm-4 ccp-header-brand-col">
        <div class="ccp-mobile-header-contacts visible-xs">
          {% if theme_header_phone_status and telephone %}<a class="ccp-mobile-contact-line" href="tel:{{ telephone|replace({' ': '', '(': '', ')': '', '-': ''}) }}" title="{{ telephone }}"><i class="fa-solid fa-phone-volume"></i><span>{{ telephone }}</span></a>{% endif %}
          {% if theme_header_email_status and email %}<a class="ccp-mobile-contact-line" href="mailto:{{ email }}" title="{{ email }}"><i class="fa fa-envelope"></i><span>{{ email }}</span></a>{% endif %}
        </div>
		<div id="logo"{% if codecart_default_brand_logo %} class="ccp-default-brand-logo"{% endif %}>
          {% if logo %}
            {% if home == og_url %}
              <img src="{{ logo }}"{% if logo_srcset %} srcset="{{ logo_srcset }}" sizes="(max-width: 767px) 190px, (max-width: 991px) 240px, {{ logo_width }}px"{% endif %} title="{{ name }}" alt="{{ name }}"{% if logo_width and logo_height %} width="{{ logo_width }}" height="{{ logo_height }}"{% endif %} class="img-responsive" />
            {% else %}
              <a href="{{ home }}"><img src="{{ logo }}"{% if logo_srcset %} srcset="{{ logo_srcset }}" sizes="(max-width: 767px) 190px, (max-width: 991px) 240px, {{ logo_width }}px"{% endif %} title="{{ name }}" alt="{{ name }}"{% if logo_width and logo_height %} width="{{ logo_width }}" height="{{ logo_height }}"{% endif %} class="img-responsive" /></a>
            {% endif %}
          {% else %}
            {% if home == og_url %}<h1 class="ccp-logo-text"><a href="{{ home }}">{{ name }}</a></h1>{% else %}<div class="ccp-logo-text"><a href="{{ home }}">{{ name }}</a></div>{% endif %}
          {% endif %}
		</div>
      </div>
      <div class="col-sm-5 ccp-header-search-col">{{ search }}</div>
      <div class="col-sm-3 ccp-header-cart-col">{{ cart }}</div>
    </div>
  </div>
</header>
{{ menu }}
</div>
<main id="main-content">
