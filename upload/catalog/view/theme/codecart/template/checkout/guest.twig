<script type="text/javascript">
function codeCartLoadCheckoutCountry(countryId, lockCountry) {
	$.ajax({
		url: 'index.php?route=checkout/checkout/country&country_id=' + encodeURIComponent(countryId),
		dataType: 'json',
		beforeSend: function() {
			if (lockCountry) { $('#collapse-payment-address select[name="country_id"]').prop('disabled', true); }
		},
		complete: function() {
			if (lockCountry) { $('#collapse-payment-address select[name="country_id"]').prop('disabled', false); }
		},
		success: function(json) {
			{% if checkout_field_postcode_required %}
			if (json.postcode_required == '1') {
				$('#collapse-payment-address input[name="postcode"]').closest('.form-group').addClass('required');
			} else {
				$('#collapse-payment-address input[name="postcode"]').closest('.form-group').removeClass('required');
			}
			{% endif %}

			var html = '<option value="">{{ text_select|escape('js') }}</option>';
			if (json.zone && json.zone.length) {
				for (var i = 0; i < json.zone.length; i++) {
					html += '<option value="' + json.zone[i].zone_id + '"' + (json.zone[i].zone_id == '{{ zone_id }}' ? ' selected="selected"' : '') + '>' + json.zone[i].name + '</option>';
				}
			} else {
				html += '<option value="0" selected="selected">{{ text_none|escape('js') }}</option>';
			}
			$('#collapse-payment-address select[name="zone_id"]').html(html);
		},
		error: function(xhr, ajaxOptions, thrownError) {
			if (window.CodeCartUI) { window.CodeCartUI.error(xhr, thrownError); } else { alert(thrownError + "\r\n" + xhr.statusText); }
		}
	});
}

$('#collapse-payment-address select[name="country_id"]').on('change', function() {
	codeCartLoadCheckoutCountry(this.value, true);
});

if ($('#collapse-payment-address select[name="country_id"]').length) {
	$('#collapse-payment-address select[name="country_id"]').trigger('change');
} else if ($('#collapse-payment-address select[name="zone_id"]').length) {
	codeCartLoadCheckoutCountry('{{ country_id }}', false);
}
</script> 