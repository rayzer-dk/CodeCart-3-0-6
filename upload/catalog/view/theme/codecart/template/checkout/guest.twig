              <input type="radio" name="custom_field[{{ custom_field.location }}][{{ custom_field.custom_field_id }}]" value="{{ custom_field_value.custom_field_value_id|e('html_attr') }}" checked="checked" />
              {{ custom_field_value.name }}</label>
