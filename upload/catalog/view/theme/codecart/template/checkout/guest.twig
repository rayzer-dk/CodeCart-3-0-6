<div class="row">
  <div class="{% if compact_delivery_checkout %}col-sm-12{% else %}col-sm-6{% endif %}">
    <fieldset id="account">
      <legend>{{ text_your_details }}</legend>
      <div class="form-group{% if compact_delivery_checkout %} ccq-customer-type{% endif %}" style="display: {% if customer_groups|length > 1 %} block {% else %} none {% endif %};">
        <label class="control-label">{{ entry_customer_group }}</label>
        {% if compact_delivery_checkout %}<div class="ccq-customer-type-options">{% endif %}
        {% for customer_group in customer_groups %}
        {% if customer_group.customer_group_id == customer_group_id %}
        <div class="radio{% if compact_delivery_checkout %} ccq-customer-type-option{% endif %}">
          <label>
            <input type="radio" name="customer_group_id" value="{{ customer_group.customer_group_id|e('html_attr') }}" checked="checked" />
            {{ customer_group.name }}</label>
        </div>
        {% else %}
        <div class="radio{% if compact_delivery_checkout %} ccq-customer-type-option{% endif %}">
          <label>
            <input type="radio" name="customer_group_id" value="{{ customer_group.customer_group_id|e('html_attr') }}" />
            {{ customer_group.name }}</label>
        </div>
        {% endif %}
        {% endfor %}
        {% if compact_delivery_checkout %}</div>{% endif %}
      </div>
      {% if checkout_field_firstname %}
      <div class="form-group{% if checkout_field_firstname_required %} required{% endif %}">
        <label class="control-label" for="input-payment-firstname">{{ checkout_label_firstname }}</label>
        <input type="text" name="firstname" value="{{ firstname|e('html_attr') }}" placeholder="{{ checkout_label_firstname|e('html_attr') }}" id="input-payment-firstname" class="form-control" />
      </div>
      {% endif %}
      {% if checkout_field_lastname %}
      <div class="form-group{% if checkout_field_lastname_required %} required{% endif %}">
        <label class="control-label" for="input-payment-lastname">{{ checkout_label_lastname }}</label>
        <input type="text" name="lastname" value="{{ lastname|e('html_attr') }}" placeholder="{{ checkout_label_lastname|e('html_attr') }}" id="input-payment-lastname" class="form-control" />
      </div>
      {% endif %}
      {% if checkout_field_email %}
      <div class="form-group{% if checkout_field_email_required %} required{% endif %}">
        <label class="control-label" for="input-payment-email">{{ checkout_label_email }}</label>
        <input type="email" name="email" value="{{ email|e('html_attr') }}" placeholder="{{ checkout_label_email|e('html_attr') }}" id="input-payment-email" class="form-control" autocomplete="email" />
      </div>
      {% endif %}
      {% if checkout_field_telephone %}
      <div class="form-group{% if checkout_field_telephone_required %} required{% endif %}">
        <label class="control-label" for="input-payment-telephone">{{ checkout_label_telephone }}</label>
        <input type="tel" name="telephone" value="{{ telephone|e('html_attr') }}" placeholder="{{ checkout_label_telephone|e('html_attr') }}" id="input-payment-telephone" class="form-control" autocomplete="tel" />
      </div>
      {% endif %}
      {% for custom_field in custom_fields %}
      {% if custom_field.location == 'account' %}
      {% if custom_field.type == 'select' %}
      <div id="payment-custom-field{{ custom_field.custom_field_id }}" class="form-group custom-field" data-sort="{{ custom_field.sort_order|e('html_attr') }}">
        <label class="control-label" for="input-payment-custom-field{{ custom_field.custom_field_id }}">{{ custom_field.name }}</label>
        <select name="custom_field[{{ custom_field.location }}][{{ custom_field.custom_field_id }}]" id="input-payment-custom-field{{ custom_field.custom_field_id }}" class="form-control">
          <option value="">{{ text_select }}</option>
          
          
          {% for custom_field_value in custom_field.custom_field_value %}
          {% if guest_custom_field[custom_field.custom_field_id] and custom_field_value.custom_field_value_id == guest_custom_field[custom_field.custom_field_id] %}
          <option value="{{ custom_field_value.custom_field_value_id|e('html_attr') }}" selected="selected">{{ custom_field_value.name }}</option>
          
          
          {% else %}
          
          
          <option value="{{ custom_field_value.custom_field_value_id|e('html_attr') }}">{{ custom_field_value.name }}</option>
          
          
          {% endif %}
          {% endfor %}
        
        
        </select>
      </div>
      {% endif %}
