{{ header }}
<main id="error-not-found" class="ccp-error-host ccp-error-host--store">
  <div class="ccp-error-host__inner">
    {% if breadcrumbs %}
    <nav class="ccp-error-breadcrumbs" aria-label="Breadcrumb">
      {% for breadcrumb in breadcrumbs %}
        {% if not loop.first %}<span class="ccp-error-breadcrumbs__separator" aria-hidden="true">/</span>{% endif %}
        {% if loop.last %}<span aria-current="page">{{ breadcrumb.text }}</span>
        {% else %}<a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a>{% endif %}
      {% endfor %}
    </nav>
    {% endif %}
    <section class="ccp-error ccp-error--404" aria-labelledby="ccp-error-title">
      <div class="ccp-error__content">
        <div class="ccp-error__brand"><img src="catalog/view/theme/codecart/image/codecart-logo.webp" alt="CodeCart PRO" loading="eager" decoding="async" /></div>
        <div class="ccp-error__eyebrow">
          <span class="ccp-error__dot" aria-hidden="true"></span>
          <span>{{ text_error_label }}</span>
          <span class="ccp-error__http">HTTP 404</span>
        </div>
        <h1 id="ccp-error-title" class="ccp-error__title">{{ heading_title }}</h1>
        <p class="ccp-error__description">{{ text_error }}</p>
        <div class="ccp-error__actions">
          <a class="ccp-error__button" href="{{ continue }}">{{ button_home }}</a>
          <a class="ccp-error__button ccp-error__button--secondary" href="{{ search }}">{{ button_search }}</a>
        </div>
        <div class="ccp-error__divider" aria-hidden="true"></div>
        <div class="ccp-error__footnote">HTTP 404 · CodeCart PRO</div>
      </div>
      <div class="ccp-error__visual" aria-hidden="true">
        <span class="ccp-error__visual-top">{{ text_visual_status }}</span>
        <span class="ccp-error__code">404</span>
        <span class="ccp-error__visual-bottom">HTTP · 04</span>
        <span class="ccp-error__visual-marker"></span>
      </div>
    </section>
    {% if column_left or column_right or content_top or content_bottom %}
    <div class="ccp-error-host__modules">
      {{ content_top }}
      <div class="row">
        {{ column_left }}
        {{ column_right }}
      </div>
      {{ content_bottom }}
    </div>
    {% endif %}
  </div>
</main>
{{ footer }}
