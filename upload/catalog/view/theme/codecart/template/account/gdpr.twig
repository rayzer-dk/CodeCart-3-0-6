{{ header }}<div id="account-gdpr" class="container"><ul class="breadcrumb">{% for breadcrumb in breadcrumbs %}<li>{% if loop.last %}<span aria-current="page">{{ breadcrumb.text }}</span>{% else %}<a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a>{% endif %}</li>{% endfor %}</ul><div class="row">{{ column_left }}{% if column_left and column_right %}{% set class='col-sm-6' %}{% elseif column_left or column_right %}{% set class='col-sm-9' %}{% else %}{% set class='col-sm-12' %}{% endif %}<div id="content" class="{{ class }}">{{ content_top }}<h1>{{ heading_title }}</h1>{% if success %}<div class="alert alert-success">{{ success }}</div>{% endif %}{% if error_warning %}<div class="alert alert-danger">{{ error_warning }}</div>{% endif %}<p>{{ text_intro }}</p><div class="row"><div class="col-sm-6"><div class="panel panel-default"><div class="panel-heading"><strong>{{ text_export }}</strong></div><div class="panel-body"><p>{{ text_export_help }}</p><form action="{{ action }}" method="post"><input type="hidden" name="request_type" value="export"><button type="submit" class="btn btn-primary">{{ button_request_export }}</button></form></div></div></div><div class="col-sm-6"><div class="panel panel-default"><div class="panel-heading"><strong>{{ text_delete }}</strong></div><div class="panel-body"><p>{{ text_delete_help }}</p><form action="{{ action }}" method="post" onsubmit="return confirm('{{ text_confirm_delete_request|escape('js') }}');"><input type="hidden" name="request_type" value="delete"><button type="submit" class="btn btn-danger">{{ button_request_delete }}</button></form></div></div></div></div><h3>{{ text_requests }}</h3><div class="table-responsive"><table class="table table-bordered table-hover"><thead><tr><td>{{ column_type }}</td><td>{{ column_status }}</td><td>{{ column_date }}</td><td>{{ column_action }}</td></tr></thead><tbody>{% if requests %}{% for item in requests %}<tr><td>{% if item.type == 'export' %}{{ text_export }}{% else %}{{ text_delete }}{% endif %}</td><td>{% if item.status == 'pending' %}{{ text_pending }}{% elseif item.status == 'confirmed' %}{{ text_confirmed }}{% elseif item.status == 'processed' %}{{ text_processed }}{% else %}{{ text_superseded }}{% endif %}</td><td>{{ item.date_added }}</td><td>{% if item.type == 'export' and item.status == 'confirmed' %}<a href="{{ download }}" class="btn btn-primary btn-sm"><i class="fa fa-download"></i> {{ button_download }}</a>{% endif %}</td></tr>{% endfor %}{% else %}<tr><td colspan="4" class="text-center">{{ text_no_requests }}</td></tr>{% endif %}</tbody></table></div>{{ content_bottom }}</div>{{ column_right }}</div></div>{{ footer }}
