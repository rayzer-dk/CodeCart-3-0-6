<div id="slideshow{{ module }}" class="ccp-slider ccp-slider--slideshow" data-ccp-slider data-kind="slideshow" data-effect="{{ effect }}" data-per-view="1" data-gap="0" data-autoplay="{% if autoplay %}{{ autoplay_delay }}{% else %}0{% endif %}" data-loop="{{ loop }}" data-slide-label="{{ text_slide }}" tabindex="0" data-pause-label="{{ text_pause_autoplay }}" data-play-label="{{ text_play_autoplay }}">
  <div class="ccp-slider__viewport"><div class="ccp-slider__track">{% for banner in banners %}
    <div class="ccp-slider__slide{% if loop.first %} is-active{% endif %}">{% if banner.link %}<a href="{{ banner.link }}"><img src="{{ banner.image }}"{% if banner.srcset %} srcset="{{ banner.srcset }}" sizes="(max-width: 767px) calc(100vw - 24px), (max-width: 1199px) calc(100vw - 30px), 1140px"{% endif %}{% if image_width and image_height %} width="{{ image_width }}" height="{{ image_height }}"{% endif %} alt="{{ banner.title }}" class="img-responsive"{% if loop.first %} fetchpriority="high"{% else %} loading="lazy" fetchpriority="low" decoding="async"{% endif %} /></a>{% else %}<img src="{{ banner.image }}"{% if banner.srcset %} srcset="{{ banner.srcset }}" sizes="(max-width: 767px) calc(100vw - 24px), (max-width: 1199px) calc(100vw - 30px), 1140px"{% endif %}{% if image_width and image_height %} width="{{ image_width }}" height="{{ image_height }}"{% endif %} alt="{{ banner.title }}" class="img-responsive"{% if loop.first %} fetchpriority="high"{% else %} loading="lazy" fetchpriority="low" decoding="async"{% endif %} />{% endif %}</div>
  {% endfor %}</div></div>
  {% if autoplay %}<button type="button" class="ccp-slider__autoplay-toggle" title="{{ text_pause_autoplay }}" aria-label="{{ text_pause_autoplay }}" aria-pressed="false"><i class="fa fa-pause" aria-hidden="true"></i></button>{% endif %}
  {% if show_arrows %}<button type="button" class="ccp-slider__prev" aria-label="{{ text_previous }}" title="{{ text_previous }}"></button><button type="button" class="ccp-slider__next" aria-label="{{ text_next }}" title="{{ text_next }}"></button>{% endif %}
  {% if show_dots %}<div class="ccp-slider__pagination"></div>{% endif %}
</div>
