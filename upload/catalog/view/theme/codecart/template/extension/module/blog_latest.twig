<div class="ccp-native-module ccp-native-module--articles ccp-native-module--{{ display_mode }}" style="--ccp-module-cols-desktop:{{ columns_desktop }};--ccp-module-cols-tablet:{{ columns_tablet }};--ccp-module-cols-mobile:{{ columns_mobile }};--ccp-module-image-width:{{ image_width|default(200) }}px;--ccp-module-image-ratio:{{ image_width|default(200) }} / {{ image_height|default(200) }}" data-autoplay="{{ autoplay }}" data-autoplay-delay="{{ autoplay_delay }}" data-loop="{{ loop }}" data-step="{{ carousel_step }}" data-pause-label="{{ text_pause_autoplay }}" data-play-label="{{ text_play_autoplay }}">
  {% if heading_title or (display_mode == 'carousel' and (show_arrows or autoplay)) %}<div class="ccp-native-module-heading">{% if heading_title %}<h3>{{ heading_title }}</h3>{% else %}<span></span>{% endif %}{% if display_mode == 'carousel' and (show_arrows or autoplay) %}<div class="ccp-native-module-arrows">{% if autoplay %}<button type="button" class="ccp-native-module-autoplay-toggle" title="{{ text_pause_autoplay }}" aria-label="{{ text_pause_autoplay }}" aria-pressed="false"><i class="fa fa-pause" aria-hidden="true"></i></button>{% endif %}{% if show_arrows %}<button type="button" class="ccp-native-module-prev" title="{{ text_previous_items }}" aria-label="{{ text_previous_items }}"><i class="fa fa-angle-left" aria-hidden="true"></i></button><button type="button" class="ccp-native-module-next" title="{{ text_next_items }}" aria-label="{{ text_next_items }}"><i class="fa fa-angle-right" aria-hidden="true"></i></button>{% endif %}</div>{% endif %}</div>{% endif %}
  <div class="ccp-native-module-viewport"><div class="ccp-native-module-track">
  {% for article in articles %}
    <div class="product-layout ccp-native-module-item">
      <div class="product-thumb transition">
        <div class="image"><a href="{{ article.href }}"><img src="{{ article.thumb }}"{% if image_width and image_height %} width="{{ image_width }}" height="{{ image_height }}"{% endif %} alt="{{ article.name }}" title="{{ article.name }}" class="img-responsive" loading="lazy" decoding="async" /></a></div>
        <div class="caption">
          <h4><a href="{{ article.href }}">{{ article.name }}</a></h4>
          {% if article.description %}<p class="ccp-card-description">{{ article.description|e }}</p>{% endif %}
          {% if article.rating %}<div class="rating">{% for i in 1..5 %}{% if article.rating < i %}<span class="fa fa-stack"><i class="fa fa-star-o fa-stack-2x"></i></span>{% else %}<span class="fa fa-stack"><i class="fa fa-star fa-stack-2x"></i><i class="fa fa-star-o fa-stack-2x"></i></span>{% endif %}{% endfor %}</div>{% endif %}
        </div>
        <div class="button-group">
          <button type="button" class="ccp-article-open" title="{{ button_more }}" aria-label="{{ button_more }}" onclick="location.href = ('{{ article.href }}');"><i class="fa fa-share"></i> <span class="hidden-xs hidden-sm hidden-md">{{ button_more }}</span></button>
          <button type="button" data-toggle="tooltip" title="{{ article.date_added }}" aria-label="{{ article.date_added }}"><i class="fa fa-clock-o"></i></button>
          <button type="button" data-toggle="tooltip" title="{{ text_views }} {{ article.viewed }}" aria-label="{{ text_views }} {{ article.viewed }}"><i class="fa fa-eye"></i></button>
        </div>
      </div>
    </div>
  {% endfor %}
  </div></div>
  {% if display_mode == 'carousel' and show_dots %}<div class="ccp-native-module-pagination" aria-label="{{ heading_title }}"></div>{% endif %}
</div>
