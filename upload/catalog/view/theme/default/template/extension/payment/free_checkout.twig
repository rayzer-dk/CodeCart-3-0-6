<div class="buttons">
  <div class="pull-right">
    <input type="button" value="{{ button_confirm }}" id="button-confirm" class="btn btn-primary" data-loading-text="{{ text_loading }}" />
  </div>
</div>
<script type="text/javascript"><!--
$('#button-confirm').on('click', function() {
	$.ajax({
        data: {codecart_payment_token: '{{ codecart_payment_token|e('js') }}'},
		type: 'post',
		url: 'index.php?route=extension/payment/free_checkout/confirm',
		cache: false,
        dataType: 'json',
		beforeSend: function() {
			$('#button-confirm').button('loading');
		},
		complete: function() {
			$('#button-confirm').button('reset');
		},
		success: function(json) {
            if (json.redirect) { location = json.redirect; }
        },
        error: function(xhr, ajaxOptions, thrownError) {
            // A rejected/stale checkout must explain the problem instead of silently
            // leaving the customer on a frozen confirmation button.
            if (window.CodeCartUI) {
                window.CodeCartUI.error(xhr, thrownError);
            } else {
                var message = xhr.responseJSON && xhr.responseJSON.error
                    ? xhr.responseJSON.error : (xhr.statusText || thrownError);
                $('#codecart-free-checkout-warning').remove();
                $('#button-confirm').closest('.buttons').before(
                    $('<div/>', {
                        id: 'codecart-free-checkout-warning',
                        'class': 'alert alert-danger',
                        role: 'alert',
                        text: message
                    })
                );
            }
        }
	});
});
//--></script>
