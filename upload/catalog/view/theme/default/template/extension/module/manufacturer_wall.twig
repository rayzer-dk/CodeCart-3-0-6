<section class="ccp-manufacturer-wall ccp-native-module ccp-native-module--manufacturers ccp-native-module--{{ display_mode }}" style="--ccp-module-cols-desktop:{{ columns_desktop }};--ccp-module-cols-tablet:{{ columns_tablet }};--ccp-module-cols-mobile:{{ columns_mobile }};--ccp-manufacturer-image-width:{{ image_width }}px;--ccp-manufacturer-image-ratio:{{ image_width }} / {{ image_height }}" data-autoplay="{{ autoplay }}" data-autoplay-delay="{{ autoplay_delay }}" data-loop="{{ loop }}" data-step="{{ carousel_step }}" data-pause-label="{{ text_pause_autoplay }}" data-play-label="{{ text_play_autoplay }}">
  {% if heading_title or (display_mode == 'carousel' and (show_arrows or autoplay)) %}<div class="ccp-native-module-heading">{% if heading_title %}<h3 class="ccp-manufacturer-wall__title">{{ heading_title }}</h3>{% else %}<span></span>{% endif %}{% if display_mode == 'carousel' and (show_arrows or autoplay) %}<div class="ccp-native-module-arrows">{% if autoplay %}<button type="button" class="ccp-native-module-autoplay-toggle" title="{{ text_pause_autoplay }}" aria-label="{{ text_pause_autoplay }}" aria-pressed="false"><i class="fa fa-pause" aria-hidden="true"></i></button>{% endif %}{% if show_arrows %}<button type="button" class="ccp-native-module-prev" title="{{ text_previous_items }}" aria-label="{{ text_previous_items }}"><i class="fa fa-angle-left" aria-hidden="true"></i></button><button type="button" class="ccp-native-module-next" title="{{ text_next_items }}" aria-label="{{ text_next_items }}"><i class="fa fa-angle-right" aria-hidden="true"></i></button>{% endif %}</div>{% endif %}</div>{% endif %}
  <div class="ccp-native-module-viewport"><div class="ccp-manufacturer-wall__grid ccp-native-module-track">
    {% for manufacturer in manufacturers %}<div class="ccp-native-module-item"><a class="ccp-manufacturer-wall__card ccp-manufacturer-wall__card--{{ image_fit }}" href="{{ manufacturer.href }}">{% if show_image %}<span class="ccp-manufacturer-wall__image"><img src="{{ manufacturer.thumb }}" width="{{ image_width }}" height="{{ image_height }}" alt="{{ manufacturer.name }}" loading="lazy" decoding="async" /></span>{% endif %}{% if show_name %}<span class="ccp-manufacturer-wall__name">{{ manufacturer.name }}{% if show_count and manufacturer.count is not same as(false) %} <small>{{ manufacturer.count }}</small>{% endif %}</span>{% endif %}</a></div>{% endfor %}
  </div></div>
  {% if display_mode == 'carousel' and show_dots %}<div class="ccp-native-module-pagination" aria-label="{{ heading_title }}"></div>{% endif %}
</section>
