<div id="carousel{{ module }}" class="ccp-slider ccp-slider--carousel" data-ccp-slider data-kind="carousel" data-effect="slide" data-per-view="{{ columns_desktop }}" data-per-view-desktop="{{ columns_desktop }}" data-per-view-tablet="{{ columns_tablet }}" data-per-view-mobile="{{ columns_mobile }}" data-gap="{{ gap }}" data-autoplay="{% if autoplay %}{{ autoplay_delay }}{% else %}0{% endif %}" data-loop="{{ loop }}" data-step="{{ carousel_step }}" data-slide-label="{{ text_slide }}" tabindex="0" data-pause-label="{{ text_pause_autoplay }}" data-play-label="{{ text_play_autoplay }}">
  <div class="ccp-slider__viewport"><div class="ccp-slider__track">{% for banner in banners %}
    <div class="ccp-slider__slide">{% if banner.link %}<a href="{{ banner.link }}"><img src="{{ banner.image }}"{% if image_width and image_height %} width="{{ image_width }}" height="{{ image_height }}"{% endif %} alt="{{ banner.title }}" class="img-responsive" loading="lazy" decoding="async" /></a>{% else %}<img src="{{ banner.image }}"{% if image_width and image_height %} width="{{ image_width }}" height="{{ image_height }}"{% endif %} alt="{{ banner.title }}" class="img-responsive" loading="lazy" decoding="async" />{% endif %}</div>
  {% endfor %}</div></div>
  {% if autoplay %}<button type="button" class="ccp-slider__autoplay-toggle" title="{{ text_pause_autoplay }}" aria-label="{{ text_pause_autoplay }}" aria-pressed="false"><i class="fa fa-pause" aria-hidden="true"></i></button>{% endif %}
  {% if show_arrows %}<button type="button" class="ccp-slider__prev" aria-label="{{ text_previous }}" title="{{ text_previous }}"></button><button type="button" class="ccp-slider__next" aria-label="{{ text_next }}" title="{{ text_next }}"></button>{% endif %}
  {% if show_dots %}<div class="ccp-slider__pagination"></div>{% endif %}
</div>
