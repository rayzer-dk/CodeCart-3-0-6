<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">
<title>{{ title }}</title>
<style>
@media only screen and (max-width:620px){
  .ccp-wrap{width:100%!important;max-width:100%!important}
  .ccp-pad{padding:16px 12px!important}
  .ccp-stack,.ccp-stack>tbody>tr>td{display:block!important;width:100%!important;box-sizing:border-box!important}
  .ccp-address{border-right:0!important;border-bottom:1px solid #dfe4ea!important}
  .ccp-logo{max-width:260px!important;height:auto!important}
  .ccp-product-image{width:56px!important;height:56px!important}
}
</style>
</head>
<body style="margin:0;padding:20px 8px;background:#f4f6f8;font-family:Arial,Helvetica,sans-serif;font-size:14px;line-height:1.5;color:#1f2937;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"><tr><td align="center">
<table role="presentation" class="ccp-wrap" width="620" cellpadding="0" cellspacing="0" border="0" style="width:100%;max-width:620px;background:#ffffff;border:1px solid #e5e7eb;border-radius:10px;overflow:hidden;">
<tr><td class="ccp-pad" style="padding:22px;word-break:break-word;overflow-wrap:anywhere;">
  <div style="padding:10px 0 20px;border-bottom:1px solid #eef1f4;margin-bottom:20px;text-align:center;">
    <a href="{{ store_url }}" title="{{ store_name }}" style="display:inline-block;text-decoration:none;">
      <img class="ccp-logo" src="{{ logo }}" alt="{{ store_name }}" width="{{ logo_width }}" height="{{ logo_height }}" style="display:block;width:{{ logo_width }}px;height:{{ logo_height }}px;max-width:300px;max-height:80px;object-fit:contain;margin:0 auto;border:0;outline:none;text-decoration:none;">
    </a>
  </div>

  <p style="margin:0 0 18px;">{{ text_greeting }}</p>
  {% if customer_id %}<p style="margin:0 0 8px;">{{ text_link }}</p><p style="margin:0 0 18px;"><a href="{{ link }}" style="color:#0b6fd3;word-break:break-all;">{{ link }}</a></p>{% endif %}
  {% if download %}<p style="margin:0 0 8px;">{{ text_download }}</p><p style="margin:0 0 18px;"><a href="{{ download }}" style="color:#0b6fd3;word-break:break-all;">{{ download }}</a></p>{% endif %}

  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-collapse:collapse;border:1px solid #dfe4ea;margin-bottom:18px;">
    <tr><td colspan="2" style="padding:10px 12px;background:#f3f6f9;font-weight:700;color:#222;">{{ text_order_detail }}</td></tr>
    <tr><td style="padding:10px 12px;width:42%;border-top:1px solid #dfe4ea;font-weight:700;">{{ text_order_id }}</td><td style="padding:10px 12px;border-top:1px solid #dfe4ea;">{{ order_id }}</td></tr>
    <tr><td style="padding:10px 12px;border-top:1px solid #dfe4ea;font-weight:700;">{{ text_date_added }}</td><td style="padding:10px 12px;border-top:1px solid #dfe4ea;">{{ date_added }}</td></tr>
    <tr><td style="padding:10px 12px;border-top:1px solid #dfe4ea;font-weight:700;">{{ text_payment_method }}</td><td style="padding:10px 12px;border-top:1px solid #dfe4ea;">{{ payment_method }}</td></tr>
    {% if shipping_method %}<tr><td style="padding:10px 12px;border-top:1px solid #dfe4ea;font-weight:700;">{{ text_shipping_method }}</td><td style="padding:10px 12px;border-top:1px solid #dfe4ea;">{{ shipping_method }}</td></tr>{% endif %}
    <tr><td style="padding:10px 12px;border-top:1px solid #dfe4ea;font-weight:700;">{{ text_email }}</td><td style="padding:10px 12px;border-top:1px solid #dfe4ea;word-break:break-all;">{{ email }}</td></tr>
    <tr><td style="padding:10px 12px;border-top:1px solid #dfe4ea;font-weight:700;">{{ text_telephone }}</td><td style="padding:10px 12px;border-top:1px solid #dfe4ea;">{{ telephone }}</td></tr>
    <tr><td style="padding:10px 12px;border-top:1px solid #dfe4ea;font-weight:700;">{{ text_ip }}</td><td style="padding:10px 12px;border-top:1px solid #dfe4ea;">{{ ip }}</td></tr>
    <tr><td style="padding:10px 12px;border-top:1px solid #dfe4ea;font-weight:700;">{{ text_order_status }}</td><td style="padding:10px 12px;border-top:1px solid #dfe4ea;">{{ order_status }}</td></tr>
  </table>

  {% if comment %}<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-collapse:collapse;border:1px solid #dfe4ea;margin-bottom:18px;"><tr><td style="padding:10px 12px;background:#f3f6f9;font-weight:700;">{{ text_instruction }}</td></tr><tr><td style="padding:10px 12px;border-top:1px solid #dfe4ea;">{{ comment }}</td></tr></table>{% endif %}

  <table role="presentation" class="ccp-stack" width="100%" cellpadding="0" cellspacing="0" style="border-collapse:collapse;border:1px solid #dfe4ea;margin-bottom:18px;">
    <tr>
      <td class="ccp-address" width="50%" style="vertical-align:top;border-right:1px solid #dfe4ea;">
        <div style="padding:10px 12px;background:#f3f6f9;font-weight:700;">{{ text_payment_address }}</div>
        <div style="padding:12px;border-top:1px solid #dfe4ea;">{{ payment_address }}</div>
      </td>
      {% if shipping_address %}<td width="50%" style="vertical-align:top;">
        <div style="padding:10px 12px;background:#f3f6f9;font-weight:700;">{{ text_shipping_address }}</div>
        <div style="padding:12px;border-top:1px solid #dfe4ea;">{{ shipping_address }}</div>
      </td>{% endif %}
    </tr>
  </table>

  {% for product in products %}
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-collapse:collapse;border:1px solid #dfe4ea;margin-bottom:12px;table-layout:fixed;">
    <tr><td colspan="2" style="padding:12px;background:#fbfcfd;">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0"><tr>
        {% if product.image %}<td width="74" style="width:74px;vertical-align:top;padding-right:10px;"><a href="{{ product.href }}"><img class="ccp-product-image" src="{{ product.image }}" alt="{{ product.name }}" width="64" height="64" style="display:block;width:64px;height:64px;object-fit:contain;border:1px solid #edf1f5;border-radius:6px;background:#fff;"></a></td>{% endif %}
        <td style="vertical-align:top;word-break:break-word;overflow-wrap:anywhere;">{% if product.href %}<a href="{{ product.href }}" style="color:#0b6fd3;font-weight:700;text-decoration:none;">{{ product.name }}</a>{% else %}<strong>{{ product.name }}</strong>{% endif %}{% for option in product.option %}<br><small style="color:#667085;">{{ option.name }}: {{ option.value }}</small>{% endfor %}</td>
      </tr></table>
    </td></tr>
    <tr><td width="42%" style="padding:8px 12px;border-top:1px solid #dfe4ea;background:#f7fafc;font-weight:700;">{{ text_model }}</td><td style="padding:8px 12px;border-top:1px solid #dfe4ea;">{{ product.model }}</td></tr>
    <tr><td style="padding:8px 12px;border-top:1px solid #dfe4ea;background:#f7fafc;font-weight:700;">{{ text_quantity }}</td><td style="padding:8px 12px;border-top:1px solid #dfe4ea;">{{ product.quantity }}</td></tr>
    <tr><td style="padding:8px 12px;border-top:1px solid #dfe4ea;background:#f7fafc;font-weight:700;">{{ text_price }}</td><td style="padding:8px 12px;border-top:1px solid #dfe4ea;">{{ product.price }}</td></tr>
    <tr><td style="padding:8px 12px;border-top:1px solid #dfe4ea;background:#f7fafc;font-weight:700;">{{ text_total }}</td><td style="padding:8px 12px;border-top:1px solid #dfe4ea;font-weight:700;">{{ product.total }}</td></tr>
  </table>
  {% endfor %}

  {% for voucher in vouchers %}
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-collapse:collapse;border:1px solid #dfe4ea;margin-bottom:12px;table-layout:fixed;">
    <tr><td colspan="2" style="padding:12px;font-weight:700;">{{ voucher.description }}</td></tr>
    <tr><td width="42%" style="padding:8px 12px;border-top:1px solid #dfe4ea;background:#f7fafc;font-weight:700;">{{ text_quantity }}</td><td style="padding:8px 12px;border-top:1px solid #dfe4ea;">1</td></tr>
    <tr><td style="padding:8px 12px;border-top:1px solid #dfe4ea;background:#f7fafc;font-weight:700;">{{ text_total }}</td><td style="padding:8px 12px;border-top:1px solid #dfe4ea;font-weight:700;">{{ voucher.amount }}</td></tr>
  </table>
  {% endfor %}

  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-collapse:collapse;border:1px solid #dfe4ea;margin:18px 0;table-layout:fixed;">
    {% for total in totals %}<tr><td width="68%" style="padding:10px 12px;border-top:{% if loop.first %}0{% else %}1px{% endif %} solid #dfe4ea;text-align:right;font-weight:700;">{{ total.title }}:</td><td style="padding:10px 12px;border-top:{% if loop.first %}0{% else %}1px{% endif %} solid #dfe4ea;text-align:right;font-weight:700;white-space:normal;">{{ total.text }}</td></tr>{% endfor %}
  </table>

  <p style="margin:0;">{{ text_footer }}</p>
</td></tr></table>
</td></tr></table>
</body>
</html>
