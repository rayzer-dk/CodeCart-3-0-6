<!DOCTYPE html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1.0"><title>{{ text_received }}</title><style>
@media only screen and (max-width:620px){.ccp-wrap{width:100%!important;max-width:100%!important}.ccp-pad{padding:18px 14px!important}.ccp-stack,.ccp-stack td{display:block!important;width:100%!important;box-sizing:border-box!important}.ccp-mobile-center{text-align:center!important}.ccp-hide-mobile{display:none!important}.ccp-product-table thead{display:none!important}.ccp-product-table,.ccp-product-table tbody,.ccp-product-table tr,.ccp-product-table td{display:block!important;width:100%!important;box-sizing:border-box!important}.ccp-product-table tr{border-bottom:1px solid #e5e7eb!important;padding:10px 0!important}.ccp-product-table td{border:0!important;text-align:left!important;padding:6px 10px!important}.ccp-product-table td:before{display:inline-block!important;min-width:92px;font-weight:700;color:#667085}.ccp-product-table td:nth-child(2):before{content:'Model: '}.ccp-product-table td:nth-child(3):before{content:'Qty: '}.ccp-product-table td:nth-child(4):before{content:'Price: '}.ccp-product-table td:nth-child(5):before{content:'Total: '}.ccp-btn{display:block!important;width:100%!important;box-sizing:border-box!important;text-align:center!important}.ccp-address{margin-bottom:12px!important}.ccp-logo{max-width:300px!important;height:auto!important}}
</style></head><body style="margin:0;padding:24px 10px;background:#f4f6f8;font-family:Arial,Helvetica,sans-serif;font-size:14px;line-height:1.5;color:#1f2937;"><table role="presentation" width="100%" cellpadding="0" cellspacing="0"><tr><td align="center"><table role="presentation" class="ccp-wrap" width="600" cellpadding="0" cellspacing="0" style="width:100%;max-width:600px;background:#fff;border:1px solid #e5e7eb;border-radius:12px;overflow:hidden;"><tr><td class="ccp-pad" style="padding:26px;"><div style="text-align:center;padding-bottom:22px;border-bottom:1px solid #eef1f4;margin-bottom:24px;"><a href="{{ store_url }}"><img class="ccp-logo" src="{{ logo }}" alt="{{ store }}" width="{{ logo_width }}" height="{{ logo_height }}" style="display:block;width:{{ logo_width }}px;height:{{ logo_height }}px;max-width:300px;max-height:80px;object-fit:contain;margin:0 auto;border:0;"></a></div><h1 style="margin:0 0 18px;font-size:22px;color:#111827;">{{ text_received }}</h1><table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-collapse:collapse;margin-bottom:20px;border:1px solid #e5e7eb;"><tr><td style="padding:10px 12px;background:#f7fafc;font-weight:700;width:42%;">{{ text_order_id }}</td><td style="padding:10px 12px;">{{ order_id }}</td></tr><tr><td style="padding:10px 12px;background:#f7fafc;font-weight:700;border-top:1px solid #e5e7eb;">{{ text_date_added }}</td><td style="padding:10px 12px;border-top:1px solid #e5e7eb;">{{ date_added }}</td></tr><tr><td style="padding:10px 12px;background:#f7fafc;font-weight:700;border-top:1px solid #e5e7eb;">{{ text_order_status }}</td><td style="padding:10px 12px;border-top:1px solid #e5e7eb;">{{ order_status }}</td></tr></table><table class="ccp-product-table" role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-collapse:collapse;border:1px solid #e5e7eb;margin-bottom:20px;table-layout:fixed;"><thead><tr><td style="padding:10px;background:#f3f6f9;font-weight:700;">{{ text_product }}</td><td style="padding:10px;background:#f3f6f9;font-weight:700;">{{ text_model }}</td><td style="padding:10px;background:#f3f6f9;font-weight:700;text-align:right;">Qty</td><td style="padding:10px;background:#f3f6f9;font-weight:700;text-align:right;">Total</td></tr></thead><tbody>{% for product in products %}<tr><td style="padding:10px;border-top:1px solid #e5e7eb;">{{ product.name }}{% for option in product.option %}<br><small style="color:#667085;">{{ option.name }}: {{ option.value }}</small>{% endfor %}</td><td style="padding:10px;border-top:1px solid #e5e7eb;">{{ product.model }}</td><td style="padding:10px;border-top:1px solid #e5e7eb;text-align:right;">{{ product.quantity }}</td><td style="padding:10px;border-top:1px solid #e5e7eb;text-align:right;">{{ product.total }}</td></tr>{% endfor %}{% for voucher in vouchers %}<tr><td colspan="2" style="padding:10px;border-top:1px solid #e5e7eb;">{{ voucher.description }}</td><td style="padding:10px;border-top:1px solid #e5e7eb;text-align:right;">1</td><td style="padding:10px;border-top:1px solid #e5e7eb;text-align:right;">{{ voucher.amount }}</td></tr>{% endfor %}{% for total in totals %}<tr><td colspan="3" style="padding:10px;border-top:1px solid #e5e7eb;text-align:right;font-weight:700;">{{ total.title }}</td><td style="padding:10px;border-top:1px solid #e5e7eb;text-align:right;font-weight:700;">{{ total.value }}</td></tr>{% endfor %}</tbody></table>{% if comment %}<div style="padding:14px 16px;background:#f7fafc;border-left:3px solid #0b6fd3;">{{ comment }}</div>{% endif %}</td></tr></table></td></tr></table></body></html>