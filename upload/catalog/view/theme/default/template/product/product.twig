<script type="text/javascript"><!--
$(function() {
	var selector = '.input-group.date, .input-group.datetime, .input-group.time';

	function initPicker(group) {
		var $group = $(group);
		if (typeof $.fn.datetimepicker !== 'function' || $group.data('ccp-datetime-ready')) { return; }

		var options = {language: '{{ datepicker }}'};
		if ($group.hasClass('date')) { options.pickTime = false; }
		else if ($group.hasClass('time')) { options.pickDate = false; }
		else { options.pickDate = true; options.pickTime = true; }

		$group.datetimepicker(options);
		$group.data('ccp-datetime-ready', 1);
	}

	// Initialize before the first user interaction. Bootstrap DateTimePicker already
	// handles its calendar button; a second show() in the same click toggles it closed.
	$(selector).each(function() { initPicker(this); });

	// Dynamic option fragments can still appear after page load. Initialize them
	// without issuing a second show() command on the calendar button event.
	$(document).on('focusin mouseenter', selector + ' input, ' + selector + ' button', function(event) {
		var group = $(event.target).closest(selector).get(0);
		if (group) { initPicker(group); }
	});
});

$('button[id^=\'button-upload\']').on('click', function() {
	var node = this;

	$('#form-upload').remove();

	$('body').prepend('<form enctype="multipart/form-data" id="form-upload" style="display: none;"><input type="file" name="file" /></form>');

	$('#form-upload input[name=\'file\']').trigger('click');

	if (typeof timer != 'undefined') {
    	clearInterval(timer);
	}

	timer = setInterval(function() {
		if ($('#form-upload input[name=\'file\']').val() != '') {
			clearInterval(timer);

			$.ajax({
				url: 'index.php?route=tool/upload',
				type: 'post',
				dataType: 'json',
				data: new FormData($('#form-upload')[0]),
				cache: false,
				contentType: false,
				processData: false,
				beforeSend: function() {
					$(node).button('loading');
				},
				complete: function() {
					$(node).button('reset');
				},
				success: function(json) {
					$('.text-danger').remove();

					if (json['error']) {
						$(node).parent().find('input').after('<div class="text-danger">' + json['error'] + '</div>');
					}

					if (json['success']) {
						if (window.CodeCartUI) { window.CodeCartUI.toast('success', json['success']); } else { alert(json['success']); }

						$(node).parent().find('input').val(json['code']);
					}
				},
				error: function(xhr, ajaxOptions, thrownError) {
					if (window.CodeCartUI) { window.CodeCartUI.error(xhr, thrownError); } else { alert(thrownError + "\r\n" + xhr.statusText); }
				}
			});
		}
	}, 500);
});
//--></script> 
