{{ header }}
<div id="product-product" class="container">
  <ul class="breadcrumb">
    {% for breadcrumb in breadcrumbs %}
    <li>{% if loop.last %}<span aria-current="page">{{ breadcrumb.text }}</span>{% else %}<a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a>{% endif %}</li>
    {% endfor %}
  </ul>
  <div class="row">{{ column_left }}
    {% if column_left and column_right %}
    {% set class = 'col-sm-6' %}
    {% elseif column_left or column_right %}
    {% set class = 'col-sm-9' %}
    {% else %}
    {% set class = 'col-sm-12' %}
    {% endif %}
    <div id="content" class="{{ class }}">{{ content_top }}
      <div class="row ccp-product-main"> {% if column_left or column_right %}
        {% set class = 'col-sm-6' %}
        {% else %}
        {% set class = 'col-md-6' %}
        {% endif %}
        <div class="{{ class }} ccp-product-media{% if image_is_fallback %} ccp-product-media--fallback{% endif %}"> {% if thumb or images %}
          <ul class="thumbnails">
            {% if thumb %}
            <li><a class="thumbnail ccp-main-product-image" id="ccp-main-product-image" href="{{ popup }}" title="{{ heading_title }}" data-pswp-width="{{ image_popup_width }}" data-pswp-height="{{ image_popup_height }}" data-default-href="{{ popup }}" data-default-width="{{ image_popup_width }}" data-default-height="{{ image_popup_height }}"><img id="ccp-main-product-image-img" src="{{ thumb }}" data-default-src="{{ thumb }}" title="{{ heading_title }}" alt="{{ heading_title }}" width="{{ image_display_width }}" height="{{ image_display_height }}" fetchpriority="high" /></a></li>
            {% endif %}
            {% if images %}
            {% for image in images %}
            <li class="image-additional"><a class="thumbnail ccp-product-gallery-thumb" href="{{ image.popup }}" title="{{ heading_title }}" data-main-src="{{ image.main }}" data-popup-src="{{ image.popup }}" data-pswp-width="{{ image.width }}" data-pswp-height="{{ image.height }}"> <img src="{{ image.thumb }}" title="{{ heading_title }}" alt="{{ heading_title }}" width="{{ image_additional_width }}" height="{{ image_additional_height }}" loading="lazy" decoding="async" /></a></li>
            {% endfor %}
            {% endif %}
          </ul>
          {% endif %}
        </div>
        {% if column_left or column_right %}
        {% set class = 'col-sm-6' %}
        {% else %}
        {% set class = 'col-md-6' %}
        {% endif %}
        <div class="{{ class }} ccp-product-summary">
          <div class="ccp-product-summary-card">
          <h1>{{ heading_title }}</h1>
          <ul class="list-unstyled ccp-product-meta">
            {% if manufacturer %}
            <li>{{ text_manufacturer }} <a href="{{ manufacturers }}">{{ manufacturer }}</a></li>
            {% endif %}
            <li>{{ text_model }} {{ model }}</li>
            {% if reward %}
            <li>{{ text_reward }} {{ reward }}</li>
            {% endif %}
            <li>{{ text_stock }} {{ stock }}</li>
          </ul>
          {% if price %}
          <ul class="list-unstyled ccp-product-pricing" aria-live="polite">
            <li class="ccp-product-price-old-row"{% if not special %} style="display:none"{% endif %}><span class="ccp-product-price-old">{{ price }}</span></li>
            <li><h2 class="price ccp-product-price{% if special %} is-special{% endif %}">{% if special %}{{ special }}{% else %}{{ price }}{% endif %}</h2></li>
            <li class="ccp-product-price-qty-row" style="display:none"><small class="ccp-product-price-qty"></small></li>
            {% if tax %}
            <li class="ccp-product-tax-row">{{ text_tax }} <span class="ccp-product-tax">{{ tax }}</span></li>
            {% endif %}
            {% if points %}
            <li>{{ text_points }} {{ points }}</li>
            {% endif %}
            {% if discounts %}
            <li>
              <hr>
            </li>
            {% for discount in discounts %}
            <li>{{ discount.quantity }}{{ text_discount }}{{ discount.price }}</li>
            {% endfor %}
            {% endif %}
          </ul>
          {% endif %}
          <div id="product" class="ccp-product-order"> {% if options %}
            <hr>
            <h3>{{ text_option }}</h3>
            {% for option in options %}
            {% if option.type == 'select' %}
            <div class="form-group{% if option.required %} required {% endif %}">
              <label class="control-label" for="input-option{{ option.product_option_id }}">{{ option.name }}</label>
              <select name="option[{{ option.product_option_id }}]" id="input-option{{ option.product_option_id }}" class="form-control">
                <option value="">{{ text_select }}</option>
                {% for option_value in option.product_option_value %}
                <option value="{{ option_value.product_option_value_id }}" data-stock-available="{{ option_value.available }}"{% if option_value.image_main %} data-image-main="{{ option_value.image_main }}" data-image-popup="{{ option_value.image_popup }}" data-image-width="{{ option_value.image_popup_width }}" data-image-height="{{ option_value.image_popup_height }}"{% endif %}>{{ option_value.name }}{% if not option_value.available %} — {{ text_option_out_of_stock }}{% endif %}
                {% if option_value.price %}
                ({{ option_value.price_prefix }}{{ option_value.price }})
                {% endif %} </option>
                {% endfor %}
              </select>
            </div>
            {% endif %}
            {% if option.type == 'radio' or option.type == 'image' %}
            <div class="form-group{% if option.required %} required {% endif %}">
              <label class="control-label">{{ option.name }}</label>
              <div id="input-option{{ option.product_option_id }}"> {% for option_value in option.product_option_value %}
                <div class="radio">
                  <label>
                    <input type="radio" name="option[{{ option.product_option_id }}]" value="{{ option_value.product_option_value_id }}" data-stock-available="{{ option_value.available }}"{% if option_value.image_main %} data-image-main="{{ option_value.image_main }}" data-image-popup="{{ option_value.image_popup }}" data-image-width="{{ option_value.image_popup_width }}" data-image-height="{{ option_value.image_popup_height }}"{% endif %} />
                    {% if option_value.image %} <img src="{{ option_value.image }}" alt="{{ option_value.name }} {% if option_value.price %} {{ option_value.price_prefix }} {{ option_value.price }} {% endif %}" class="img-thumbnail" /> {% endif %}                  
                    {{ option_value.name }}{% if not option_value.available %} — {{ text_option_out_of_stock }}{% endif %}
                    {% if option_value.price %}
                    ({{ option_value.price_prefix }}{{ option_value.price }})
                    {% endif %} </label>
                </div>
                {% endfor %} </div>
            </div>
            {% endif %}
            {% if option.type == 'checkbox' %}
            <div class="form-group{% if option.required %} required {% endif %}">
              <label class="control-label">{{ option.name }}</label>
              <div id="input-option{{ option.product_option_id }}"> {% for option_value in option.product_option_value %}
                <div class="checkbox">
                  <label>
                    <input type="checkbox" name="option[{{ option.product_option_id }}][]" value="{{ option_value.product_option_value_id }}" data-stock-available="{{ option_value.available }}"{% if option_value.image_main %} data-image-main="{{ option_value.image_main }}" data-image-popup="{{ option_value.image_popup }}" data-image-width="{{ option_value.image_popup_width }}" data-image-height="{{ option_value.image_popup_height }}"{% endif %} />
                    {% if option_value.image %} <img src="{{ option_value.image }}" alt="{{ option_value.name }} {% if option_value.price %} {{ option_value.price_prefix }} {{ option_value.price }} {% endif %}" class="img-thumbnail" /> {% endif %}
                    {{ option_value.name }}{% if not option_value.available %} — {{ text_option_out_of_stock }}{% endif %}
                    {% if option_value.price %}
                    ({{ option_value.price_prefix }}{{ option_value.price }})
                    {% endif %} </label>
                </div>
                {% endfor %} </div>
            </div>
            {% endif %}
            {% if option.type == 'text' %}
            <div class="form-group{% if option.required %} required {% endif %}">
              <label class="control-label" for="input-option{{ option.product_option_id }}">{{ option.name }}</label>
              <input type="text" name="option[{{ option.product_option_id }}]" value="{{ option.value }}" placeholder="{{ option.name }}" id="input-option{{ option.product_option_id }}" class="form-control" />
            </div>
            {% endif %}
            {% if option.type == 'textarea' %}
            <div class="form-group{% if option.required %} required {% endif %}">
              <label class="control-label" for="input-option{{ option.product_option_id }}">{{ option.name }}</label>
              <textarea name="option[{{ option.product_option_id }}]" rows="5" placeholder="{{ option.name }}" id="input-option{{ option.product_option_id }}" class="form-control">{{ option.value }}</textarea>
            </div>
            {% endif %}
            {% if option.type == 'file' %}
            <div class="form-group{% if option.required %} required {% endif %}">
              <label class="control-label">{{ option.name }}</label>
              <button type="button" id="button-upload{{ option.product_option_id }}" data-loading-text="{{ text_loading }}" class="btn btn-default btn-block"><i class="fa fa-upload"></i> {{ button_upload }}</button>
              <input type="hidden" name="option[{{ option.product_option_id }}]" value="" id="input-option{{ option.product_option_id }}" />
            </div>
            {% endif %}
            {% if option.type == 'date' %}
            <div class="form-group{% if option.required %} required {% endif %}">
              <label class="control-label" for="input-option{{ option.product_option_id }}">{{ option.name }}</label>
              <div class="input-group date">
                <input type="text" name="option[{{ option.product_option_id }}]" value="{{ option.value }}" data-date-format="YYYY-MM-DD" id="input-option{{ option.product_option_id }}" class="form-control" />
                <span class="input-group-btn">
                <button class="btn btn-default" type="button" title="{{ option.name }}" aria-label="{{ option.name }}"><i class="fa fa-calendar" aria-hidden="true"></i></button>
                </span></div>
            </div>
            {% endif %}
            {% if option.type == 'datetime' %}
            <div class="form-group{% if option.required %} required {% endif %}">
              <label class="control-label" for="input-option{{ option.product_option_id }}">{{ option.name }}</label>
              <div class="input-group datetime">
                <input type="text" name="option[{{ option.product_option_id }}]" value="{{ option.value }}" data-date-format="YYYY-MM-DD HH:mm" id="input-option{{ option.product_option_id }}" class="form-control" />
                <span class="input-group-btn">
                <button type="button" class="btn btn-default" title="{{ option.name }}" aria-label="{{ option.name }}"><i class="fa fa-calendar" aria-hidden="true"></i></button>
                </span></div>
            </div>
            {% endif %}
            {% if option.type == 'time' %}
            <div class="form-group{% if option.required %} required {% endif %}">
              <label class="control-label" for="input-option{{ option.product_option_id }}">{{ option.name }}</label>
              <div class="input-group time">
                <input type="text" name="option[{{ option.product_option_id }}]" value="{{ option.value }}" data-date-format="HH:mm" id="input-option{{ option.product_option_id }}" class="form-control" />
                <span class="input-group-btn">
                <button type="button" class="btn btn-default" title="{{ option.name }}" aria-label="{{ option.name }}"><i class="fa fa-calendar" aria-hidden="true"></i></button>
                </span></div>
            </div>
            {% endif %}
            {% endfor %}
            {% endif %}
            {% if recurrings %}
            <hr>
            <h3>{{ text_payment_recurring }}</h3>
            <div class="form-group required">
              <select name="recurring_id" class="form-control">
                <option value="">{{ text_select }}</option>
                {% for recurring in recurrings %}
                <option value="{{ recurring.recurring_id }}">{{ recurring.name }}</option>
                {% endfor %}
              </select>
              <div class="help-block" id="recurring-description"></div>
            </div>
            {% endif %}
            <div class="form-group ccp-product-purchase">
              <label class="control-label" for="input-quantity">{{ entry_qty }}</label>
              <div class="ccp-product-buy-row">
                <div class="input-group ccp-quantity-control">
                  <span class="input-group-btn"><button type="button" class="btn btn-default ccp-qty-minus" title="{{ text_quantity_decrease }}" aria-label="{{ text_quantity_decrease }}"><i class="fa fa-minus"></i></button></span>
                  <input type="text" name="quantity" value="{{ minimum }}" size="2" id="input-quantity" class="form-control text-center" inputmode="numeric" pattern="[0-9]*" />
                  <span class="input-group-btn"><button type="button" class="btn btn-default ccp-qty-plus" title="{{ text_quantity_increase }}" aria-label="{{ text_quantity_increase }}"><i class="fa fa-plus"></i></button></span>
                </div>
                <input type="hidden" name="product_id" value="{{ product_id }}" />
                {% if can_buy %}<button type="button" id="button-cart" data-loading-text="{{ text_loading }}" class="btn btn-primary btn-lg ccp-button-cart ccp-cart-add" data-product-id="{{ product_id }}" title="{{ button_cart }}" aria-label="{{ button_cart }}"><i class="fa fa-shopping-cart"></i> {{ button_cart }}</button>{% else %}<button type="button" id="button-cart" class="btn btn-default btn-lg ccp-button-cart is-out-of-stock" disabled="disabled" title="{{ stock }}" aria-label="{{ stock }}"><i class="fa fa-ban"></i> {{ stock }}</button>{% endif %}
                {% if not can_buy or has_unavailable_option %}
                <div id="stock-notify-box" class="well well-sm" style="margin-top:10px;{% if can_buy %}display:none;{% endif %}">
                  <label for="stock-notify-email">{{ text_stock_notify }}</label>
                  <div class="input-group">
                    <input type="email" id="stock-notify-email" class="form-control" value="{{ stock_notify_email }}" placeholder="{{ entry_stock_notify_email }}" autocomplete="email">
                    <span class="input-group-btn"><button type="button" id="button-stock-notify" class="btn btn-primary"><i class="fa fa-bell"></i> {{ button_stock_notify }}</button></span>
                  </div>
                  <div id="stock-notify-message" class="help-block"></div>
                </div>
                {% endif %}
              </div>
              <div class="ccp-product-secondary-actions">
                <button type="button" class="btn btn-default" title="{{ button_wishlist }}" aria-label="{{ button_wishlist }}" onclick="wishlist.add('{{ product_id }}');"><i class="fa fa-heart-o"></i> <span class="ccp-action-text">{{ button_wishlist }}</span></button>
                <button type="button" class="btn btn-default" title="{{ button_compare }}" aria-label="{{ button_compare }}" onclick="compare.add('{{ product_id }}');"><i class="fa fa-bar-chart"></i> <span class="ccp-action-text">{{ button_compare }}</span></button>
                <div class="ccp-product-share">
                  <button type="button" class="btn btn-default ccp-share-toggle" aria-expanded="false" title="{{ button_share }}" aria-label="{{ button_share }}"><i class="fa fa-share-alt"></i> <span class="ccp-action-text">{{ button_share }}</span></button>
                  <div class="ccp-share-menu" role="menu" aria-label="{{ button_share }}">
                    <div class="ccp-share-head"><strong>{{ button_share }}</strong><button type="button" class="ccp-share-close" data-share-close title="{{ button_close }}" aria-label="{{ button_close }}"><i class="fa fa-times"></i></button></div>
                    <button type="button" class="ccp-share-copy" data-share="copy"><i class="fa fa-link"></i> <span>{{ text_copy_link }}</span></button>
                    <a href="#" data-share="facebook"><i class="fa-brands fa-facebook"></i> Facebook</a>
                    <a href="#" data-share="telegram"><i class="fa-brands fa-telegram"></i> Telegram</a>
                    <a href="#" data-share="whatsapp"><i class="fa-brands fa-whatsapp"></i> WhatsApp</a>
                    <a href="#" data-share="viber"><i class="fa-brands fa-viber"></i> Viber</a>
                    <a href="#" data-share="x"><i class="fa-brands fa-x-twitter"></i> X</a>
                    <a href="#" data-share="email"><i class="fa fa-envelope"></i> Email</a>
                  </div>
                </div>
              </div>
            </div>
            {% if minimum > 1 %}
            <div class="alert alert-info ccp-minimum-alert"><i class="fa fa-info-circle"></i> {{ text_minimum }}</div>
            {% endif %}
            {% if purchase_blocks_html %}{{ purchase_blocks_html|raw }}{% endif %}
          </div>
          </div>
        </div>
      </div>
      <div class="ccp-product-tabs">
          <ul class="nav nav-tabs">
            <li class="active"><a href="#tab-description" data-toggle="tab">{{ tab_description }}</a></li>
            {% if public_documents %}<li><a href="#tab-documents" data-toggle="tab"><i class="fa fa-file-pdf-o"></i> {{ text_public_documents }}</a></li>{% endif %}
            {% if attribute_groups %}
            <li><a href="#tab-specification" data-toggle="tab">{{ tab_attribute }}</a></li>
            {% endif %}
            {% if extra_tab_title and extra_tab_content %}
            <li><a href="#tab-extra" data-toggle="tab">{{ extra_tab_title }}</a></li>
            {% endif %}
            {% if review_status %}
            <li><a href="#tab-review" data-toggle="tab">{{ tab_review }}</a></li>
            {% endif %}
          </ul>
          <div class="tab-content">
            <div class="tab-pane active" id="tab-description">{{ description }}</div>
            {% if public_documents %}<div class="tab-pane" id="tab-documents"><ul class="list-unstyled cc-public-documents">
             {% for doc in public_documents %}<li style="margin-bottom:9px;"><a href="{{ doc.href }}" rel="nofollow"><i class="fa fa-download"></i> {{ doc.title }}</a> <small class="text-muted">({{ (doc.filesize / 1024)|round(1) }} KB)</small></li>{% endfor %}
             </ul></div>{% endif %}
            {% if attribute_groups %}
            <div class="tab-pane" id="tab-specification">
              <div class="ccp-specifications">
                {% for attribute_group in attribute_groups %}
                <section class="ccp-spec-group">
                  <h3 class="ccp-spec-title">{{ attribute_group.name }}</h3>
                  <div class="ccp-spec-list">
                    {% for attribute in attribute_group.attribute %}
                    <div class="ccp-spec-row">
                      <div class="ccp-spec-name">{{ attribute.name }}</div>
                      <span class="ccp-spec-leader" aria-hidden="true"></span>
                      <div class="ccp-spec-value">{{ attribute.text }}</div>
                    </div>
                    {% endfor %}
                  </div>
                </section>
                {% endfor %}
              </div>
            </div>
            {% endif %}
            {% if extra_tab_title and extra_tab_content %}
            <div class="tab-pane" id="tab-extra">{{ extra_tab_content }}</div>
            {% endif %}
            {% if review_status %}
            <div class="tab-pane" id="tab-review">
              <form class="form-horizontal" id="form-review">
                <div id="review"></div>
                <h2>{{ text_write }}</h2>
                {% if review_guest %}
                <div class="form-group required">
                  <div class="col-sm-12">
                    <label class="control-label" for="input-name">{{ entry_name }}</label>
                    <input type="text" name="name" value="{{ customer_name }}" id="input-name" class="form-control" />
                  </div>
                </div>
                <div class="form-group required">
                  <div class="col-sm-12">
                    <label class="control-label" for="input-review">{{ entry_review }}</label>
                    <textarea name="text" rows="5" id="input-review" class="form-control"></textarea>
                  </div>
                </div>
                <div class="form-group required">
                  <div class="col-sm-12">
                    <label class="control-label">{{ entry_rating }}</label>
                    <div class="ccp-rating-picker" role="radiogroup" aria-label="{{ entry_rating }}" data-rating="0">
                      {% for score in [1,2,3,4,5] %}
                      <input type="radio" name="rating" value="{{ score }}" id="rating-{{ score }}" />
                      <label for="rating-{{ score }}" data-score="{{ score }}" title="{{ score }}/5" aria-label="{{ score }}/5"><i class="fa-solid fa-star" aria-hidden="true"></i></label>
                      {% endfor %}
                    </div></div>
                </div>
                {{ captcha }}
                <div class="buttons clearfix">
                  <div class="pull-right">
                    <button type="button" id="button-review" data-loading-text="{{ text_loading }}" class="btn btn-primary">{{ button_continue }}</button>
                  </div>
                </div>
                {% else %}
                {{ text_login }}
                {% endif %}
              </form>
            </div>
            {% endif %}</div>
      </div>
      
      {% if products %}
      <div class="ccp-native-module ccp-native-module--products ccp-native-module--carousel ccp-product-related-carousel" style="--ccp-module-cols-desktop:4;--ccp-module-cols-tablet:3;--ccp-module-cols-mobile:2" data-autoplay="0" data-autoplay-delay="5000" data-loop="1" data-step="item">
        <div class="ccp-native-module-heading"><h3>{{ text_related }}</h3><div class="ccp-native-module-arrows"><button type="button" class="ccp-native-module-prev" title="{{ text_previous_related }}" aria-label="{{ text_previous_related }}"><i class="fa fa-angle-left" aria-hidden="true"></i></button><button type="button" class="ccp-native-module-next" title="{{ text_next_related }}" aria-label="{{ text_next_related }}"><i class="fa fa-angle-right" aria-hidden="true"></i></button></div></div>
        <div class="ccp-native-module-viewport"><div class="ccp-native-module-track">
        {% for product in products %}
          <div class="product-layout ccp-native-module-item">
            <div class="product-thumb transition">
              <div class="image"><a href="{{ product.href }}"><img src="{{ product.thumb }}" alt="{{ product.name }}" title="{{ product.name }}" width="{{ image_related_width }}" height="{{ image_related_height }}" loading="lazy" decoding="async" class="img-responsive" /></a></div>
              <div class="ccp-product-list-body"><div class="caption">
                <h4><a href="{{ product.href }}">{{ product.name }}</a></h4>
                {% if card_content in ['description','both'] and product.description %}<p class="ccp-card-description">{{ product.description|e }}</p>{% endif %}{% if card_content in ['attributes','both'] and product.attributes %}<ul class="ccp-card-attributes">{% for attribute in product.attributes %}<li><span title="{{ attribute.name }}">{{ attribute.name }}</span><strong title="{{ attribute.text }}">{{ attribute.text }}</strong></li>{% endfor %}</ul>{% endif %}
                {% if product.rating %}<div class="rating">{% for j in 1..5 %}{% if product.rating < j %}<span class="fa fa-stack"><i class="fa fa-star-o fa-stack-1x"></i></span>{% else %}<span class="fa fa-stack"><i class="fa fa-star fa-stack-1x"></i><i class="fa fa-star-o fa-stack-1x"></i></span>{% endif %}{% endfor %}</div>{% endif %}
                {% if product.price %}<p class="price">{% if not product.special %}{{ product.price }}{% else %}<span class="price-new">{{ product.special }}</span> <span class="price-old">{{ product.price }}</span>{% endif %}{% if product.tax %}<span class="price-tax">{{ product.tax_label ? product.tax_label : text_tax }} {{ product.tax }}</span>{% endif %}</p>{% endif %}
              </div><div class="button-group">
                {% if product.can_buy is not defined or product.can_buy %}<button type="button" onclick="cart.add('{{ product.product_id }}', '{{ product.minimum }}');" class="ccp-cart-add" data-product-id="{{ product.product_id }}" title="{{ button_cart }}" aria-label="{{ button_cart }}"><i class="fa fa-shopping-cart"></i> <span class="hidden-xs hidden-sm hidden-md">{{ button_cart }}</span></button>{% else %}<button type="button" class="ccp-cart-add is-out-of-stock" disabled="disabled" title="{{ product.stock_status }}" aria-label="{{ product.stock_status }}"><i class="fa fa-ban"></i> <span class="ccp-stock-status">{{ product.stock_status }}</span></button>{% endif %}
                <button type="button" data-toggle="tooltip" title="{{ button_wishlist }}" aria-label="{{ button_wishlist }}" onclick="wishlist.add('{{ product.product_id }}');"><i class="fa fa-heart"></i></button>
                <button type="button" data-toggle="tooltip" title="{{ button_compare }}" aria-label="{{ button_compare }}" onclick="compare.add('{{ product.product_id }}');"><i class="fa fa-exchange"></i></button>
              </div></div>
            </div>
          </div>
        {% endfor %}
        </div></div>
        <div class="ccp-native-module-pagination" aria-label="{{ text_related }}"></div>
      </div>
      {% endif %}
        {% if tags %}
        <p class="ccp-product-tags"><strong>{{ text_tags }}</strong>
        {% for i in 0..tags|length - 1 %}
        {% if i < (tags|length - 1) %} <a href="{{ tags[i].href }}">{{ tags[i].tag }}</a>,
        {% else %} <a href="{{ tags[i].href }}">{{ tags[i].tag }}</a> {% endif %}
        {% endfor %} </p>
        {% endif %}
      {% if internal_links %}
<div class="ccp-internal-links">
  <h3>{{ text_internal_links }}</h3>
  <ul class="list-inline">
    {% for link in internal_links %}<li><a href="{{ link.href }}">{{ link.title }}</a></li>{% endfor %}
  </ul>
</div>
{% endif %}
      {{ content_bottom }}</div>
    {{ column_right }}</div>
</div>
<script type="text/javascript"><!--
$('select[name=\'recurring_id\'], input[name="quantity"]').change(function(){
	$.ajax({
