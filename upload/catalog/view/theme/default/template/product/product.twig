// Option-image preview: storefront presentation only. Native option values and cart payload stay unchanged.
(function($){
  var $anchor=$('#ccp-main-product-image'), $img=$('#ccp-main-product-image-img');
  if(!$anchor.length||!$img.length){return;}
  function restore(){
    $img.attr('src',$img.attr('data-default-src')||$img.attr('src'));
    $anchor.attr('href',$anchor.attr('data-default-href')||$anchor.attr('href'));
    $anchor.attr('data-pswp-width',$anchor.attr('data-default-width')||'1');
    $anchor.attr('data-pswp-height',$anchor.attr('data-default-height')||'1');
  }
  function apply($node){
    if(!$node||!$node.length){restore();return;}
    var main=$node.attr('data-image-main')||'', popup=$node.attr('data-image-popup')||'', width=$node.attr('data-image-width')||'', height=$node.attr('data-image-height')||'';
    if(!main||!popup){restore();return;}
    $img.attr('src',main);
    $anchor.attr('href',popup);
    if(width){$anchor.attr('data-pswp-width',width);}
    if(height){$anchor.attr('data-pswp-height',height);}
  }
  function resolveChanged(node){
    var $node=$(node);
    if($node.is('select')){var $selected=$node.find('option:selected');apply($selected.attr('data-image-main')?$selected:$());return;}
    if($node.is(':radio')){if($node.is(':checked')){apply($node);}return;}
    if($node.is(':checkbox')){
      if($node.is(':checked')&&$node.attr('data-image-main')){apply($node);return;}
      var $last=$('#product input[name^="option["]:checked[data-image-main]').last();
      apply($last);
    }
  }
  $('#product').on('change','select[name^="option["],input[name^="option["]',function(){resolveChanged(this);});
})(jQuery);

// Product gallery: thumbnail click swaps the main photo; swipe/drag on the main
// photo steps through the gallery without changing product or option data.
(function($){
  var $main=$('#ccp-main-product-image'),$mainImg=$('#ccp-main-product-image-img'),$thumbs=$('#product-product .ccp-product-gallery-thumb');
  if(!$main.length||!$mainImg.length){return;}
  var items=[{main:$mainImg.attr('data-default-src')||$mainImg.attr('src'),popup:$main.attr('data-default-href')||$main.attr('href'),width:$main.attr('data-default-width')||$main.attr('data-pswp-width'),height:$main.attr('data-default-height')||$main.attr('data-pswp-height'),node:null}],index=0,startX=null,dragClick=false;
  $thumbs.each(function(){var $a=$(this);items.push({main:$a.attr('data-main-src')||$a.find('img').attr('src'),popup:$a.attr('data-popup-src')||$a.attr('href'),width:$a.attr('data-pswp-width')||'1',height:$a.attr('data-pswp-height')||'1',node:this});});
  function show(i){if(!items.length)return;index=(i+items.length)%items.length;var it=items[index];$mainImg.attr('src',it.main);$main.attr('href',it.popup).attr('data-pswp-width',it.width).attr('data-pswp-height',it.height);$thumbs.removeClass('is-active').parent().removeClass('is-active');if(it.node){$(it.node).addClass('is-active').parent().addClass('is-active');}}
  $thumbs.on('click',function(e){e.preventDefault();for(var i=1;i<items.length;i++){if(items[i].node===this){show(i);break;}}});
  $mainImg.attr('draggable','false');
  $main.on('pointerdown',function(e){if(e.pointerType==='mouse'&&e.button!==0)return;startX=e.clientX;dragClick=false;if(this.setPointerCapture&&e.pointerId!==undefined){try{this.setPointerCapture(e.pointerId);}catch(ignore){}}});
  $main.on('pointermove',function(e){if(startX!==null&&Math.abs(e.clientX-startX)>12){dragClick=true;}});
  $main.on('pointerup pointercancel',function(e){if(startX===null)return;var delta=e.clientX-startX;startX=null;if(Math.abs(delta)>=45&&items.length>1){e.preventDefault();e.stopImmediatePropagation();show(index+(delta<0?1:-1));dragClick=true;}});
  $main.on('click',function(e){if(dragClick){e.preventDefault();e.stopImmediatePropagation();dragClick=false;}});
})(jQuery);

$(document).ready(function() {
{% if gallery_engine == 'photoswipe' %}
	var ccpProductLightbox = null;
	var ccpGallerySelector = '#product-product .ccp-product-media .thumbnails';
	if (typeof PhotoSwipeLightbox === 'function' && typeof PhotoSwipe !== 'undefined') {
		ccpProductLightbox = new PhotoSwipeLightbox({
			gallery: ccpGallerySelector,
			children: 'a.thumbnail',
			pswpModule: PhotoSwipe,
			bgOpacity: 0.92,
			wheelToZoom: true,
			preload: [1, 2],
			showHideAnimationType: 'none',
			showAnimationDuration: 0,
			hideAnimationDuration: 0,
			imageClickAction: 'zoom-or-close',
			tapAction: 'toggle-controls',
			doubleTapAction: 'zoom'
		});
		// Product thumbnails are fixed-size catalog crops. Using them as PhotoSwipe
		// msrc placeholders gives additional photos the wrong aspect ratio and causes
		// a visible resize/jump when the full image arrives. Reserve the slide from
		// data-pswp-width/height and wait for the real image instead.
		ccpProductLightbox.addFilter('itemData', function(itemData) {
			itemData.msrc = null;
			return itemData;
		});
		ccpProductLightbox.init();
	}
{% else %}
	$('.thumbnails').magnificPopup({
		type:'image',
		delegate: 'a',
		gallery: { enabled: true, navigateByImgClick: true, preload: [0, 1] },
		image: { verticalFit: true }
	});
{% endif %}
});
//--></script> 

<script>
(function(){
 var baseAvailable={{ can_buy ? 'true' : 'false' }};
 var originalCartHtml=$('#button-cart').html();
 function selectedUnavailable(){
   var unavailable=false;
   $('#product select option:selected[data-stock-available="0"], #product input[type="radio"]:checked[data-stock-available="0"], #product input[type="checkbox"]:checked[data-stock-available="0"]').each(function(){unavailable=true;});
   return unavailable;
 }
 function refreshStockState(){
   var unavailable=selectedUnavailable();
   if(!baseAvailable || unavailable){
     $('#button-cart').prop('disabled',true).addClass('is-out-of-stock').removeClass('btn-primary').addClass('btn-default');
     $('#stock-notify-box').show();
   }else{
     $('#button-cart').prop('disabled',false).removeClass('is-out-of-stock btn-default').addClass('btn-primary').html(originalCartHtml);
     $('#stock-notify-box').hide();
   }
 }
 $(document).on('change','#product select[name^="option"],#product input[name^="option"]',refreshStockState);
 refreshStockState();
 $(document).on('click','#button-stock-notify',function(){
   var $b=$(this),$m=$('#stock-notify-message'); $m.removeClass('text-danger text-success').text(''); $b.prop('disabled',true);
   var data=$('#product :input[name^="option["]').serializeArray(); data.push({name:'email',value:$('#stock-notify-email').val()});
   $.ajax({url:'{{ stock_notify_url }}',type:'post',dataType:'json',data:$.param(data),complete:function(){$b.prop('disabled',false);},success:function(j){if(j.error){$m.addClass('text-danger').text(j.error);}else if(j.success){$m.addClass('text-success').text(j.success);}},error:function(){$m.addClass('text-danger').text('{{ error_stock_notify }}');}});
 });
})();
</script>
