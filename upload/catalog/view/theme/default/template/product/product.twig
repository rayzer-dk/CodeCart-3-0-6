<script type="text/javascript"><!--
(function(){
  var minimum = Math.max(1, parseInt('{{ minimum }}', 10) || 1);
  function quantityValue(){ var v = parseInt($('#input-quantity').val(), 10); return isNaN(v) ? minimum : Math.max(minimum, v); }
  $('.ccp-qty-minus').on('click', function(){ $('#input-quantity').val(Math.max(minimum, quantityValue() - 1)).trigger('change'); });
  $('.ccp-qty-plus').on('click', function(){ $('#input-quantity').val(quantityValue() + 1).trigger('change'); });
  $('#input-quantity').on('blur', function(){ $(this).val(quantityValue()); });
})();
//--></script>
<script type="text/javascript"><!--
(function(){
  var endpoint = {{ price_preview_url|json_encode|raw }};
  var timer = null, request = null;
  function refreshPrice(){
    if (!endpoint || !$('.ccp-product-price').length) return;
    if (request && request.readyState !== 4) request.abort();
    request = $.ajax({
      url:endpoint, type:'post', dataType:'json', data:$('#product input, #product select, #product textarea').serialize(),
      success:function(json){
        if (!json || json.error || json.visible === false) return;
        $('.ccp-product-price').text(json.total || json.unit || '').toggleClass('is-special', !!json.regular_total);
        var $oldRow=$('.ccp-product-price-old-row');
        if(json.regular_total){$('.ccp-product-price-old').text(json.regular_total);$oldRow.show();}else{$oldRow.hide();}
        var $qtyRow=$('.ccp-product-price-qty-row');
        if(json.quantity_line){$('.ccp-product-price-qty').text(json.quantity_line);$qtyRow.show();}else{$qtyRow.hide();}
        if(typeof json.tax_total !== 'undefined') $('.ccp-product-tax').text(json.tax_total);
      }
    });
  }
  function queue(){ window.clearTimeout(timer); timer=window.setTimeout(refreshPrice,120); }
  $('#product').on('change input','select[name^="option"], input[name^="option"], #input-quantity',queue);
})();
//--></script>
<script type="text/javascript"><!--
(function(){
  var $share = $('.ccp-product-share');
  if (!$share.length) return;
  var $toggle = $share.find('.ccp-share-toggle');
  var url = window.location.href.split('#')[0];
  var title = {{ heading_title|json_encode|raw }};
  function closeShare(){ $share.removeClass('is-open'); $toggle.attr('aria-expanded','false'); $('body').removeClass('ccp-share-open'); }
  function openUrl(target){ window.open(target, '_blank', 'noopener,noreferrer,width=720,height=620'); }
  function copyLink(){
    var done = function(){ var $label=$share.find('[data-share="copy"] span'); var original=$label.data('original') || $label.text(); $label.data('original',original).text({{ text_link_copied|json_encode|raw }}); window.setTimeout(function(){ $label.text(original); },1600); };
    if (navigator.clipboard && window.isSecureContext) { navigator.clipboard.writeText(url).then(done); return; }
    var node=document.createElement('textarea'); node.value=url; node.setAttribute('readonly','readonly'); node.style.position='fixed'; node.style.opacity='0'; document.body.appendChild(node); node.select(); try{document.execCommand('copy');done();}catch(e){} document.body.removeChild(node);
  }
  $toggle.on('click',function(e){ e.preventDefault(); e.stopPropagation(); var open=!$share.hasClass('is-open'); closeShare(); if(open){$share.addClass('is-open');$toggle.attr('aria-expanded','true');$('body').addClass('ccp-share-open');} });
  $share.on('click','[data-share-close]',function(e){ e.preventDefault(); e.stopPropagation(); closeShare(); $toggle.trigger('focus'); });
  $share.on('click','[data-share]',function(e){
    e.preventDefault(); e.stopPropagation();
    var network=$(this).data('share'); var u=encodeURIComponent(url); var t=encodeURIComponent(title);
    if(network==='copy'){copyLink();return;}
    if(network==='facebook'){openUrl('https://www.facebook.com/sharer/sharer.php?u='+u);}
    else if(network==='telegram'){openUrl('https://t.me/share/url?url='+u+'&text='+t);}
    else if(network==='whatsapp'){openUrl('https://api.whatsapp.com/send?text='+t+'%20'+u);}
    else if(network==='viber'){window.location.href='viber://forward?text='+encodeURIComponent(title+' '+url);}
    else if(network==='x'){openUrl('https://twitter.com/intent/tweet?url='+u+'&text='+t);}
    else if(network==='email'){window.location.href='mailto:?subject='+t+'&body='+encodeURIComponent(title+'\n'+url);}
    closeShare();
  });
  $(document).on('click.ccpShare',closeShare).on('keydown.ccpShare',function(e){if(e.key==='Escape'){closeShare();}});
})();
//--></script>
<script type="text/javascript"><!--
$('#button-cart').on('click', function() {
	if ($(this).hasClass('is-in-cart') && window.CodeCartCartUI) {
		window.location.href = window.CodeCartCartUI.cartUrl();
		return;
	}
	$.ajax({
		url: (window.CodeCartCartUI ? window.CodeCartCartUI.endpoint('cart-add', 'index.php?route=checkout/cart/add') : 'index.php?route=checkout/cart/add'),
		type: 'post',
		data: $('#product').find('input, select, textarea').serialize(),
		dataType: 'json',
		beforeSend: function() {
			$('#button-cart').button('loading');
		},
		complete: function() {
			if (!$('#button-cart').hasClass('is-in-cart')) { $('#button-cart').button('reset'); }
		},
		success: function(json) {
			$('.alert-dismissible, .text-danger').remove();
			$('.form-group').removeClass('has-error');

			if (json['error']) {
				if (json['error']['option']) {
					for (i in json['error']['option']) {
						var element = $('#input-option' + i.replace('_', '-'));

						if (element.parent().hasClass('input-group')) {
							element.parent().after('<div class="text-danger">' + json['error']['option'][i] + '</div>');
						} else {
							element.after('<div class="text-danger">' + json['error']['option'][i] + '</div>');
						}
					}
				}

				if (json['error']['recurring']) {
					$('select[name=\'recurring_id\']').after('<div class="text-danger">' + json['error']['recurring'] + '</div>');
				}

				// Highlight any found errors
				$('.text-danger').parent().addClass('has-error');
			}

			if (json['success']) {
				if (window.CodeCartCartUI) { window.CodeCartCartUI.markButton($('#button-cart')); }
				$('.breadcrumb').after('<div class="alert alert-success alert-dismissible">' + json['success'] + '<button type="button" class="close" data-dismiss="alert">&times;</button></div>');

				if (window.CodeCartCartUI) { window.CodeCartCartUI.updateTotal(json['total']); window.CodeCartCartUI.reloadDropdown(); window.CodeCartCartUI.refreshHeaderCart(); } else { $('#cart-total').html('<i class="fa fa-shopping-cart"></i> ' + json['total']); }

				$('html, body').animate({ scrollTop: 0 }, 'slow');

				$('#cart > ul').load('index.php?route=common/cart/info ul li');
			}
		},
        error: function(xhr, ajaxOptions, thrownError) {
            if (window.CodeCartUI) { window.CodeCartUI.error(xhr, thrownError); } else { alert(thrownError + "\r\n" + xhr.statusText); }
        }
	});
});
//--></script> 
