{{ header }}
<div class="cc-page">
  <div class="container">
    <div class="cc-layout">
      <main class="cc-card">
        <div class="cc-card-head"><div><h1>{{ heading_title }}</h1><p>{{ text_upgrade }}</p></div></div>
        <div class="cc-card-body">
          <div class="alert alert-info"><i class="fa-solid fa-lock"></i> {{ text_login_required }}</div>
          {% if error_login %}<div class="alert alert-danger"><i class="fa-solid fa-circle-xmark"></i> {{ error_login }}</div>{% endif %}
          <form action="{{ action }}" method="post" autocomplete="off" class="cc-form-section">
            <input type="hidden" name="login_token" value="{{ login_token }}">
            <div class="form-group">
              <label for="input-username">{{ entry_username }}</label>
              <input type="text" name="username" id="input-username" class="form-control" required autocomplete="username" autofocus>
            </div>
            <div class="form-group">
              <label for="input-password">{{ entry_password }}</label>
              <div class="cc-password">
                <input type="password" name="password" id="input-password" class="form-control" required autocomplete="current-password">
                <button type="button" class="cc-password-toggle" id="upgrade-password-toggle" aria-label="{{ button_show_password }}" aria-pressed="false" title="{{ button_show_password }}">
                  <i class="fa-regular fa-eye" aria-hidden="true"></i>
                </button>
              </div>
            </div>
            <button type="submit" class="btn btn-primary"><i class="fa-solid fa-right-to-bracket"></i> {{ button_login }}</button>
          </form>
        </div>
      </main>
      {{ column_left }}
    </div>
  </div>
</div>
<script>
(function () {
  'use strict';
  var field = document.getElementById('input-password');
  var button = document.getElementById('upgrade-password-toggle');
  if (!field || !button) { return; }
  button.addEventListener('click', function () {
    var visible = field.type === 'password';
    field.type = visible ? 'text' : 'password';
    button.setAttribute('aria-pressed', visible ? 'true' : 'false');
    button.setAttribute('aria-label', visible ? {{ button_hide_password|json_encode|raw }} : {{ button_show_password|json_encode|raw }});
    button.setAttribute('title', visible ? {{ button_hide_password|json_encode|raw }} : {{ button_show_password|json_encode|raw }});
    var icon = button.querySelector('i');
    if (icon) { icon.className = visible ? 'fa-regular fa-eye-slash' : 'fa-regular fa-eye'; }
  });
}());
</script>
{{ footer }}
