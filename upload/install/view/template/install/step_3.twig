{{ header }}
<div class="cc-page">
  <div class="container">
    {% if error_warning %}<div class="alert alert-danger"><i class="fa-solid fa-circle-exclamation"></i> {{ error_warning }}</div>{% endif %}
    <div class="cc-layout">
      <main class="cc-card">
        <div class="cc-card-head"><div><h1>{{ heading_title }}</h1><p>{{ text_step_3 }}</p></div><div class="cc-step-badge">3 / 4</div></div>
        <form action="{{ action }}" method="post" class="form-horizontal" autocomplete="off">
          <div class="cc-card-body">
            <h2 class="cc-section-title">{{ text_db_connection }}</h2>
            <div class="cc-form-section">
              <div class="form-group"><label class="col-sm-3 control-label" for="input-db-driver">{{ entry_db_driver }}</label><div class="col-sm-9"><select name="db_driver" id="input-db-driver" class="form-control">{% for driver in drivers %}<option value="{{ driver.value }}"{% if db_driver == driver.value %} selected{% endif %}>{{ driver.text }}</option>{% endfor %}</select>{% if error_db_driver %}<div class="text-danger">{{ error_db_driver }}</div>{% endif %}</div></div>
              <div class="form-group required"><label class="col-sm-3 control-label" for="input-db-hostname">{{ entry_db_hostname }}</label><div class="col-sm-9"><input type="text" name="db_hostname" value="{{ db_hostname }}" id="input-db-hostname" class="form-control" autocomplete="off" />{% if error_db_hostname %}<div class="text-danger">{{ error_db_hostname }}</div>{% endif %}</div></div>
              <div class="form-group required"><label class="col-sm-3 control-label" for="input-db-username">{{ entry_db_username }}</label><div class="col-sm-9"><input type="text" name="db_username" value="{{ db_username }}" id="input-db-username" class="form-control" autocomplete="off" />{% if error_db_username %}<div class="text-danger">{{ error_db_username }}</div>{% endif %}</div></div>
              <div class="form-group"><label class="col-sm-3 control-label" for="input-db-password">{{ entry_db_password }}</label><div class="col-sm-9"><div class="cc-password"><input type="password" name="db_password" value="{{ db_password }}" id="input-db-password" class="form-control" autocomplete="new-password" /><button type="button" class="cc-password-toggle" data-password-target="#input-db-password" title="{{ text_show_password }}"><i class="fa-regular fa-eye"></i></button></div></div></div>
              <div class="form-group required"><label class="col-sm-3 control-label" for="input-db-database">{{ entry_db_database }}</label><div class="col-sm-9"><input type="text" name="db_database" value="{{ db_database }}" id="input-db-database" class="form-control" autocomplete="off" />{% if error_db_database %}<div class="text-danger">{{ error_db_database }}</div>{% endif %}</div></div>
              <div class="form-group required"><label class="col-sm-3 control-label" for="input-db-port">{{ entry_db_port }}</label><div class="col-sm-9"><input type="text" inputmode="numeric" name="db_port" value="{{ db_port }}" id="input-db-port" class="form-control" />{% if error_db_port %}<div class="text-danger">{{ error_db_port }}</div>{% endif %}</div></div>
              <div class="form-group required"><label class="col-sm-3 control-label" for="input-db-prefix">{{ entry_db_prefix }}</label><div class="col-sm-9"><input type="text" name="db_prefix" value="{{ db_prefix }}" id="input-db-prefix" class="form-control" />{% if error_db_prefix %}<div class="text-danger">{{ error_db_prefix }}</div>{% endif %}</div></div>
            </div>

            <h2 class="cc-section-title">{{ text_db_administration }}</h2>
            <div class="cc-form-section">
              <div class="form-group required"><label class="col-sm-3 control-label" for="input-username">{{ entry_username }}</label><div class="col-sm-9"><input type="text" name="username" value="{{ username }}" id="input-username" class="form-control" autocomplete="username" /><p class="help-block">{{ help_username }}</p>{% if error_username %}<div class="text-danger">{{ error_username }}</div>{% endif %}</div></div>
              <div class="form-group required"><label class="col-sm-3 control-label" for="input-password">{{ entry_password }}</label><div class="col-sm-9"><div class="cc-password"><input type="password" name="password" value="{{ password }}" id="input-password" class="form-control" autocomplete="new-password" minlength="10" /><button type="button" class="cc-password-toggle" data-password-target="#input-password" title="{{ text_show_password }}"><i class="fa-regular fa-eye"></i></button></div><div class="help-block">{{ help_password }}</div>{% if error_password %}<div class="text-danger">{{ error_password }}</div>{% endif %}</div></div>
              <div class="form-group required"><label class="col-sm-3 control-label" for="input-email">{{ entry_email }}</label><div class="col-sm-9"><input type="email" name="email" value="{{ email }}" id="input-email" class="form-control" autocomplete="email" />{% if error_email %}<div class="text-danger">{{ error_email }}</div>{% endif %}</div></div>
            </div>
          </div>
          <div class="cc-card-footer"><a href="{{ back }}" class="btn btn-default"><i class="fa-solid fa-arrow-left"></i> {{ button_back }}</a><button type="submit" class="btn btn-primary">{{ button_continue }} <i class="fa-solid fa-arrow-right"></i></button></div>
        </form>
      </main>
      {{ column_left }}
    </div>
  </div>
</div>
<script>
$(document).on('click', '[data-password-target]', function() {
  var input = $($(this).attr('data-password-target'));
  var show = input.attr('type') === 'password';
  input.attr('type', show ? 'text' : 'password');
  $(this).find('i').attr('class', show ? 'fa-regular fa-eye-slash' : 'fa-regular fa-eye');
});
</script>
{{ footer }}
