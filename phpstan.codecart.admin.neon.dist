parameters:
    level: 5
    phpVersion: 80100
    scanFiles:
        - tools/quality/phpstan_runtime.php
        - upload/system/startup.php
        - upload/system/helper/general.php
        - upload/system/helper/utf8.php
    dynamicConstantNames:
        - DB_PREFIX
        - DIR_SYSTEM
        - DIR_IMAGE
        - HTTP_SERVER
    paths:
        - upload/admin/controller
        - upload/admin/model
    scanDirectories:
        - upload/system/engine
        - upload/system/library
        - upload/admin/model
    stubFiles:
        - tools/quality/phpstan_cache.stub
        - build/phpstan-stubs/admin.stub
    tmpDir: build/phpstan-cache/admin
    reportUnmatchedIgnoredErrors: true
