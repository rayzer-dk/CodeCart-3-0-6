{
  "name": "codecart-qa",
  "private": true,
  "version": "1.0.0",
  "description": "Isolated browser QA for CodeCart 3.0.6",
  "scripts": {
    "test:e2e": "playwright test --config=playwright.config.js",
    "test:e2e:list": "playwright test --config=playwright.config.js --list",
    "test:e2e:chromium": "playwright test --config=playwright.config.js --project=chromium-desktop --project=chromium-mobile"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0"
  }
}
