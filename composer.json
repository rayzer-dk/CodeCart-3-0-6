{
  "name": "codecart/codecart-3.0.6",
  "description": "CodeCart 3.0.6 e-commerce CMS based on OpenCart/ocStore 3.x",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": ">=8.1 <8.6",
    "ext-ctype": "*",
    "ext-mbstring": "*",
    "guzzlehttp/guzzle": "7.15.5",
    "guzzlehttp/promises": "2.5.3",
    "guzzlehttp/psr7": "2.13.1",
    "league/uri": "7.8.1",
    "league/uri-interfaces": "7.8.1",
    "psr/http-client": "1.0.3",
    "psr/http-factory": "1.1.0",
    "psr/http-message": "2.0",
    "ralouphie/getallheaders": "3.0.3",
    "scssphp/scssphp": "2.1.0",
    "scssphp/source-span": "1.1.0",
    "symfony/deprecation-contracts": "3.7.1",
    "symfony/filesystem": "6.4.45",
    "symfony/polyfill-ctype": "1.37.0",
    "symfony/polyfill-mbstring": "1.43.0",
    "symfony/polyfill-php80": "1.43.0",
    "twig/twig": "3.30.0"
  },
  "config": {
    "vendor-dir": "upload/system/storage/vendor",
    "optimize-autoloader": true,
    "sort-packages": true,
    "allow-plugins": {}
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
